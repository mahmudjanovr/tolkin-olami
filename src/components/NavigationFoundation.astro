---
/**
 * NavigationFoundation.astro
 * 
 * Tolkien Olami — Scholarly Navigation System
 * Features:
 * - Tolkien-inspired fantasy manuscript aesthetic (light parchment & deep forest slate)
 * - Desktop mega menu with 3 logical groups: The Legendarium, The World, History & Scholarship
 * - Full-screen mobile navigation drawer with accessible open/close, focus trap and scroll locking
 * - Centralized route data from src/data/navigation.ts
 * - WCAG 2.1 AA accessible disclosure pattern with keyboard and pointer support
 * - Search trigger and ThemeSwitch integration
 */

import ThemeSwitch from './ThemeSwitch.astro';
import NavIcon from './navigation/NavIcon.astro';
import NavSprite from './navigation/NavSprite.astro';
import {
  NAV_GROUPS,
  isRouteActive,
  isGroupActive,
} from '@/data/navigation';

// Canonical IA route references:
// href: '/kitoblar/'
// label: 'Kitoblar'

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header" id="site-header">
  <NavSprite />
  <div class="header-gold-line" aria-hidden="true"></div>

  <div class="header-inner container">
    <div class="brand">
      <a href="/" class="brand-link" aria-label="Tolkien Olami Bosh Sahifasi">
        <span class="brand-emblem" aria-hidden="true">
          <NavIcon icon="star" size={18} class="brand-icon" />
        </span>
        <div class="brand-text">
          <span class="brand-title">Tolkien Olami</span>
          <span class="brand-subtitle">Afsonalar olamining raqamli ensiklopediyasi</span>
          <span class="brand-badge visually-hidden">Ilmiy Ensiklopediya</span>
        </div>
      </a>
    </div>

    <nav class="desktop-nav" aria-label="Asosiy ensiklopediya boʻlimlari">
      <ul class="desktop-nav-list">
        {
          NAV_GROUPS.map((group) => {
            const groupActive = isGroupActive(group, currentPath);
            return (
              <li class="desktop-nav-item">
                <button
                  type="button"
                  class:list={['nav-trigger', { 'is-active-section': groupActive }]}
                  id={`nav-trigger-${group.id}`}
                  aria-expanded="false"
                  aria-controls={`mega-panel-${group.id}`}
                  data-group={group.id}
                >
                  <span class="nav-trigger-title">{group.title}</span>
                  <NavIcon icon="chevron" size={12} class="nav-chevron" />
                  {groupActive && <span class="nav-active-pip" aria-hidden="true" />}
                </button>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="search-trigger"
        data-open-search
        aria-label="Qidiruv oynasini ochish (Ctrl+K yoki Cmd+K)"
        aria-haspopup="dialog"
        aria-keyshortcuts="Ctrl+K Cmd+K"
      >
        <NavIcon icon="search" size={14} class="search-icon" />
        <span class="search-trigger-text">Qidiruv</span>
        <kbd class="search-shortcut">⌘K</kbd>
      </button>

      <div class="desktop-theme-switch">
        <ThemeSwitch idPrefix="desktop-theme" />
      </div>

      <button
        type="button"
        class="mobile-toggle-btn"
        id="mobile-nav-toggle"
        aria-label="Navigatsiya menyusini ochish"
        aria-expanded="false"
        aria-controls="mobile-nav-dialog"
      >
        <NavIcon icon="menu" size={20} class="mobile-toggle-icon" />
      </button>
    </div>
  </div>

  <div class="mega-menu-container" id="mega-menu-container" hidden>
    {
      NAV_GROUPS.map((group) => {
        return (
          <div
            class="mega-panel"
            id={`mega-panel-${group.id}`}
            data-panel={group.id}
            hidden
            aria-labelledby={`nav-trigger-${group.id}`}
          >
            <div class="mega-panel-inner container">
              <div class="mega-layout-editorial">
                <aside class="mega-editorial-curator">
                  <span class="editorial-kicker">{group.title}</span>
                  <span class="mega-panel-subheading">{group.subheading}</span>
                  <p class="mega-panel-description">{group.description}</p>
                </aside>

                <div class="mega-links-wrapper">
                  <ul class:list={['mega-card-grid', `cols-${group.items.length}`]}>
                    {group.items.map((item) => {
                      const isActive = isRouteActive(item.href, currentPath);
                      return (
                        <li>
                          <a
                            href={item.href}
                            class:list={['mega-card', { 'is-active': isActive }]}
                            aria-current={isActive ? 'page' : undefined}
                          >
                            <span class="mega-card-icon-box">
                              <NavIcon icon={item.icon} size={20} class="mega-card-icon" />
                            </span>
                            <div class="mega-card-body">
                              <div class="mega-card-title-row">
                                <span class="mega-card-title">{item.label}</span>
                                {isActive ? (
                                  <span class="active-badge">Joriy</span>
                                ) : (
                                  item.badge && <span class="item-badge">{item.badge}</span>
                                )}
                              </div>
                              <span class="mega-card-desc">{item.description}</span>
                            </div>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  <div
    id="mobile-nav-dialog"
    class="mobile-nav-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Asosiy navigatsiya menyusi"
    hidden
    tabindex="-1"
  >
    <div class="mobile-nav-scroller">
      <div class="mobile-nav-top">
        <a href="/" class="mobile-brand-link" aria-label="Tolkien Olami Bosh Sahifasi">
          <span class="brand-emblem" aria-hidden="true">
            <NavIcon icon="star" size={18} class="brand-icon" />
          </span>
          <div class="mobile-brand-text">
            <span class="mobile-brand-title">Tolkien Olami</span>
            <span class="mobile-brand-sub">Raqamli Ensiklopediya</span>
          </div>
        </a>

        <button
          type="button"
          class="mobile-close-btn"
          id="mobile-nav-close"
          aria-label="Navigatsiya menyusini yopish"
        >
          <span class="mobile-close-text">Yopish</span>
          <NavIcon icon="close" size={18} class="mobile-close-icon" />
        </button>
      </div>

      <div class="mobile-search-section">
        <button
          type="button"
          class="mobile-search-btn"
          data-open-search
          aria-label="Ensiklopediya boʻyicha qidiruv oynasini ochish"
        >
          <NavIcon icon="search" size={16} class="search-icon" />
          <span class="mobile-search-placeholder">Qidirish... (Fëanor, Gondolin, Quenya)</span>
          <kbd class="search-shortcut">⌘K</kbd>
        </button>
      </div>

      <nav class="mobile-nav-content" aria-label="Mobil navigatsiya roʻyxati">
        {
          NAV_GROUPS.map((group) => {
            const isGroupCurActive = isGroupActive(group, currentPath);
            return (
              <div class="mobile-group-section">
                <div class="mobile-group-header">
                  <div class="mobile-group-titles">
                    <span class="mobile-group-name">{group.title}</span>
                    <span class="mobile-group-divider" aria-hidden="true">·</span>
                    <span class="mobile-group-uzb">{group.subheading}</span>
                  </div>
                  {isGroupCurActive && <span class="mobile-group-active-tag">Faol</span>}
                </div>

                <ul class="mobile-links-list">
                  {group.items.map((item) => {
                    const isActive = isRouteActive(item.href, currentPath);
                    return (
                      <li>
                        <a
                          href={item.href}
                          class:list={['mobile-nav-link', { 'is-active': isActive }]}
                          aria-current={isActive ? 'page' : undefined}
                        >
                          <span class="mobile-link-icon-box">
                            <NavIcon icon={item.icon} size={18} class="mobile-item-icon" />
                          </span>
                          <span class="mobile-link-title">{item.label}</span>
                          {isActive ? (
                            <span class="active-badge">Joriy</span>
                          ) : (
                            item.badge && <span class="item-badge">{item.badge}</span>
                          )}
                          <NavIcon icon="chevron" size={14} class="mobile-link-arrow" />
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          })
        }
      </nav>

      <div class="mobile-nav-footer">
        <div class="mobile-theme-row">
          <span class="mobile-theme-label">Mavzu rejimi:</span>
          <ThemeSwitch idPrefix="mobile-theme" />
        </div>
      </div>
    </div>
  </div>
</header>

<style is:global>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-bg-base);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-gold-line {
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border-gold) 15%,
      var(--color-accent-gold) 50%,
      var(--color-border-gold) 85%,
      transparent 100%
    );
    opacity: 0.9;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.625rem;
    gap: 1.5rem;
  }

  .brand {
    flex-shrink: 0;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text-primary);
    border-radius: 4px;
    padding: 2px 0;
    transition: opacity 0.15s ease;
  }

  .brand-link:hover {
    opacity: 0.92;
  }

  .brand-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .brand-emblem {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-gold);
    color: var(--color-accent-gold-text);
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }

  .brand-title {
    font-family: var(--font-serif-heading);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .brand-subtitle {
    font-family: var(--font-serif-body);
    font-size: 0.75rem;
    font-style: italic;
    line-height: 1.2;
    color: var(--color-text-secondary);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.375rem;
    padding: 0;
    margin: 0;
  }

  .desktop-nav-item {
    position: relative;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    font-family: var(--font-sans-ui);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    cursor: pointer;
    position: relative;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded="true"] {
    color: var(--color-text-primary);
    background-color: var(--color-bg-elevated);
    border-color: var(--color-border-subtle);
  }

  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
    color: var(--color-accent-gold-text);
  }

  .nav-chevron {
    transition: transform 0.2s ease, color 0.15s ease;
    opacity: 0.75;
  }

  .nav-trigger.is-active-section {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .nav-active-pip {
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 20px;
    height: 2px;
    background-color: var(--color-accent-gold);
    border-radius: 1px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    background-color: var(--color-bg-elevated);
    color: var(--color-text-secondary);
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .search-trigger:hover {
    border-color: var(--color-border-gold);
    color: var(--color-text-primary);
    background-color: var(--color-bg-subtle);
  }

  .search-trigger:focus-visible,
  .nav-trigger:focus-visible,
  .mobile-toggle-btn:focus-visible,
  .mobile-close-btn:focus-visible,
  .mobile-search-btn:focus-visible,
  .mega-card:focus-visible,
  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .search-shortcut {
    font-family: var(--font-sans-ui);
    font-size: 0.6875rem;
    padding: 1px 4px;
    border-radius: 2px;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
  }

  .desktop-theme-switch {
    display: flex;
    align-items: center;
  }

  .mobile-toggle-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    background-color: var(--color-bg-elevated);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .mobile-toggle-btn:hover {
    background-color: var(--color-bg-subtle);
    border-color: var(--color-border-gold);
  }

  /* Mega Menu Panel (Editorial Monograph Layout) */
  .mega-menu-container {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-lg);
  }

  .mega-panel {
    padding-block: 2rem 2.25rem;
    animation: megaFadeIn 0.18s ease-out;
  }

  @keyframes megaFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mega-layout-editorial {
    display: grid;
    grid-template-columns: 28% 72%;
    gap: 2.5rem;
    align-items: start;
  }

  .mega-editorial-curator {
    border-right: 1px solid var(--color-border-subtle);
    padding-right: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mega-curator-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mega-panel-category {
    font-family: var(--font-serif-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .mega-panel-subheading {
    font-family: var(--font-serif-heading);
    font-size: 1rem;
    font-style: italic;
    color: var(--color-accent-gold-text);
  }

  .mega-panel-description {
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .mega-curator-quote {
    margin: 0;
    padding: 0.75rem 1rem;
    background-color: var(--color-bg-subtle);
    border-left: 2px solid var(--color-accent-gold);
    border-radius: 0 3px 3px 0;
    font-family: var(--font-serif-body);
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .mega-curator-quote p {
    margin: 0 0 0.375rem 0;
  }

  .mega-curator-quote cite {
    display: block;
    font-family: var(--font-sans-ui);
    font-size: 0.6875rem;
    font-style: normal;
    color: var(--color-text-muted);
  }

  .mega-links-wrapper {
    min-width: 0;
  }

  .mega-card-grid {
    display: grid;
    gap: 0.875rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mega-card-grid.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .mega-card-grid.cols-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 1200px) {
    .mega-card-grid.cols-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .mega-card-grid li {
    display: flex;
  }

  .mega-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem;
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    text-decoration: none;
    color: var(--color-text-primary);
    transition: background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    position: relative;
  }

  .mega-card:hover {
    background-color: var(--color-bg-subtle);
    border-color: var(--color-border-gold);
    box-shadow: var(--shadow-sm);
  }

  .mega-card.is-active {
    border-color: var(--color-border-gold);
    background-color: var(--color-bg-subtle);
    border-left: 3px solid var(--color-accent-gold);
  }

  .mega-card-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 3px;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-accent-gold-text);
    flex-shrink: 0;
    transition: all 0.15s ease;
  }

  .mega-card:hover .mega-card-icon-box,
  .mega-card.is-active .mega-card-icon-box {
    background-color: var(--color-accent-gold-subtle);
    border-color: var(--color-border-gold);
  }

  .mega-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .mega-card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .mega-card-title {
    font-family: var(--font-serif-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .mega-card-sublabel {
    font-family: var(--font-sans-ui);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-gold-text);
  }

  .mega-card-desc {
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .active-badge {
    font-family: var(--font-sans-ui);
    font-size: 0.625rem;
    font-weight: 600;
    padding: 1px 5px;
    border-radius: 2px;
    background-color: var(--color-accent-gold-subtle);
    color: var(--color-accent-gold-text);
    border: 1px solid var(--color-border-gold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .item-badge {
    font-family: var(--font-sans-ui);
    font-size: 0.625rem;
    font-weight: 500;
    padding: 1px 5px;
    border-radius: 2px;
    background-color: var(--color-bg-elevated);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-subtle);
  }

  /* Full-Screen Mobile Drawer */
  .mobile-nav-dialog {
    position: fixed;
    inset: 0;
    z-index: 200;
    background-color: var(--color-bg-base);
    color: var(--color-text-primary);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .mobile-nav-dialog.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-scroller {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    padding-top: max(1rem, env(safe-area-inset-top));
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    padding-inline: 1.25rem;
    max-width: 640px;
    margin-inline: auto;
  }

  .mobile-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mobile-brand-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .mobile-brand-text {
    display: flex;
    flex-direction: column;
  }

  .mobile-brand-title {
    font-family: var(--font-serif-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .mobile-brand-sub {
    font-family: var(--font-serif-body);
    font-size: 0.75rem;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  .mobile-close-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    background-color: var(--color-bg-elevated);
    color: var(--color-text-primary);
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

