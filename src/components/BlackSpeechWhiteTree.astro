<script>
  // ==========================================================================
  // PERFORMANCE & VISIBILITY CONTROLLER
  // Only activates heavy CSS animations when visible on screen and tab active
  // ==========================================================================
  function initSigilAnimation() {
    const container = document.querySelector('[data-sigil-animation]');
    if (!container) return;
    const targetElement = container;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      targetElement.classList.remove('is-active');
      return;
    }

    let isIntersecting = false;

    // 1. Intersection Observer: Start when in viewport, stop when scrolled away
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isIntersecting = entry.isIntersecting;
          updateAnimationState();
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(targetElement);

    // 2. Page Visibility Listener: Pause animation when user switches browser tabs
    function handleVisibilityChange() {
      updateAnimationState();
    }

    function updateAnimationState() {
      if (isIntersecting && !document.hidden) {
        targetElement.classList.add('is-active');
      } else {
        targetElement.classList.remove('is-active');
      }
    }

    document.addEventListener('visibilitychange', handleVisibilityChange);

    // Cleanup on Astro page transition
    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        document.removeEventListener('visibilitychange', handleVisibilityChange);
      },
      { once: true }
    );
  }

  // Initialize on initial page load and after Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSigilAnimation);
  } else {
    initSigilAnimation();
  }

  document.addEventListener('astro:page-load', initSigilAnimation);
</script>
