<style>
  /* ==========================================================================
     TENGWAR ANNATAR FONT
     ========================================================================== */
  @font-face {
    font-family: 'Tengwar Annatar';
    src: url('/fonts/tengwar/tngani-webfont.woff') format('woff'),
         url('/fonts/tengwar/tngani.ttf') format('truetype');
    font-weight: normal;
    font-style: italic;
    font-display: swap;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ==========================================================================
     CONTAINER & CIRCULAR EMBLEM LAYOUT
     ========================================================================== */
  .sigil-showcase-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 0;
    background: transparent;

    /* Theme Tokens: Base Light (Volcanic abyss core so golden/orange/red flames pop, fading into page) */
    --sigil-card-bg: transparent;
    --sigil-vignette-0: rgba(24, 5, 2, 0.85);
    --sigil-vignette-48: rgba(28, 7, 3, 0.56);
    --sigil-vignette-78: rgba(24, 9, 4, 0.15);
    --sigil-vignette-100: rgba(248, 245, 238, 0);

    /* Tengwar Calligraphy */
    --sigil-tengwar-core-fill: #9E7422;
    --sigil-tengwar-core-stroke: #664608;
    --sigil-tengwar-bloom-fill: #E8A838;
    --sigil-guideline-color: #C59A48;
    --sigil-guideline-opacity: 0.36;

    /* Flame Sweep Highlight */
    --sigil-sweep-0: rgba(232, 168, 56, 0);
    --sigil-sweep-25: rgba(255, 200, 80, 0.55);
    --sigil-sweep-50: #FFFDF0;
    --sigil-sweep-75: rgba(255, 200, 80, 0.55);
    --sigil-sweep-100: rgba(232, 168, 56, 0);

    --ember-fill: #FFB84D;
  }

  /* Night Theme: Deep blue-green page background */
  :global([data-theme="night"]) .sigil-showcase-container,
  :global(html[data-applied-mode="night"]) .sigil-showcase-container {
    --sigil-card-bg: transparent;
    --sigil-vignette-0: rgba(18, 3, 2, 0.92);
    --sigil-vignette-48: rgba(16, 6, 4, 0.68);
    --sigil-vignette-78: rgba(16, 29, 26, 0.25);
    --sigil-vignette-100: rgba(16, 29, 26, 0);

    --sigil-tengwar-core-fill: #FFD98A;
    --sigil-tengwar-core-stroke: #B88018;
    --sigil-tengwar-bloom-fill: #FFA94D;
    --sigil-guideline-color: #E5A93C;
    --sigil-guideline-opacity: 0.42;

    --sigil-sweep-0: rgba(255, 217, 138, 0);
    --sigil-sweep-25: rgba(255, 217, 138, 0.65);
    --sigil-sweep-50: #FFFFFF;
    --sigil-sweep-75: rgba(255, 217, 138, 0.65);
    --sigil-sweep-100: rgba(255, 217, 138, 0);

    --ember-fill: #FFE066;
  }

  /* System dark mode fallback */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]):not([data-applied-mode="light"])) .sigil-showcase-container,
    :global([data-theme="system"]) .sigil-showcase-container {
      --sigil-card-bg: transparent;
      --sigil-vignette-0: rgba(18, 3, 2, 0.92);
      --sigil-vignette-48: rgba(16, 6, 4, 0.68);
      --sigil-vignette-78: rgba(16, 29, 26, 0.25);
      --sigil-vignette-100: rgba(16, 29, 26, 0);

      --sigil-tengwar-core-fill: #FFD98A;
      --sigil-tengwar-core-stroke: #B88018;
      --sigil-tengwar-bloom-fill: #FFA94D;
      --sigil-guideline-color: #E5A93C;
      --sigil-guideline-opacity: 0.42;

      --sigil-sweep-0: rgba(255, 217, 138, 0);
      --sigil-sweep-25: rgba(255, 217, 138, 0.65);
      --sigil-sweep-50: #FFFFFF;
      --sigil-sweep-75: rgba(255, 217, 138, 0.65);
      --sigil-sweep-100: rgba(255, 217, 138, 0);

      --ember-fill: #FFE066;
    }
  }

  .sigil-artwork-wrapper {
    width: 100%;
    max-width: 580px;
    aspect-ratio: 1 / 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    border: none;
    box-shadow: none;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .sigil-artwork-wrapper {
      min-width: 480px;
      width: 100%;
    }
  }

  .sigil-cinematic-svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
    overflow: hidden;
  }

  /* Vignette stops */
  .vignette-stop-0 { stop-color: var(--sigil-vignette-0); }
  .vignette-stop-48 { stop-color: var(--sigil-vignette-48); }
  .vignette-stop-78 { stop-color: var(--sigil-vignette-78); }
  .vignette-stop-100 { stop-color: var(--sigil-vignette-100); }

  /* Inscription styling */
  .guideline-outer,
  .guideline-inner {
    stroke: var(--sigil-guideline-color);
    stroke-width: 0.75;
    opacity: var(--sigil-guideline-opacity);
    transition: stroke 0.3s ease, opacity 0.3s ease;
  }

  .inscription-text-bloom {
    fill: var(--sigil-tengwar-bloom-fill);
    opacity: 0.58;
    user-select: none;
    -webkit-font-smoothing: antialiased;
    transition: fill 0.3s ease;
  }

  .inscription-text-core {
    fill: var(--sigil-tengwar-core-fill);
    stroke: var(--sigil-tengwar-core-stroke);
    user-select: none;
    -webkit-font-smoothing: antialiased;
    transition: fill 0.3s ease, stroke 0.3s ease;
  }

  .sweep-stop-0 { stop-color: var(--sigil-sweep-0); }
  .sweep-stop-25 { stop-color: var(--sigil-sweep-25); }
  .sweep-stop-50 { stop-color: var(--sigil-sweep-50); }
  .sweep-stop-75 { stop-color: var(--sigil-sweep-75); }
  .sweep-stop-100 { stop-color: var(--sigil-sweep-100); }

  /* Eruption Plasma Stage & Fire Texture */
  .eruption-plasma-stage {
    filter: url(#eruption-plasma-filter);
    mix-blend-mode: screen;
  }

  .eruption-wave {
    transform-origin: 350px 350px;
    opacity: 0.82;
  }

  .flame-stream {
    transform-origin: 350px 350px;
    opacity: 0.90;
  }

  .fire-body-shape {
    filter: url(#flame-displacement);
    transform-origin: 350px 350px;
  }

  .heat-distortion-corona {
    transform-origin: 350px 350px;
    opacity: 0.50;
    mix-blend-mode: screen;
  }

  @media (max-width: 600px) {
    .fire-body-shape {
      filter: url(#flame-displacement-static);
    }
    .heat-distortion-corona {
      filter: none;
    }
    .ember-extra,
    .spk-9,
    .spk-10,
    .spk-11,
    .spk-12 {
      display: none !important;
    }
  }

  /* Pupil almond, fire spill & rim lights */
  .pupil-abyssal-almond {
    transform-origin: 350px 350px;
    filter: url(#pupil-edge-displacement) drop-shadow(0 0 2px #000000);
  }

  .pupil-fire-spill {
    transform-origin: 350px 350px;
    pointer-events: none;
  }

  .pupil-rim-light {
    opacity: 0.90;
    pointer-events: none;
  }

  .ember-particle {
    fill: var(--ember-fill);
    filter: drop-shadow(0 0 2.5px #FF6B00);
    transition: fill 0.3s ease;
  }

  .spark-streak {
    transform-origin: 350px 350px;
    opacity: 0.85;
  }

  /* ==========================================================================
     STATIC FALLBACK DEFAULTS
     ========================================================================== */
  .circular-inscription-group {
    opacity: 0.96;
    filter: drop-shadow(0 0 3px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 5px rgba(255, 180, 45, 0.55));
  }

  .flame-sweep-circle {
    opacity: 0.35;
    stroke-dasharray: 240 1130;
    stroke-dashoffset: 300;
  }

  .ring-eruption-glint {
    opacity: 0.42;
    stroke-dasharray: 150 535;
    stroke-dashoffset: 120;
    mix-blend-mode: screen;
  }

  .ring-reflection-arc {
    opacity: 0.42;
    stroke-dasharray: 180 440;
  }

  .fire-halo-layer {
    opacity: 0.85;
    transform-origin: 350px 350px;
  }

  .flicker-1 { opacity: 0.85; mix-blend-mode: screen; }
  .flicker-2 { opacity: 0.80; mix-blend-mode: screen; }
  .flicker-3 { opacity: 0.94; mix-blend-mode: screen; }
  .fire-blazing-core { mix-blend-mode: screen; }

  /* ==========================================================================
     ACTIVE HIGH-SPEED ERUPTION ANIMATION PIPELINE
     ========================================================================== */

  /* 1. Continuous High-Speed Radial Eruption Waves (3 Phase-Staggered Layers) */
  .sigil-showcase-container.is-active .wave-1 {
    animation: eruption-wave-blast 1.35s cubic-bezier(0.15, 0.82, 0.42, 1) infinite;
    will-change: transform, opacity;
  }
  .sigil-showcase-container.is-active .wave-2 {
    animation: eruption-wave-blast-alt 1.35s cubic-bezier(0.15, 0.82, 0.42, 1) -0.45s infinite;
    will-change: transform, opacity;
  }
  .sigil-showcase-container.is-active .wave-3 {
    animation: eruption-wave-blast 1.35s cubic-bezier(0.15, 0.82, 0.42, 1) -0.90s infinite;
