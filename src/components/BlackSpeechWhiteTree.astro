---
// BlackSpeechWhiteTree.astro
// Editorial Centerpiece: Sauron's Eye — High-Speed Fire Eruption & The One Ring Inscription
// Realistic, powerful eye unleashing high-velocity multi-layered flame streams,
// fast-moving sparks, glowing embers, heat distortion, and firelight reflections on the Black Speech ring.
---

<div class="sigil-showcase-container" id="black-speech-sauron-eye" data-sigil-animation>
  <span class="visually-hidden">
    Birlamchi Uzuk yozuvi va Sauron ramzi (badiiy talqin, kanonik tasvir emas)
  </span>
  <div class="sigil-artwork-wrapper">
    <svg
      class="sigil-cinematic-svg"
      viewBox="0 0 700 700"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby="sigil-title sigil-desc"
    >
      <title id="sigil-title">Birlamchi Uzuk yozuvi va Sauron ramzi</title>
      <desc id="sigil-desc">
        Birlamchi Uzuk yozuvi va Sauron ramzi (badiiy talqin, kanonik tasvir emas)
      </desc>

      <defs>
        <!-- ==================================================================
             1. CONTAINMENT CLIP & VOLCANIC VIGNETTE
             Keeps high-speed flames strictly inside the 700x700 centerpiece
             ================================================================== -->
        <clipPath id="sigil-containment-clip">
          <circle cx="350" cy="350" r="345" />
        </clipPath>

        <!-- Background Radial Vignette (Deep volcanic abyss behind the Eye, fading smoothly into page) -->
        <radialGradient id="sigil-vignette-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" class="vignette-stop-0" />
          <stop offset="48%" class="vignette-stop-48" />
          <stop offset="78%" class="vignette-stop-78" />
          <stop offset="100%" class="vignette-stop-100" />
        </radialGradient>

        <!-- ==================================================================
             2. ATMOSPHERIC FIRE HALO & THERMAL GLOW GRADIENTS
             ================================================================== -->
        <radialGradient id="outer-fire-halo-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FF922B" stop-opacity="0.72" />
          <stop offset="26%" stop-color="#E8590C" stop-opacity="0.50" />
          <stop offset="52%" stop-color="#B82014" stop-opacity="0.28" />
          <stop offset="76%" stop-color="#3A0A05" stop-opacity="0.14" />
          <stop offset="100%" stop-color="#1A0402" stop-opacity="0" />
        </radialGradient>

        <!-- Almond-Shaped Inner Thermal Plume -->
        <radialGradient id="thermal-plume-grad" cx="350" cy="350" r="245" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#FFF3BF" stop-opacity="0.85" />
          <stop offset="28%" stop-color="#FF922B" stop-opacity="0.65" />
          <stop offset="55%" stop-color="#D9380F" stop-opacity="0.38" />
          <stop offset="80%" stop-color="#6B0C07" stop-opacity="0.15" />
          <stop offset="100%" stop-color="#1A0402" stop-opacity="0" />
        </radialGradient>

        <!-- ==================================================================
             3. FLAME STREAM THERMAL GRADIENTS (userSpaceOnUse from 350,350)
             Every flame jet has 3 distinct nested color zones:
             Bright golden-yellow cores -> orange bodies -> deep red outer edges
             ================================================================== -->
        <!-- Outer Edge: Deep Red / Crimson (#C92A2A -> #7A0E08 -> #380503) -->
        <radialGradient id="eruption-edge-crimson" cx="350" cy="350" r="305" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#FFE066" stop-opacity="0.92" />
          <stop offset="22%" stop-color="#FF7A00" stop-opacity="0.90" />
          <stop offset="44%" stop-color="#D9380F" stop-opacity="0.84" />
          <stop offset="66%" stop-color="#9C140C" stop-opacity="0.70" />
          <stop offset="85%" stop-color="#4A0704" stop-opacity="0.38" />
          <stop offset="100%" stop-color="#1F0302" stop-opacity="0" />
        </radialGradient>

        <!-- Middle Body: Blazing Orange (#FFD43B -> #FF7A00 -> #D9380F -> #9C1919) -->
        <radialGradient id="eruption-body-orange" cx="350" cy="350" r="275" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.98" />
          <stop offset="20%" stop-color="#FFE066" stop-opacity="0.96" />
          <stop offset="38%" stop-color="#FF922B" stop-opacity="0.92" />
          <stop offset="58%" stop-color="#E84C0C" stop-opacity="0.82" />
          <stop offset="78%" stop-color="#A61810" stop-opacity="0.48" />
          <stop offset="100%" stop-color="#3A0603" stop-opacity="0" />
        </radialGradient>

        <!-- Inner Core: Incandescent Golden-Yellow (#FFFFFF -> #FFF3BF -> #FFD43B -> #FF922B) -->
        <radialGradient id="eruption-core-gold" cx="350" cy="350" r="235" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="1" />
          <stop offset="22%" stop-color="#FFFDF0" stop-opacity="0.98" />
          <stop offset="40%" stop-color="#FFE066" stop-opacity="0.94" />
          <stop offset="60%" stop-color="#FFA922" stop-opacity="0.78" />
          <stop offset="80%" stop-color="#E8590C" stop-opacity="0.36" />
          <stop offset="100%" stop-color="#8A1109" stop-opacity="0" />
        </radialGradient>

        <!-- ==================================================================
             4. REALISTIC EYE IRIS & FURNACE CORE GRADIENTS
             Seamless feathered outer edge so iris merges organically into flames
             ================================================================== -->
        <radialGradient id="fire-body-core-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="1" />
          <stop offset="20%" stop-color="#FFFDF2" stop-opacity="1" />
          <stop offset="38%" stop-color="#FFE066" stop-opacity="0.98" />
          <stop offset="58%" stop-color="#FF8800" stop-opacity="0.94" />
          <stop offset="76%" stop-color="#E8480C" stop-opacity="0.82" />
          <stop offset="90%" stop-color="#B81D13" stop-opacity="0.45" />
          <stop offset="100%" stop-color="#4A0704" stop-opacity="0" />
        </radialGradient>

        <radialGradient id="fire-flicker-1-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.95" />
          <stop offset="26%" stop-color="#FFE8A3" stop-opacity="0.86" />
          <stop offset="55%" stop-color="#FF922B" stop-opacity="0.68" />
          <stop offset="82%" stop-color="#B0250A" stop-opacity="0.35" />
          <stop offset="100%" stop-color="#3A0A05" stop-opacity="0" />
        </radialGradient>

        <radialGradient id="fire-flicker-2-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FFF9DB" stop-opacity="0.88" />
          <stop offset="35%" stop-color="#FFC078" stop-opacity="0.74" />
          <stop offset="70%" stop-color="#D9480F" stop-opacity="0.48" />
          <stop offset="100%" stop-color="#5C0F07" stop-opacity="0" />
        </radialGradient>

        <radialGradient id="fire-flicker-3-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="1" />
          <stop offset="25%" stop-color="#FFE066" stop-opacity="0.90" />
          <stop offset="52%" stop-color="#F76707" stop-opacity="0.56" />
          <stop offset="80%" stop-color="#801008" stop-opacity="0.20" />
          <stop offset="100%" stop-color="#000000" stop-opacity="0" />
        </radialGradient>

        <!-- High-Velocity Spark Streak Gradient -->
        <linearGradient id="spark-streak-grad" x1="0%" y1="50%" x2="100%" y2="50%">
          <stop offset="0%" stop-color="#C92A2A" stop-opacity="0" />
          <stop offset="35%" stop-color="#FF6B00" stop-opacity="0.72" />
          <stop offset="75%" stop-color="#FFE066" stop-opacity="0.96" />
          <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
        </linearGradient>

        <!-- ==================================================================
             5. ORGANIC FLAME TURBULENCE & HEAT DISTORTION FILTERS
             ================================================================== -->
        <!-- Crisp Turbulent Distortion for High-Speed Erupting Flame Streams -->
        <filter
          id="eruption-plasma-filter"
          filterUnits="userSpaceOnUse"
          x="15"
          y="15"
          width="670"
          height="670"
        >
          <feTurbulence
            type="turbulence"
            baseFrequency="0.018 0.025"
            numOctaves="3"
            seed="7"
            result="plasmaNoise"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="plasmaNoise"
            scale="13"
            xChannelSelector="R"
            yChannelSelector="G"
            result="displacedFlames"
          />
          <feGaussianBlur in="displacedFlames" stdDeviation="1.4" result="flameBloom" />
          <feMerge>
            <feMergeNode in="flameBloom" />
            <feMergeNode in="displacedFlames" />
          </feMerge>
        </filter>

        <!-- Core Eye Fire Texture Shimmer -->
        <filter
          id="flame-displacement"
          filterUnits="userSpaceOnUse"
          x="80"
          y="80"
          width="540"
          height="540"
        >
          <feTurbulence
            type="turbulence"
            baseFrequency="0.016 0.022"
            numOctaves="3"
            seed="2"
            result="noise"
          >
            <animate
              attributeName="baseFrequency"
              dur="6s"
              values="0.015 0.020; 0.021 0.028; 0.017 0.023; 0.015 0.020"
              repeatCount="indefinite"
            />
          </feTurbulence>
          <feDisplacementMap
            in="SourceGraphic"
            in2="noise"
            scale="16"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>

        <!-- Static Texture Filter for reduced motion / mobile under 600px -->
        <filter
          id="flame-displacement-static"
          filterUnits="userSpaceOnUse"
          x="80"
          y="80"
          width="540"
          height="540"
        >
          <feTurbulence
            type="turbulence"
            baseFrequency="0.016 0.022"
            numOctaves="3"
            seed="2"
            result="noise"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="noise"
            scale="16"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>

        <!-- Subtle Heat Distortion Filter -->
        <filter
          id="heat-shimmer-filter"
          filterUnits="userSpaceOnUse"
          x="50"
          y="50"
          width="600"
          height="600"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.026 0.038"
            numOctaves="2"
            seed="11"
            result="heatNoise"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="heatNoise"
            scale="9"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>

        <!-- ==================================================================
             6. PUPIL & BLACK SPEECH RING SHADERS
             ================================================================== -->
        <radialGradient id="pupil-abyss-grad" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#000000" />
          <stop offset="58%" stop-color="#000000" />
          <stop offset="86%" stop-color="#050101" />
          <stop offset="100%" stop-color="#0A0302" />
        </radialGradient>

        <linearGradient id="pupil-rim-fade-grad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#FFD98A" stop-opacity="0" />
          <stop offset="16%" stop-color="#FFE066" stop-opacity="0.48" />
          <stop offset="50%" stop-color="#FFFDF2" stop-opacity="0.98" />
          <stop offset="84%" stop-color="#FFE066" stop-opacity="0.48" />
          <stop offset="100%" stop-color="#FFD98A" stop-opacity="0" />
        </linearGradient>

        <filter
          id="pupil-edge-displacement"
          filterUnits="userSpaceOnUse"
          x="310"
          y="220"
          width="80"
          height="260"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.045 0.045"
            numOctaves="3"
            seed="5"
            result="noise"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="noise"
            scale="2.5"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>

        <filter
          id="pupil-rim-soft-glow"
          filterUnits="userSpaceOnUse"
          x="310"
          y="220"
          width="80"
          height="260"
        >
          <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <filter
          id="fire-spill-blur"
          filterUnits="userSpaceOnUse"
          x="300"
          y="215"
          width="100"
          height="270"
        >
          <feGaussianBlur in="SourceGraphic" stdDeviation="5" />
        </filter>

        <filter id="ring-flare-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2.2" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>

        <linearGradient id="flame-sweep-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" class="sweep-stop-0" />
          <stop offset="25%" class="sweep-stop-25" />
          <stop offset="50%" class="sweep-stop-50" />
          <stop offset="75%" class="sweep-stop-75" />
          <stop offset="100%" class="sweep-stop-100" />
        </linearGradient>

        <!-- Flame Reflection Gradient on Black Speech Ring -->
        <linearGradient id="ring-firelight-reflect-grad" x1="0%" y1="50%" x2="100%" y2="50%">
          <stop offset="0%" stop-color="#FF922B" stop-opacity="0.85" />
          <stop offset="22%" stop-color="#FFE066" stop-opacity="0.95" />
          <stop offset="50%" stop-color="#F76707" stop-opacity="0.18" />
          <stop offset="78%" stop-color="#FFE066" stop-opacity="0.95" />
          <stop offset="100%" stop-color="#FF922B" stop-opacity="0.85" />
        </linearGradient>

        <!-- Canonical Black Speech Circular Text Path: Center (350, 350), R = 218 -->
        <path
          id="ring-verse-circle"
          d="M 350,350 m 0,-218 a 218,218 0 1,1 0,436 a 218,218 0 1,1 0,-436"
          fill="none"
        />

        <!-- ==================================================================
             7. LONG, SHARP, IRREGULAR FLAME STREAM PRIMITIVES
             Slender, whip-like S-curved flame tongues with 3 distinct color layers
             (Deep Red Outer Edge -> Orange Body -> Golden-Yellow Core)
             and generous negative space between jets so each tongue reads clearly.
             ================================================================== -->
        <!-- Long Razor-Sharp Canthus Flame Jet (Reaches from r=95 out to r=285) -->
        <g id="sharp-flame-jet-long">
          <!-- Deep Red Outer Edge (Forked, irregular silhouette) -->
          <path
            d="M 435,350
               C 462,334 498,328 538,336
               C 574,343 606,324 642,336
               C 608,346 578,348 548,354
               C 582,359 612,355 636,363
               C 592,371 548,365 508,370
               C 474,374 452,364 435,350 Z"
            fill="url(#eruption-edge-crimson)"
          />
          <!-- Searing Orange Mid-Body -->
          <path
            d="M 440,350
               C 466,339 500,335 538,341
               C 568,346 596,333 622,340
               C 588,349 552,350 518,355
               C 548,359 574,356 596,361
               C 558,366 518,361 484,364
               C 460,366 448,359 440,350 Z"
            fill="url(#eruption-body-orange)"
          />
          <!-- Bright Golden-Yellow Core (Needle-sharp inner filament) -->
          <path
            d="M 444,350
               C 468,343 498,341 532,345
               C 556,348 578,340 598,344
               C 564,351 528,352 494,355
               C 468,357 452,354 444,350 Z"
            fill="url(#eruption-core-gold)"
          />
        </g>

        <!-- Medium Whipping Diagonal Flame Stream (Reaches from r=78 out to r=260) -->
        <g id="sharp-flame-jet-whip">
          <!-- Deep Red Outer Edge -->
          <path
            d="M 418,350
               C 444,332 480,324 520,331
               C 554,337 586,316 618,328
               C 586,340 554,344 522,351
               C 554,356 582,351 606,359
               C 564,368 522,363 482,369
               C 450,374 432,363 418,350 Z"
            fill="url(#eruption-edge-crimson)"
          />
          <!-- Orange Body -->
          <path
            d="M 422,350
               C 448,337 480,331 516,337
               C 546,342 572,327 596,334
               C 564,344 530,347 498,353
               C 526,357 550,354 570,359
               C 534,364 496,360 464,363
               C 440,365 430,358 422,350 Z"
            fill="url(#eruption-body-orange)"
          />
          <!-- Golden-Yellow Core -->
          <path
            d="M 426,350
               C 450,342 478,338 510,342
               C 534,345 554,336 572,340
               C 540,348 506,350 474,353
               C 450,355 436,353 426,350 Z"
            fill="url(#eruption-core-gold)"
          />
        </g>

        <!-- Steep Upper/Lower Lid Flame Tongue (Originates closer at r=58 out to r=230) -->
        <g id="sharp-flame-jet-crown">
          <!-- Deep Red Outer Edge -->
          <path
            d="M 398,350
               C 422,334 454,326 490,333
               C 522,339 552,320 582,332
               C 550,343 518,346 488,352
               C 516,357 542,353 564,360
               C 526,368 488,363 452,368
               C 424,372 410,362 398,350 Z"
            fill="url(#eruption-edge-crimson)"
          />
          <!-- Orange Body -->
          <path
            d="M 402,350
               C 425,339 454,333 486,338
               C 514,343 538,330 560,337
               C 530,346 498,348 468,353
               C 442,357 418,356 402,350 Z"
            fill="url(#eruption-body-orange)"
          />
          <!-- Golden-Yellow Core -->
          <path
            d="M 406,350
               C 426,343 452,339 480,343
               C 502,346 520,339 538,343
               C 508,349 478,351 450,353
               C 428,354 414,353 406,350 Z"
            fill="url(#eruption-core-gold)"
          />
        </g>
      </defs>

      <!-- Main Contained Visual Group -->
      <g clip-path="url(#sigil-containment-clip)">
        <!-- ====================================================================
             LAYER 1: CIRCULAR VIGNETTE (Volcanic dark backdrop fading into page)
             ==================================================================== -->
        <circle
          cx="350"
          cy="350"
          r="342"
          fill="url(#sigil-vignette-grad)"
          class="sigil-radial-vignette"
          aria-hidden="true"
        />

        <!-- ====================================================================
             LAYER 2: ATMOSPHERIC FIRE HALO & SUBTLE HEAT DISTORTION
             ==================================================================== -->
        <g class="fire-halo-assembly" aria-hidden="true">
          <circle
            cx="350"
            cy="350"
            r="285"
            fill="url(#outer-fire-halo-grad)"
            class="fire-halo-layer"
          />
          <ellipse
            cx="350"
            cy="350"
            rx="240"
            ry="170"
            fill="url(#thermal-plume-grad)"
            class="fire-halo-ellipse"
          />
          <!-- Subtle Heat Shimmer Corona -->
          <ellipse
            cx="350"
            cy="350"
            rx="215"
            ry="150"
            fill="url(#fire-flicker-1-grad)"
            filter="url(#heat-shimmer-filter)"
            class="heat-distortion-corona"
          />
        </g>

        <!-- ====================================================================
             LAYER 2.5: HIGH-SPEED MULTI-LAYERED FIRE ERUPTION STAGE
             Originates around the almond iris and shoots outward at high speed.
             Uses 3 phase-staggered burst rings + 16 independent directional jets
             so flames continuously emerge, extend outward, fade, and regenerate.
             ==================================================================== -->
        <g class="eruption-plasma-stage" aria-hidden="true">
          <!-- Continuous Wave Group A (Phase 0s) -->
          <g class="eruption-wave wave-1">
            <use href="#sharp-flame-jet-long" transform="rotate(-6 350 350)" />
            <use href="#sharp-flame-jet-long" transform="rotate(174 350 350)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(24 350 350)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(-28 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(152 350 350)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(206 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-58 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(56 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-122 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(124 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-86 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(94 350 350)" />
          </g>

          <!-- Continuous Wave Group B (Phase -0.45s, offset angles) -->
          <g class="eruption-wave wave-2">
            <use href="#sharp-flame-jet-long" transform="rotate(8 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-long" transform="rotate(188 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(-16 350 350)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(38 350 350)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(166 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(220 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-44 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(72 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-106 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(108 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-74 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(138 350 350)" />
          </g>

          <!-- Continuous Wave Group C (Phase -0.90s, offset angles) -->
          <g class="eruption-wave wave-3">
            <use href="#sharp-flame-jet-long" transform="rotate(0 350 350)" />
            <use href="#sharp-flame-jet-long" transform="rotate(180 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(14 350 350)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(-36 350 350)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(142 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-whip" transform="rotate(196 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-66 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(46 350 350) scale(1,-1) translate(0,-700)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(-134 350 350)" />
            <use href="#sharp-flame-jet-crown" transform="rotate(82 350 350) scale(1,-1) translate(0,-700)" />
          </g>

          <!-- 16 Independent Asynchronous High-Speed Flame Streams (Varied Non-Harmonic Speeds) -->
          <g class="high-speed-flame-streams">
            <g transform="rotate(-2 350 350)">
              <use href="#sharp-flame-jet-long" class="flame-stream stream-1" />
            </g>
            <g transform="rotate(178 350 350) scale(1, -1) translate(0, -700)">
              <use href="#sharp-flame-jet-long" class="flame-stream stream-2" />
            </g>
            <g transform="rotate(-20 350 350)">
              <use href="#sharp-flame-jet-whip" class="flame-stream stream-3" />
            </g>
            <g transform="rotate(20 350 350) scale(1, -1) translate(0, -700)">
              <use href="#sharp-flame-jet-whip" class="flame-stream stream-4" />
            </g>
            <g transform="rotate(160 350 350)">
