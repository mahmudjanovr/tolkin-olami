<script>
  // ==========================================================================
  // PERFORMANCE & VISIBILITY CONTROLLER
  // ==========================================================================
  function initSigilAnimation() {
    const container = document.querySelector('[data-sigil-animation]');
    if (!container) return;
    const targetElement = container;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      targetElement.classList.remove('is-active');
      return;
    }

    let isIntersecting = false;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isIntersecting = entry.isIntersecting;
          updateAnimationState();
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(targetElement);

    function handleVisibilityChange() {
      updateAnimationState();
    }

    function updateAnimationState() {
      if (isIntersecting && !document.hidden) {
        targetElement.classList.add('is-active');
      } else {
        targetElement.classList.remove('is-active');
      }
    }

    document.addEventListener('visibilitychange', handleVisibilityChange);

    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        document.removeEventListener('visibilitychange', handleVisibilityChange);
      },
      { once: true }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSigilAnimation);
  } else {
    initSigilAnimation();
  }

  document.addEventListener('astro:page-load', initSigilAnimation);
</script>
