---
/**
 * CharacterPortrait.astro — Tolkien Olami Akademik Qahramon Portreti Komponenti
 *
 * Ikki xil taqdimot o'lchamini qo'llab-quvvatlaydi:
 * - 'directory': Katalog kartochkalari uchun ixcham 3:4 portret (300x400)
 * - 'detail': Shaxsiy maqola sahifasi uchun yirik ilmiy illyustratsiya (600x800)
 *
 * Missing-asset holatida qat'iy stilizatsiyalangan filologik monogramma fallback ko'rsatiladi.
 */
import { getCharacterPortrait, type CharacterPortrait } from '@/data/character-portraits';

interface Props {
  characterId: string;
  name?: string;
  size?: 'directory' | 'detail';
  priority?: boolean;
  customAlt?: string;
  customCaption?: string;
  class?: string;
}

const {
  characterId,
  name = 'Qahramon',
  size = 'directory',
  priority = false,
  customAlt,
  customCaption,
  class: className = '',
} = Astro.props;

const portrait: CharacterPortrait | null = getCharacterPortrait(characterId);
const altText = customAlt || (portrait ? portrait.alt : `${name} portreti`);
const captionText = customCaption || (portrait ? portrait.caption : '');
const initial = (name || characterId || 'T').trim().charAt(0).toUpperCase();

// Provenance belgisini o'zbekcha ifodalash
const provenanceLabel =
  portrait?.provenance === 'scholarly_original_illustration' || portrait?.provenance === 'original_textual_visualization'
    ? 'Akademik matn illyustratsiyasi'
    : portrait?.provenance === 'adaptation_reference_illustration' || portrait?.provenance === 'original_adaptation_derivative'
    ? 'Kanonik matn va moslashuv sintezi'
    : portrait?.provenance === 'published_illustration'
    ? 'Nashr etilgan kitob illyustratsiyasi'
    : portrait?.provenance === 'adaptation_image'
    ? 'Rasmiy ekran moslashuvi kadri'
    : 'Tahririyat koʻrigidagi aktiv';
---

<figure
  class={`character-portrait-figure portrait-${size} ${className}`}
  data-character-id={characterId}
>
  {portrait ? (
    <div class="portrait-media-wrapper">
      <picture>
        <source
          type="image/webp"
          srcset={size === 'directory' ? `${portrait.srcThumb} 1x, ${portrait.src} 2x` : `${portrait.srcThumb} 300w, ${portrait.src} 600w`}
          sizes={size === 'directory' ? '(max-width: 640px) 100vw, 300px' : '(max-width: 768px) 100vw, 420px'}
        />
        <img
          src={size === 'directory' ? portrait.srcThumb : portrait.src}
          alt={altText}
          width={size === 'directory' ? 300 : 600}
          height={size === 'directory' ? 400 : 800}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : 'auto'}
          decoding="async"
          class="portrait-img"
        />
      </picture>
    </div>
  ) : (
    /* Haqiqiy aktiv yo'q bo'lganda stilizatsiyalangan akademik monogramma fallback */
    <div
      class="portrait-fallback"
      role="img"
      aria-label={`${name} portreti hali tasdiqlanmagan`}
    >
      <div class="fallback-crest" aria-hidden="true">
        <svg class="crest-geom" width="48" height="48" viewBox="0 0 48 48" fill="none">
          <circle cx="24" cy="24" r="21" stroke="var(--color-border-gold)" stroke-width="1.5" stroke-dasharray="3 3" />
          <polygon points="24,6 42,24 24,42 6,24" stroke="var(--color-accent-gold)" stroke-width="1" />
          <circle cx="24" cy="24" r="14" stroke="var(--color-border-subtle)" stroke-width="1" />
        </svg>
        <span class="fallback-initial">{initial}</span>
      </div>
      <span class="fallback-name">{name}</span>
      <span class="fallback-notice">Portret koʻrib chiqilmoqda</span>
    </div>
  )}

  {size === 'detail' && portrait && (
    <figcaption class="portrait-caption">
      <p class="caption-text">{captionText}</p>
      <div class="caption-provenance">
        <span class="prov-tag">{provenanceLabel}</span>
        <span class="prov-license">{portrait.license}</span>
      </div>
    </figcaption>
  )}
</figure>

<style>
  .character-portrait-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    overflow: hidden;
  }

  .portrait-media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-bg-base);
  }

  .portrait-img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
  }

  /* Katalog o'lchami: ixcham 3:4 kartochka portreti */
  .portrait-directory {
    width: 100%;
  }

  .portrait-directory:hover .portrait-img {
    transform: scale(1.03);
    filter: brightness(1.02);
  }

  /* Tafsilot o'lchami: yirik akademik portret */
  .portrait-detail {
    width: 100%;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .portrait-detail .portrait-media-wrapper {
    max-height: 520px;
  }

  /* Izoh va akademik provenans */
  .portrait-caption {
    padding: 0.875rem 1rem;
    background-color: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border-subtle);
    font-family: var(--font-sans-ui);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .caption-text {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .caption-provenance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    border-top: 1px dashed var(--color-border-subtle);
    padding-top: 0.375rem;
    margin-top: 0.25rem;
  }

  .prov-tag {
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent-gold-text);
  }

  .prov-license {
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  /* Stilizatsiyalangan filologik fallback */
  .portrait-fallback {
    width: 100%;
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: radial-gradient(circle at center, var(--color-bg-elevated) 0%, var(--color-bg-subtle) 100%);
    text-align: center;
    color: var(--color-text-muted);
  }

  .fallback-crest {
    position: relative;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }

  .crest-geom {
    position: absolute;
    inset: 4px;
    width: 48px;
    height: 48px;
  }

  .fallback-initial {
    font-family: var(--font-serif-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent-gold-text);
    z-index: 1;
    line-height: 1;
  }

  .fallback-name {
    font-family: var(--font-serif-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .fallback-notice {
    font-family: var(--font-sans-ui);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .portrait-img {
      transition: none;
    }
    .portrait-directory:hover .portrait-img {
      transform: none;
      filter: none;
    }
  }
</style>
