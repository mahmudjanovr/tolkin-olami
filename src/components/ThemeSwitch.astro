---
// ThemeSwitch.astro — Accessible Light / Night / System switcher
interface Props {
  idPrefix?: string;
}

const { idPrefix = 'theme-switch' } = Astro.props;
---

<div class="theme-switch" role="radiogroup" aria-label="Mavzu tanlash">
  <button
    type="button"
    role="radio"
    aria-checked="false"
    data-theme-value="light"
    id={`${idPrefix}-light`}
    class="theme-btn"
    title="Yorugʻ rejim (Paxta qogʻozi)"
  >
    <span class="theme-btn-text">Yorugʻ</span>
  </button>
  <button
    type="button"
    role="radio"
    aria-checked="false"
    data-theme-value="night"
    id={`${idPrefix}-night`}
    class="theme-btn"
    title="Tungi rejim (Tungi arxiv)"
  >
    <span class="theme-btn-text">Tun</span>
  </button>
  <button
    type="button"
    role="radio"
    aria-checked="true"
    data-theme-value="system"
    id={`${idPrefix}-system`}
    class="theme-btn"
    title="Tizim rejimi (Avtomatik)"
  >
    <span class="theme-btn-text">Tizim</span>
  </button>
</div>

<style>
  .theme-switch {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    padding: 2px;
    gap: 2px;
  }

  .theme-btn {
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem; /* 13px */
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 3px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .theme-btn:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-subtle);
  }

  .theme-btn[aria-checked="true"] {
    background-color: var(--color-bg-base);
    color: var(--color-text-primary);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .theme-btn:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 1px;
  }
</style>

<script>
  import { getStoredTheme, setTheme, initThemeListener } from '@/utils/theme';

  function updateActiveState(theme: string) {
    document.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach((btn) => {
      btn.setAttribute('aria-checked', btn.dataset.themeValue === theme ? 'true' : 'false');
    });
  }

  function initThemeSwitch() {
    const switches = document.querySelectorAll<HTMLElement>('.theme-switch');
    if (switches.length === 0) return;

    const stored = getStoredTheme();
    updateActiveState(stored);

    switches.forEach((container) => {
      if (container.dataset.themeSwitchInit === 'true') return;
      container.dataset.themeSwitchInit = 'true';

      const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>('.theme-btn'));

      buttons.forEach((btn, index) => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.themeValue as 'light' | 'night' | 'system';
          if (value) {
            setTheme(value);
            updateActiveState(value);
          }
        });

        btn.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            const nextIndex = (index + 1) % buttons.length;
            buttons[nextIndex]?.focus();
            buttons[nextIndex]?.click();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            const prevIndex = (index - 1 + buttons.length) % buttons.length;
            buttons[prevIndex]?.focus();
            buttons[prevIndex]?.click();
          }
        });
      });
    });

    initThemeListener();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeSwitch);
  } else {
    initThemeSwitch();
  }
  document.addEventListener('astro:page-load', initThemeSwitch);
</script>
