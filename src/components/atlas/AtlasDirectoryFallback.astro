---
import EntityCard from '@/components/list/EntityCard.astro';
import ListLayout, { type FilterGroup } from '@/components/list/ListLayout.astro';
import type { PlaceData } from '@/content/schemas';

export interface AssociatedCharacter {
  id: string;
  name: string;
  href: string;
}

export type FallbackPlaceData = PlaceData & {
  associated_characters?: AssociatedCharacter[];
};

interface Props {
  places: FallbackPlaceData[];
}

const { places } = Astro.props;

// Sort alphabetically by Uzbek name
const sortedPlaces = [...places].sort((a, b) => a.name.localeCompare(b.name, 'uz'));

const typeLabelMap: Record<string, string> = {
  'shahar': 'Shahar',
  'qalʼa': 'Qalʼa',
  'oʻlka': 'Oʻlka',
  'togʻ': 'Togʻ',
  'qirollik': 'Qirollik',
};

function getPlaceEraKey(place: FallbackPlaceData): string {
  const f = (place.founded_era || '').toLowerCase();
  if (f.includes('birinchi') || place.region === 'beleriand') return 'birinchi';
  if (f.includes('ikkinchi')) return 'ikkinchi';
  if (f.includes('uchinchi') || place.region === 'orta-yer') return 'uchinchi';
  return 'boshqa';
}

function getPlaceEraLabel(place: FallbackPlaceData): string {
  const key = getPlaceEraKey(place);
  if (key === 'birinchi') return 'Birinchi davr';
  if (key === 'ikkinchi') return 'Ikkinchi davr';
  if (key === 'uchinchi') return 'Uchinchi davr';
  return place.founded_era || 'Qadimiy davr';
}

// Extract first 2 sentences from summary for clean 2-sentence excerpt
function getShortExcerpt(text: string): string {
  if (!text) return '';
  const sentences = text.match(/[^.!?]+[.!?]+/g);
  if (sentences && sentences.length >= 2 && sentences[0] && sentences[1]) {
    return `${sentences[0].trim()} ${sentences[1].trim()}`;
  }
  return text.length > 180 ? `${text.slice(0, 180)}...` : text;
}

const eraCounts = {
  all: sortedPlaces.length,
  birinchi: sortedPlaces.filter((p) => getPlaceEraKey(p) === 'birinchi').length,
  ikkinchi: sortedPlaces.filter((p) => getPlaceEraKey(p) === 'ikkinchi').length,
  uchinchi: sortedPlaces.filter((p) => getPlaceEraKey(p) === 'uchinchi').length,
};

const filterGroups: FilterGroup[] = [
  {
    id: 'era',
    label: 'Davr',
    dataKey: 'era',
    options: [
      { id: 'all', label: 'Barchasi', count: eraCounts.all },
      { id: 'birinchi', label: 'Birinchi davr', count: eraCounts.birinchi },
      { id: 'ikkinchi', label: 'Ikkinchi davr', count: eraCounts.ikkinchi },
      { id: 'uchinchi', label: 'Uchinchi davr', count: eraCounts.uchinchi },
    ],
  },
  {
    id: 'type',
    label: 'Turi',
    dataKey: 'type',
    options: [
      { id: 'all', label: 'Barcha turlar' },
      { id: 'shahar', label: 'Shahar' },
      { id: 'qala', label: 'Qalʼa' },
      { id: 'olka', label: 'Oʻlka' },
      { id: 'tog', label: 'Togʻ' },
      { id: 'qirollik', label: 'Qirollik' },
    ],
  },
];
---

<section
  id="toponimlar"
  class="atlas-toponyms-section"
  aria-label="Tolkien joy nomlari va toponimlar katalogi"
  data-pagefind-body
>
  <!-- Backward-compatibility anchor for existing internal links -->
  <span id="atlas-katalog" class="visually-hidden"></span>

  <header class="toponyms-header">
    <span class="toponyms-kicker">Matnshunoslik Geografiyasi</span>
    <h2 class="toponyms-title">Toponimlar va Tarixiy Geografiya Katalogi</h2>
    <p class="toponyms-lead">
      Beleriand va Oʻrta-yerning barcha kanonik toponimlari, planar koordinatalari va birlamchi manbalari.
      Toʻliq matnlar va Oksford ilmiy havolalari batafsil sahifalarda keltirilgan.
    </p>
  </header>

  <ListLayout
    id="toponimlar-list"
    searchId="toponym-search-input"
    searchPlaceholder="Toponim nomi, elfdagi nomi yoki tavsifi boʻyicha qidirish..."
    filterGroups={filterGroups}
    totalCount={sortedPlaces.length}
    pageSize={24}
    emptyTitle="Mos keluvchi toponim topilmadi"
    emptyHint="Qidiruv so'zini o'zgartiring yoki davr va tur filtrlarini tozalang."
  >
    {sortedPlaces.map((place) => {
      const eraKey = getPlaceEraKey(place);
      const eraLabel = getPlaceEraLabel(place);
      const typeKey = place.type.replace(/ʻ|ʼ|'/g, '');
      const typeChipLabel = typeLabelMap[place.type] || place.type;
      const excerpt = getShortExcerpt(place.summary);

      // Faqatgina muallif nashridan (author_published) farq qilsa nishon ko'rsatiladi (takrorlanish yo'q)
      const badge = place.textual_status !== 'author_published'
        ? (place.textual_status === 'disputed_variant' ? 'Munozarali variant' : 'Vafotidan keyingi tahrir')
        : undefined;

      const metaRows = [
        { label: 'Davr', value: eraLabel },
        { label: 'Hukmdorlar', value: place.rulers && place.rulers.length > 0 ? place.rulers.join(', ') : '—' },
      ];

      const techChips = place.coordinates
        ? [`X: ${place.coordinates.x}, Y: ${place.coordinates.y}`]
        : [];

      const firstSource = place.sources?.[0];
      const sourceLine = firstSource
        ? `${firstSource.book_slug}${firstSource.chapter ? `, ${firstSource.chapter}` : ''}`
        : undefined;

      const searchCorpus = [
        place.name,
        place.elvish_name || '',
        place.type,
        eraLabel,
        place.summary,
        ...(place.rulers || []),
        ...(place.associated_characters?.map((c) => c.name) || []),
      ].join(' ').toLowerCase();

      return (
        <EntityCard
          id={`toponim-${place.id}`}
          name={place.name}
          originalName={place.elvish_name}
          typeChip={typeChipLabel}
          excerpt={excerpt}
          metaRows={metaRows}
          source={sourceLine}
          badge={badge}
          badgeVariant={place.textual_status === 'disputed_variant' ? 'variant' : 'info'}
          technicalChips={techChips}
          detailHref={`/xaritalar/${place.id}/`}
          detailLabel="Batafsil"
          secondaryLink={{
            label: 'Xaritada koʻrish',
            href: `/xaritalar/?hudud=${place.region}&joy=${place.id}#atlas-canvas-container`,
            actionClass: 'focus-marker-btn',
            attributes: {
              'data-focus-id': place.id,
              'data-focus-region': place.region,
            },
          }}
          searchCorpus={searchCorpus}
          dataAttributes={{
            'data-era': eraKey,
            'data-type': typeKey,
          }}
        />
      );
    })}
  </ListLayout>
</section>

<style>
  .atlas-toponyms-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .toponyms-header {
    margin-bottom: 2rem;
  }

  .toponyms-kicker {
    display: inline-block;
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold);
    margin-bottom: 0.375rem;
  }

  .toponyms-title {
    font-family: var(--font-serif-heading);
    font-size: 1.875rem;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.25;
  }

  .toponyms-lead {
    font-family: var(--font-serif-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 780px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
