---
import { getAllMaps } from '@/utils/atlas/map-registry';

interface Props {
  activeRegion: string;
  isJourneyActive?: boolean;
  activeJourneyId?: string;
}

const { activeRegion, isJourneyActive = false, activeJourneyId = 'bilbo' } = Astro.props;
const registeredMaps = getAllMaps();
const journeyLabel =
  activeJourneyId === 'fellowship'
    ? 'Qardoshlik Sayri'
    : activeJourneyId === 'ring-bearer'
      ? 'Frodo va Sam Sayri'
      : activeJourneyId === 'grey-company'
        ? 'Aragorn Sayri'
        : activeJourneyId === 'silmaril-quest'
          ? 'Beren va Lúthien Sayri'
          : 'Bilbo Sayri';
---

<div class="atlas-controls-bar" role="toolbar" aria-label="Atlas navigatsiyasi va boshqaruv asboblari">
  <!-- 1. Hududni tanlash tugmalari -->
  <div class="region-switcher" role="radiogroup" aria-label="Xarita hududini tanlang">
    {registeredMaps.map((map) => (
      <button
        type="button"
        role="radio"
        aria-checked={activeRegion === map.id ? 'true' : 'false'}
        class:list={['region-btn', { 'is-active': activeRegion === map.id }]}
        data-region-id={map.id}
      >
        <span class="btn-era">{map.eraUz}</span>
        <span class="btn-name">{map.titleUz}</span>
      </button>
    ))}
  </div>

  <!-- 2. Rejim va asboblar -->
  <div class="tools-group">
    <!-- Tarixiy Sayr (Bilbo, Qardoshlik, Aragorn, Beren va Lúthien) tugmasi -->
    <button
      type="button"
      id="btn-journey-toggle"
      class:list={['journey-toggle-btn', { 'is-active': isJourneyActive }]}
      aria-pressed={isJourneyActive ? 'true' : 'false'}
      aria-label="Tarixiy sayohatlar rejimini yoqish yoki oʻchirish"
      title="Tarixiy Sayohatlar (Bilbo Baggins, Uzuk Qardoshligi, Aragorn, Beren va Lúthien)"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
      </svg>
      <span id="journey-toggle-btn-label">{journeyLabel}</span>
    </button>

    <!-- Shir hududiga qaratish (Focus Shire) tugmasi -->
    <button
      type="button"
      id="btn-focus-shire"
      class="shire-focus-btn"
      aria-label="Xaritani Shir hududiga qaratish"
      title="Shir (Xobbiton, Suvboʻyi va Toʻrtliklar)"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 18 C7 11 11 9 12 9 C13 9 17 11 21 18"></path>
        <circle cx="12" cy="14" r="2.2" fill="currentColor"></circle>
      </svg>
      <span>Shir Koʻrinishi</span>
    </button>

    <!-- Xarita / Katalog almashtirgich -->
    <div class="view-toggle">
      <a href="#toponimlar" class="view-btn catalog-link" id="view-catalog-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="8" y1="6" x2="21" y2="6"></line>
          <line x1="8" y1="12" x2="21" y2="12"></line>
          <line x1="8" y1="18" x2="21" y2="18"></line>
          <line x1="3" y1="6" x2="3.01" y2="6"></line>
          <line x1="3" y1="12" x2="3.01" y2="12"></line>
          <line x1="3" y1="18" x2="3.01" y2="18"></line>
        </svg>
        <span>Toponimlar Roʻyxati</span>
      </a>
    </div>

    <!-- Masshtab (Zoom) va Markazlash tugmalari -->
    <div class="zoom-controls">
      <button
        type="button"
        id="btn-zoom-in"
        class="control-icon-btn"
        aria-label="Xaritani yaqinlashtirish (+)"
        title="Yaqinlashtirish (+)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <button
        type="button"
        id="btn-zoom-out"
        class="control-icon-btn"
        aria-label="Xaritani uzoqlashtirish (-)"
        title="Uzoqlashtirish (-)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <button
        type="button"
        id="btn-reset-view"
        class="control-icon-btn"
        aria-label="Xaritani markazga qaytarish"
        title="Markazga qaytarish (Home)"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .atlas-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    margin-bottom: 1rem;
    font-family: var(--font-sans-ui);
    flex-wrap: wrap;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .region-switcher {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    min-width: 0;
  }

  .region-btn {
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    padding: 0.5rem 0.875rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: all 0.15s ease;
    min-height: 44px;
    justify-content: center;
  }

  .region-btn:hover {
    border-color: var(--color-accent-gold);
  }

  .region-btn:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 2px;
  }

  .region-btn.is-active {
    background-color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    color: #ffffff;
  }

  .region-btn.is-active .btn-era {
    color: #f4eedf;
  }

  .region-btn.is-active .btn-name {
    color: #ffffff;
    font-weight: 700;
  }

  [data-theme="night"] .region-btn.is-active,
  :global([data-theme="night"]) .region-btn.is-active {
    color: #12100e;
  }

  [data-theme="night"] .region-btn.is-active .btn-era,
  :global([data-theme="night"]) .region-btn.is-active .btn-era {
    color: rgba(18, 16, 14, 0.85);
  }

  [data-theme="night"] .region-btn.is-active .btn-name,
  :global([data-theme="night"]) .region-btn.is-active .btn-name {
    color: #12100e;
  }

  .btn-era {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .btn-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .tools-group {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    min-width: 0;
    max-width: 100%;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.15s ease;
    min-height: 44px;
  }

  .view-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-gold);
  }

  .view-btn:focus-visible {
    outline: 2px solid var(--color-accent-gold);
  }

  .journey-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 44px;
    font-family: var(--font-sans-ui);
  }

  .journey-toggle-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-gold);
  }

  .journey-toggle-btn:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 2px;
  }

  .journey-toggle-btn.is-active,
  .journey-toggle-btn[aria-pressed="true"] {
    background-color: var(--color-accent-gold);
    border-color: var(--color-accent-gold);
    color: #12100e;
    font-weight: 700;
  }

  [data-theme="night"] .journey-toggle-btn.is-active,
  :global([data-theme="night"]) .journey-toggle-btn.is-active {
    background-color: var(--color-accent-gold);
    color: #12100e;
  }

  .shire-focus-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
    min-height: 44px;
    font-family: var(--font-sans-ui);
  }

  .shire-focus-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-gold);
  }

  .shire-focus-btn:focus-visible {
    outline: 2px solid var(--color-accent-gold);
    outline-offset: 2px;
  }

  .zoom-controls {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    padding: 2px;
  }

  .control-icon-btn {
    background: transparent;
    border: none;
    border-radius: 3px;
    color: var(--color-text-secondary);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .control-icon-btn:hover {
    background-color: var(--color-bg-elevated);
    color: var(--color-text-primary);
  }

  .control-icon-btn:focus-visible {
    outline: 2px solid var(--color-accent-gold);
  }

  @media (max-width: 640px) {
    .atlas-controls-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .region-switcher {
      width: 100%;
    }

    .region-btn {
      flex: 1;
    }

    .tools-group {
      justify-content: space-between;
    }
  }
</style>
