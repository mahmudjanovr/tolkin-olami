---
/**
 * TOLKIEN OLAMI — Interaktiv SVG Nasabnoma Kanvasi (Section B: Interactive Genealogy Canvas)
 *
 * Yengil vaznli SVG shajara chizgichi: portretli tugunlar, ota-ona/farzand, nikoh,
 * aka-uka/opa-singil va oraliq avlod koʻprigi chiziqlari, masshtablash/surish hamda
 * tarmoqlarni yoyish/yigʻish boshqaruvi.
 */

import type { DynastyModel, GenealogyPersonProfile } from '@/utils/genealogy/genealogy-model';
import GenealogyAccessibleTree from './GenealogyAccessibleTree.astro';

interface Props {
  activeDynasty: DynastyModel;
  people: Record<string, GenealogyPersonProfile>;
}

const { activeDynasty, people } = Astro.props;
const { layout } = activeDynasty;
const selectedId = activeDynasty.featuredId;

function truncateLabel(str: string, maxLen: number): string {
  if (str.length <= maxLen) return str;
  return `${str.slice(0, maxLen - 1).trimEnd()}…`;
}

function getInitials(name: string): string {
  const parts = name.replace(/[()]/g, '').trim().split(/\s+/);
  if (parts.length === 1) return (parts[0] || 'T').slice(0, 2).toUpperCase();
  return ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase();
}

// Har bir avlod Y koordinatasi
const genRowsMap = new Map<number, number>();
for (const n of layout.nodes) {
  if (!genRowsMap.has(n.generation)) {
    genRowsMap.set(n.generation, n.y);
  }
}
const sortedGenRows = Array.from(genRowsMap.entries()).sort((a, b) => a[0] - b[0]);
const romans = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];

// Farzandga ega tugunlar (Expand/Collapse tugmasi uchun)
const parentChildCounts = new Map<string, number>();
for (const n of layout.nodes) {
  for (const pid of n.parentIds) {
    parentChildCounts.set(pid, (parentChildCounts.get(pid) || 0) + 1);
  }
}
for (const link of layout.links) {
  if (link.type === 'bridge') {
    parentChildCounts.set(link.fromId, (parentChildCounts.get(link.fromId) || 0) + 1);
  }
}

// Nasab zanjiri (selectedId uchun)
function buildLineageIds(targetId: string): string[] {
  const chain: string[] = [];
  const visited = new Set<string>();
  let curr: string | undefined = targetId;
  while (curr && !visited.has(curr)) {
    visited.add(curr);
    chain.unshift(curr);
    const node = layout.nodes.find((n) => n.id === curr);
    const nextParent = node?.parentIds.find((pid) => layout.nodes.some((n) => n.id === pid));
    curr = nextParent;
  }
  return chain;
}

const initialLineageIds = buildLineageIds(selectedId);
---

<section
  id="genealogy-canvas-stage"
  class="genealogy-canvas-stage"
  aria-label={`${activeDynasty.title} interaktiv shajara maydoni`}
>
  <!-- 1. Yuqori boshqaruv paneli: mobil tortmalar, nasab yoʻli va masshtab tugmalari -->
  <div class="canvas-toolbar">
    <div class="toolbar-left-group">
      <!-- Mobil tortma tugmalari (< 1120px) -->
      <div class="mobile-drawer-triggers">
        <button
          type="button"
          id="btn-open-left-drawer"
          class="canvas-tool-btn mobile-trigger-btn"
          aria-controls="genealogy-left-sidebar"
          aria-expanded="false"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="14" y2="12"></line>
            <line x1="4" y1="18" x2="18" y2="18"></line>
          </svg>
          <span>Filtrlar</span>
        </button>

        <button
          type="button"
          id="btn-open-right-drawer"
          class="canvas-tool-btn mobile-trigger-btn"
          aria-controls="genealogy-profile-panel"
          aria-expanded="false"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Shaxs profili</span>
        </button>
      </div>

      <!-- Nasab yoʻli (Breadcrumbs) -->
      <nav class="lineage-trail-nav" aria-label="Tanlangan shaxsning shajaraviy yoʻli">
        <div class="breadcrumb-trail" id="breadcrumb-trail">
          {initialLineageIds.map((pid, idx) => {
            const p = people[pid];
            if (!p) return null;
            const isLast = idx === initialLineageIds.length - 1;
            return (
              <>
                {idx > 0 && <span class="crumb-sep" aria-hidden="true">›</span>}
                <button
                  type="button"
                  class={`crumb-person-btn ${isLast ? 'is-active' : ''}`}
                  data-person-id={pid}
                >
                  {p.name}
                </button>
              </>
            );
          })}
        </div>
      </nav>
    </div>

    <div class="toolbar-right-group">
      <!-- Masshtablash va joylashuv boshqaruvlari -->
      <div class="zoom-controls-group" role="group" aria-label="Kanvas masshtabini boshqarish">
        <button
          type="button"
          id="btn-zoom-out"
          class="canvas-icon-btn"
          title="Kichraytirish (−)"
          aria-label="Daraxtni kichraytirish"
        >
          −
        </button>
        <span id="zoom-level-label" class="zoom-level-readout" aria-live="off">100%</span>
        <button
          type="button"
          id="btn-zoom-in"
          class="canvas-icon-btn"
          title="Kattalashtirish (+)"
          aria-label="Daraxtni kattalashtirish"
        >
          +
        </button>
        <button
          type="button"
          id="btn-fit-screen"
          class="canvas-tool-btn"
          title="Butun daraxtni ekranga moslash"
        >
          Moslash
        </button>
        <button
          type="button"
          id="btn-reset-view"
          class="canvas-tool-btn"
          title="Asl masshtab va markazga qaytarish"
        >
          Tiklash
        </button>
        <button
          type="button"
          id="btn-return-root"
          class="canvas-tool-btn"
          data-founder-id={activeDynasty.founderId}
          title="Sulola asoschisini tanlash"
        >
          Asoschi
        </button>
      </div>

      <!-- Shajara | Roʻyxat koʻrinish almashinuvi -->
      <div class="view-mode-switch" role="group" aria-label="Koʻrinish rejimi">
        <button
          type="button"
          id="btn-mode-tree"
          class="mode-btn active"
          aria-pressed="true"
        >
          Shajara
        </button>
        <button
          type="button"
          id="btn-mode-list"
          class="mode-btn"
          aria-pressed="false"
        >
          Roʻyxat
        </button>
      </div>
    </div>
  </div>

  <!-- 2. Interaktiv SVG Daraxt Maydoni -->
  <div
    id="genealogy-views-container"
    class="svg-viewport-wrap"
  >
    <div
      id={`dynasty-panel-${activeDynasty.id}`}
      class="svg-pan-container"
      data-dynasty-panel
    >
      <svg
        id="genealogy-tree-svg"
        class="genealogy-tree-svg"
        viewBox={`0 0 ${layout.dimensions.width} ${layout.dimensions.height}`}
        role="group"
        aria-label={`${activeDynasty.title} shajara daraxti`}
      >
        <defs id="svg-portrait-defs">
          {layout.nodes.map((node) => (
            <clipPath id={`clip-node-${node.id}`}>
              <circle cx="30" cy="37" r="20" />
            </clipPath>
          ))}
        </defs>

        <g id="genealogy-pan-zoom-layer">
          <!-- Qatlam 1: Avlod gorizontal chiziqlari -->
          <g id="svg-generation-bands" aria-hidden="true">
            {sortedGenRows.map(([gen, y]) => (
              <g class="svg-gen-band" data-gen-band={gen}>
                <line
                  x1="12"
                  y1={y + 37}
                  x2={layout.dimensions.width - 12}
                  y2={y + 37}
                  class="gen-guide-line"
                />
                <text x="14" y={y - 10} class="gen-band-label">
                  {romans[gen - 1] || gen} AVLOD
                </text>
              </g>
            ))}
          </g>

          <!-- Qatlam 2: Bogʻlovchi qarindoshlik chiziqlari -->
          <g id="svg-links-layer">
            {layout.links.map((link) => {
              const relKind =
                link.type === 'marriage'
                  ? 'spouse'
                  : link.type === 'bridge'
                    ? 'lineage-bridge'
                    : link.type;

              // Nikoh oʻrtasidagi olmos qisqich koordinatasi
              let midMarriageX: number | undefined;
              let midMarriageY: number | undefined;
              if (link.type === 'marriage' && link.pathD.includes(' L ')) {
                const coords = link.pathD.replace('M ', '').split(' L ');
                const p1 = coords[0]?.split(' ').map(Number);
                const p2 = coords[1]?.split(' ').map(Number);
                if (p1 && p2 && p1.length === 2 && p2.length === 2) {
                  midMarriageX = Math.round(((p1[0] || 0) + (p2[0] || 0)) / 2);
                  midMarriageY = p1[1] || 0;
                }
              }

              let startJointX: number | undefined;
              let startJointY: number | undefined;
              if (link.type !== 'marriage') {
                const startMatch = /^M\s+(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)/.exec(link.pathD);
                if (startMatch) {
                  startJointX = Number(startMatch[1]);
                  startJointY = Number(startMatch[2]);
                }
              }

              return (
                <g
                  class={`svg-rel-group rel-${relKind} ${link.isUncertain ? 'is-uncertain' : ''}`}
                  data-rel-type={relKind}
                  data-from={link.fromId}
                  data-to={link.toId}
                >
                  {link.type === 'marriage' && (
                    <path d={link.pathD} class="svg-link-marriage-halo" fill="none" />
                  )}
                  <path
                    d={link.pathD}
                    class={`svg-link-path link-${relKind} ${link.isUncertain ? 'link-uncertain' : ''}`}
                    fill="none"
                  />
                  {startJointX !== undefined && startJointY !== undefined && (
                    <circle
                      cx={startJointX}
                      cy={startJointY}
                      r="2.2"
                      class={`svg-descent-joint joint-${relKind} ${link.isUncertain ? 'joint-uncertain' : ''}`}
                    />
                  )}
                  {midMarriageX !== undefined && midMarriageY !== undefined && (
                    <polygon
                      points={`${midMarriageX},${midMarriageY - 4} ${midMarriageX + 4},${midMarriageY} ${midMarriageX},${midMarriageY + 4} ${midMarriageX - 4},${midMarriageY}`}
                      class="marriage-union-diamond"
                    />
                  )}
                </g>
              );
            })}
          </g>

          <!-- Qatlam 3: Shaxs tugunlari (Portret + Ism + Unvon + Sanalar) -->
          <g id="svg-nodes-layer">
            {layout.nodes.map((node) => {
              const profile = people[node.id];
              const isSelected = node.id === selectedId;
              const childCount = parentChildCounts.get(node.id) || 0;
              const primaryRole = node.titles[0] || node.culture || 'Kanonik shaxs';

              return (
                <>
                  <g
                    id={`node-${node.id}`}
                    class={`tree-person-node ${isSelected ? 'is-selected' : ''} ${node.isUncertain ? 'is-uncertain' : ''}`}
                    transform={`translate(${node.x}, ${node.y})`}
                    data-person-id={node.id}
                    data-generation={node.generation}
                    tabindex="0"
                    role="button"
                    aria-label={`${node.name} (${node.dates})`}
                  >
                    <title>{`${node.name} — ${primaryRole} (${node.dates})`}</title>

                    {/* Asosiy karta foni */}
                    <rect
                      x="0"
                      y="0"
                      width={node.width}
                      height={node.height}
                      rx="5"
                      class="node-card-bg"
                    />

                    {/* Tanlangan holat oltin ichki gardishi */}
                    <rect
                      x="2.5"
                      y="2.5"
                      width={node.width - 5}
                      height={node.height - 5}
                      rx="3.5"
                      class="node-selected-inner-ring"
                    />

                    {/* Portret medalyoni yoki monogramma */}
                    {profile?.portrait ? (
                      <g class="node-portrait-group">
                        <circle cx="30" cy="37" r="20.5" class="node-portrait-backdrop" />
                        <image
                          href={profile.portrait.thumb}
                          x="10"
                          y="17"
                          width="40"
                          height="40"
                          preserveAspectRatio="xMidYMid slice"
                          clip-path={`url(#clip-node-${node.id})`}
                        />
                        <circle cx="30" cy="37" r="20.5" class="node-portrait-ring" />
                      </g>
                    ) : (
                      <g class="node-monogram-group">
                        <circle cx="30" cy="37" r="20" class="node-monogram-circle" />
                        <text x="30" y="41.5" text-anchor="middle" class="node-monogram-label">
                          {getInitials(node.name)}
                        </text>
                      </g>
                    )}

                    {/* Ism, unvon va sanalar */}
                    <text x="58" y="27" class="node-name-text">
                      {truncateLabel(node.name, 17)}
                    </text>
                    <text x="58" y="43" class="node-role-text">
                      {truncateLabel(primaryRole, 22)}
                    </text>
                    <text x="58" y="58" class="node-dates-text">
                      {truncateLabel(node.dates, 23)}
                    </text>

                    {/* Munozarali / Noaniq maqom nishoni */}
                    {node.isUncertain && (
                      <g transform={`translate(${node.width - 20}, 6)`} class="node-uncertain-badge">
                        <rect x="0" y="0" width="14" height="14" rx="7" class="uncertain-pill-bg" />
                        <text x="7" y="10.5" text-anchor="middle" class="uncertain-pill-mark">?</text>
                      </g>
                    )}

                    {/* Oraliq koʻprik yorligʻi */}
                    {node.bridgeNote && (
                      <g transform="translate(8, -11)" class="node-bridge-tag">
                        <rect
                          x="0"
                          y="0"
                          width={Math.min(node.width - 16, Math.max(76, node.bridgeNote.length * 5.6 + 12))}
                          height="15"
                          rx="3"
                          class="bridge-tag-bg"
                        />
                        <text x="6" y="10.5" class="bridge-tag-text">
                          {truncateLabel(node.bridgeNote, 25)}
                        </text>
                      </g>
                    )}
                  </g>

                  {/* Shoxni yigʻish / yoyish tugmasi (WCAG 4.1.2 boʻyicha mustaqil tugma sifatida) */}
                  {childCount > 0 && (
                    <g
                      class="node-collapse-toggle"
                      data-collapse-id={node.id}
                      transform={`translate(${node.x + node.width / 2}, ${node.y + node.height})`}
                      role="button"
                      tabindex="0"
                      aria-expanded="true"
                      aria-label={`${node.name} farzandlari shoxini yigʻish yoki yoyish`}
                    >
                      <rect x="-13" y="-8" width="26" height="16" rx="8" class="collapse-pill-bg" />
                      <text x="0" y="3.5" text-anchor="middle" class="collapse-pill-text">−</text>
                    </g>
                  )}
                </>
              );
            })}
          </g>
        </g>
      </svg>
    </div>
  </div>

  <!-- 3. Semantik Roʻyxat rejimi (No-JS va Roʻyxat tugmasi uchun) -->
  <div id="genealogy-accessible-views" class="genealogy-accessible-views" hidden>
    <GenealogyAccessibleTree
      dynastyId={activeDynasty.id}
      dynastyTitle={activeDynasty.title}
      houseName={activeDynasty.houseName}
      layout={activeDynasty.layout}
    />
  </div>

  <!-- 4. Kanvas shartli belgilari (Relationship Types Legend) -->
  <footer class="canvas-legend-bar" aria-label="Shajara chiziqlari va shartli belgilar izohi">
    <div class="legend-items-row">
      <span class="legend-item">
        <svg width="24" height="10" viewBox="0 0 24 10" aria-hidden="true">
          <line x1="0" y1="5" x2="24" y2="5" class="legend-stroke-parent" />
        </svg>
        <span>Ota-ona / farzand</span>
      </span>

      <span class="legend-item">
        <svg width="24" height="10" viewBox="0 0 24 10" aria-hidden="true">
          <line x1="0" y1="5" x2="24" y2="5" class="legend-stroke-spouse" />
          <polygon points="12,1.5 15.5,5 12,8.5 8.5,5" class="marriage-union-diamond" />
        </svg>
        <span>Nikoh ittifoqi</span>
      </span>

      <span class="legend-item">
        <svg width="24" height="10" viewBox="0 0 24 10" aria-hidden="true">
          <line x1="0" y1="5" x2="24" y2="5" class="legend-stroke-sibling" />
        </svg>
        <span>Aka-uka / opa-singil</span>
      </span>

      <span class="legend-item">
        <svg width="24" height="10" viewBox="0 0 24 10" aria-hidden="true">
          <line x1="0" y1="5" x2="24" y2="5" class="legend-stroke-bridge" />
        </svg>
        <span>Oraliq avlod koʻprigi</span>
      </span>

      <span class="legend-item">
        <svg width="24" height="10" viewBox="0 0 24 10" aria-hidden="true">
          <line x1="0" y1="5" x2="24" y2="5" class="legend-stroke-uncertain" />
        </svg>
        <span>Munozarali / variant</span>
      </span>
    </div>

    <span class="legend-interaction-hint">
      Surish va masshtablash faol · Maʼlumot uchun shaxsni bosing
    </span>
  </footer>
</section>

<style>
  .genealogy-canvas-stage {
    display: flex;
    flex-direction: column;
    background-color: var(--gen-ivory);
    border: 1px solid var(--gen-border);
    border-radius: 4px;
    overflow: hidden;
    min-width: 0;
  }

  .canvas-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    background-color: var(--gen-ivory-elevated);
    border-bottom: 1px solid var(--gen-border);
  }

  .toolbar-left-group,
  .toolbar-right-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-width: 0;
  }

  .mobile-drawer-triggers {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }

  @media (max-width: 1119px) {
    .mobile-drawer-triggers {
      display: inline-flex;
    }
  }

  .lineage-trail-nav {
    min-width: 0;
  }

  .breadcrumb-trail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.2rem;
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
  }

  :global(.crumb-sep) {
    color: var(--color-text-muted);
    padding-inline: 0.1rem;
  }

  :global(.crumb-person-btn) {
    background: none;
    border: none;
    padding: 0.18rem 0.38rem;
    border-radius: 3px;
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  :global(.crumb-person-btn:hover) {
    background-color: var(--gen-ivory-subtle);
    color: var(--color-text-primary);
  }

  :global(.crumb-person-btn.is-active) {
    font-weight: 700;
    color: var(--gen-pine-text);
    background-color: var(--gen-ivory-subtle);
  }

  .zoom-controls-group {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .canvas-icon-btn,
  .canvas-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    height: 30px;
    padding: 0 0.55rem;
    background-color: var(--gen-ivory);
    border: 1px solid var(--gen-border);
    border-radius: 3px;
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .canvas-icon-btn {
    width: 30px;
    padding: 0;
    font-size: 0.95rem;
  }

  .canvas-icon-btn:hover,
  .canvas-tool-btn:hover {
    border-color: var(--gen-gold);
    background-color: var(--gen-ivory-subtle);
  }

  .zoom-level-readout {
    font-family: var(--font-sans-ui);
    font-size: 0.71875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
    min-width: 2.6rem;
    text-align: center;
  }

  .view-mode-switch {
    display: inline-flex;
    border: 1px solid var(--gen-border);
    border-radius: 3px;
    overflow: hidden;
  }

  .mode-btn {
    height: 30px;
    padding: 0 0.65rem;
    background-color: var(--gen-ivory);
    border: none;
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .mode-btn.active {
    background-color: var(--gen-pine-fill);
    color: #F7F4EC;
  }

  /* SVG Kanvas Konteyneri */
  .svg-viewport-wrap {
    position: relative;
    width: 100%;
    height: clamp(460px, 66vh, 690px);
    background-color: var(--gen-ivory);
    background-image: radial-gradient(var(--gen-grid-dot) 1px, transparent 1px);
    background-size: 22px 22px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .svg-viewport-wrap {
      height: 440px;
    }
  }

  .svg-pan-container {
    width: 100%;
    height: 100%;
    touch-action: none;
    user-select: none;
    cursor: grab;
  }

  .svg-pan-container.is-panning {
    cursor: grabbing;
  }

  .genealogy-tree-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* SVG ichki qatlamlar uslublari (:global chunki klient JS ham dinamik chizadi) */
  :global(.gen-guide-line) {
    stroke: var(--gen-guide-rule);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  :global(.gen-band-label) {
    font-family: var(--font-sans-ui);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    fill: var(--color-text-muted);
  }

  :global(.svg-link-path.link-parent-child) {
    stroke: var(--gen-pine-stroke);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  :global(.svg-link-marriage-halo) {
    stroke: var(--gen-gold-soft);
    stroke-width: 5;
