    --gen-canon-bg: rgba(33, 77, 75, 0.38);

    --gen-gold: #B49A62;
    --gen-gold-soft: rgba(180, 154, 98, 0.22);
    --gen-gold-text: #DEC078;

    --gen-sibling-stroke: #6B8E8C;
    --gen-uncertain: #E09F67;
    --gen-uncertain-bg: rgba(224, 159, 103, 0.14);
    --gen-variant-text: #95C8DA;
    --gen-variant-bg: rgba(149, 200, 218, 0.14);

    --gen-node-border: #33504C;
    --gen-node-selected-bg: #1D3330;
    --gen-guide-rule: rgba(154, 197, 194, 0.12);
    --gen-grid-dot: rgba(180, 154, 98, 0.1);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]):not([data-theme="night"])) .genealogy-atlas-root,
    :global([data-theme="system"]) .genealogy-atlas-root {
