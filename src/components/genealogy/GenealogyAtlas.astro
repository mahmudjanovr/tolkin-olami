---
/**
 * TOLKIEN OLAMI — Nasabnomalar Markaziy Orkestratori (GenealogyAtlas.astro)
 *
 * 5 qismli Classic Heritage arxitekturasi:
 * A. Sulola sarlavhasi (GenealogyDynastyHeader)
 * B. Interaktiv SVG shajara kanvasi (GenealogyCanvas)
 * C. Chap boshqaruv va filtrlar paneli (GenealogySidebar)
 * D. Oʻng shaxs profili paneli (GenealogyProfilePanel)
 * E. Manbalar va kanon maqomi tahlili (GenealogySourcesSection)
 */

import { getCollection } from 'astro:content';
import {
  buildGenealogyDataset,
  serializeGenealogyClientPayload,
  validateGenealogyDataset,
} from '@/utils/genealogy/genealogy-model';
import GenealogyDynastyHeader from './GenealogyDynastyHeader.astro';
import GenealogySidebar from './GenealogySidebar.astro';
import GenealogyCanvas from './GenealogyCanvas.astro';
import GenealogyProfilePanel from './GenealogyProfilePanel.astro';
import GenealogySourcesSection from './GenealogySourcesSection.astro';

interface Props {
  initialDynastyId?: string;
}

const { initialDynastyId } = Astro.props;

const [genealogyEntries, characterEntries, eventEntries] = await Promise.all([
  getCollection('genealogies'),
  getCollection('characters'),
  getCollection('events'),
]);

const dataset = buildGenealogyDataset(
  genealogyEntries.map((e) => e.data),
  characterEntries.map((e) => e.data),
  eventEntries.map((e) => e.data)
);

const validation = validateGenealogyDataset(dataset);
if (!validation.isValid) {
  throw new Error(
    `[GenealogyAtlas] Maʼlumotlar yaxlitligi buzilgan: ${JSON.stringify(validation)}`
  );
}

const activeDynasty =
  dataset.dynasties.find((d) => d.id === initialDynastyId) || dataset.dynasties[0]!;
const initialPerson =
  dataset.people[activeDynasty.featuredId] ||
  dataset.people[activeDynasty.founderId] ||
  Object.values(dataset.people)[0]!;

// Klient uchun faol sulola bootstrap paketi (toʻliq maʼlumot /assets/genealogy-data.json orqali keshlanadi)
const clientPayload = serializeGenealogyClientPayload(dataset, activeDynasty.id);
---

<div
  id="genealogy-atlas-root"
  class="genealogy-atlas-root"
  data-active-dynasty={activeDynasty.id}
  data-selected-person={initialPerson.id}
>
  <!-- A. Sulola sarlavhasi va sulolalar tablari -->
  <GenealogyDynastyHeader
    dynasties={dataset.dynasties}
    activeDynasty={activeDynasty}
    people={dataset.people}
  />

  <!-- Asosiy 3 ustunli ish maydoni: C (Chap Sidebar) + B (Markaziy SVG Kanvas) + D (Oʻng Profil) -->
  <div class="genealogy-workbench" id="genealogy-workspace">
    <GenealogySidebar activeDynasty={activeDynasty} filters={dataset.filters} />

    <GenealogyCanvas activeDynasty={activeDynasty} people={dataset.people} />

    <GenealogyProfilePanel person={initialPerson} />
  </div>

  <!-- Mobil tortmalar uchun yarim shaffof parda -->
  <div
    id="genealogy-drawer-backdrop"
    class="genealogy-drawer-backdrop"
    hidden
    aria-hidden="true"
  ></div>

  <!-- E. Birlamchi manbalar, tarixiy izohlar va kanon maqomi tahlili -->
  <GenealogySourcesSection activeDynasty={activeDynasty} people={dataset.people} />

  <script
    type="application/json"
    id="genealogy-client-data"
    set:html={JSON.stringify(clientPayload)}
  />
</div>

<script>
  import type {
    CanonStatus,
    EraFilterKey,
    GenealogyBranchOption,
    GenealogyPersonProfile,
    RelationshipType,
    ResolvedSourceItem,
  } from '@/utils/genealogy/genealogy-model';

  interface CompactNode {
    id: string;
    x: number;
    y: number;
    width: number;
    height: number;
    generation: number;
    order: number;
    isUncertain: boolean;
    spouseIds: string[];
    parentIds: string[];
    bridgeNote?: string;
  }

  interface CompactLink {
    fromId: string;
    toId: string;
    type: 'parent-child' | 'marriage' | 'bridge' | 'sibling';
    pathD: string;
    isUncertain: boolean;
    bridgeNote?: string;
  }

  interface CompactDynasty {
    id: string;
    title: string;
    shortTitle: string;
    houseName: string;
    founderId: string;
    featuredId: string;
    era: string;
    summary: string;
    relevantPeopleIds: string[];
    branches: GenealogyBranchOption[];
    memberBranchMap: Record<string, string>;
    canonStats: {
      confirmedCount: number;
      variantCount: number;
      uncertainCount: number;
      bridgeCount: number;
    };
    sources: ResolvedSourceItem[];
    layout: {
      dimensions: { width: number; height: number };
      nodes: CompactNode[];
      links: CompactLink[];
    };
  }

  interface ClientPayload {
    isPartial?: boolean;
    dynasties: CompactDynasty[];
    people: Record<string, GenealogyPersonProfile>;
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const ROMANS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];

  function truncate(str: string, maxLen: number): string {
    if (!str) return '';
    return str.length <= maxLen ? str : `${str.slice(0, maxLen - 1).trimEnd()}…`;
  }

  function initialsOf(name: string): string {
    const parts = name.replace(/[()]/g, '').trim().split(/\s+/);
    if (parts.length === 1) return (parts[0] || 'T').slice(0, 2).toUpperCase();
    return ((parts[0]?.[0] || '') + (parts[1]?.[0] || '')).toUpperCase();
  }

  function escapeHtml(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function svgEl<K extends keyof SVGElementTagNameMap>(
    tag: K,
    attrs: Record<string, string | number> = {}
  ): SVGElementTagNameMap[K] {
    const el = document.createElementNS(SVG_NS, tag);
    for (const [k, v] of Object.entries(attrs)) {
      el.setAttribute(k, String(v));
    }
    return el;
  }

  function initGenealogyAtlas(): void {
    const root = document.getElementById('genealogy-atlas-root');
    const dataEl = document.getElementById('genealogy-client-data');
    if (!root || !dataEl?.textContent) return;

    let payload: ClientPayload;
    try {
      payload = JSON.parse(dataEl.textContent) as ClientPayload;
    } catch {
      return;
    }

    const dynastyMap = new Map<string, CompactDynasty>();
    for (const d of payload.dynasties) {
      dynastyMap.set(d.id, d);
    }
    const people = payload.people;

    let fullDataLoaded = !payload.isPartial;
    let fullDataPromise: Promise<void> | null = null;

    function ensureFullDataset(): Promise<void> {
      if (fullDataLoaded) return Promise.resolve();
      if (!fullDataPromise) {
        fullDataPromise = fetch('/assets/genealogy-data.json')
          .then((res) => (res.ok ? (res.json() as Promise<ClientPayload>) : null))
          .then((full) => {
            if (!full) return;
            for (const d of full.dynasties) {
              dynastyMap.set(d.id, d);
            }
            Object.assign(people, full.people);
            fullDataLoaded = true;
          })
          .catch(() => {});
      }
      return fullDataPromise;
    }

    // URL parametrlarini oʻqish (?sulola=...&shaxs=...&uslub=...)
    const urlParams = new URLSearchParams(window.location.search);
    const paramDynasty = urlParams.get('sulola');
    const paramPerson = urlParams.get('shaxs');
    const paramMode = urlParams.get('uslub');

    let activeDynastyId =
      (paramDynasty && dynastyMap.has(paramDynasty) ? paramDynasty : root.dataset.activeDynasty) ||
      payload.dynasties[0]!.id;

    if (paramPerson && people[paramPerson] && !paramDynasty) {
      const ownerDynasty = people[paramPerson]!.dynastyIds[0];
      if (ownerDynasty && dynastyMap.has(ownerDynasty)) {
        activeDynastyId = ownerDynasty;
      }
    }

    let currentDynasty = dynastyMap.get(activeDynastyId) || payload.dynasties[0]!;
    let selectedPersonId =
      paramPerson && people[paramPerson] ? paramPerson : currentDynasty.featuredId;

    let viewMode: 'tree' | 'list' = paramMode === 'royxat' ? 'list' : 'tree';

    // Filtr va tarmoq holatlari
    let filterRace = 'all';
    let filterEra: EraFilterKey | 'all' = 'all';
    let filterRelType: RelationshipType | 'all' = 'all';
    let filterCanon: CanonStatus | 'all' = 'all';
    let searchQuery = '';

    const hiddenBranches = new Set<string>();
    const collapsedParents = new Set<string>();

    // Masshtab va surish (Pan & Zoom) holati
    let zoom = 1;
    let panX = 0;
    let panY = 0;
    const MIN_ZOOM = 0.36;
    const MAX_ZOOM = 2.4;

    // DOM elementlar
    const svgViewportWrap = document.getElementById('genealogy-views-container');
    const panContainer = root.querySelector<HTMLElement>('[data-dynasty-panel]');
    const svgRoot = document.getElementById('genealogy-tree-svg') as SVGSVGElement | null;
    const svgDefs = document.getElementById('svg-portrait-defs');
    const panZoomLayer = document.getElementById('genealogy-pan-zoom-layer');
    const bandsLayer = document.getElementById('svg-generation-bands');
    const linksLayer = document.getElementById('svg-links-layer');
    const nodesLayer = document.getElementById('svg-nodes-layer');
    const accessibleWrap = document.getElementById('genealogy-accessible-views');
    const zoomLabel = document.getElementById('zoom-level-label');

    const leftSidebar = document.getElementById('genealogy-left-sidebar');
    const rightPanel = document.getElementById('genealogy-profile-panel');
    const backdrop = document.getElementById('genealogy-drawer-backdrop');
    const btnOpenLeft = document.getElementById('btn-open-left-drawer');
    const btnOpenRight = document.getElementById('btn-open-right-drawer');

    if (!svgRoot || !panZoomLayer || !bandsLayer || !linksLayer || !nodesLayer || !panContainer) {
      return;
    }

    // SSR viewBox oʻrniga aniq piksel fazosidagi transformatsiyani yoqish
    svgRoot.removeAttribute('viewBox');

    function syncUrl(): void {
      const next = new URL(window.location.href);
      if ( window.location.pathname === '/nasabnomalar/' || window.location.pathname === '/nasabnomalar' ) {
        next.searchParams.set('sulola', activeDynastyId);
      }
      if (selectedPersonId) {
        next.searchParams.set('shaxs', selectedPersonId);
      }
      if (viewMode === 'list') {
        next.searchParams.set('uslub', 'royxat');
      } else {
        next.searchParams.delete('uslub');
      }
      window.history.replaceState({}, '', next.toString());
    }

    function applyTransform(): void {
      panZoomLayer!.setAttribute(
        'transform',
        `translate(${Math.round(panX * 10) / 10}, ${Math.round(panY * 10) / 10}) scale(${Math.round(zoom * 1000) / 1000})`
      );
      if (zoomLabel) {
        zoomLabel.textContent = `${Math.round(zoom * 100)}%`;
      }
    }

    // Yigʻilgan tarmoqlar (collapsedParents) va oʻchirilgan shajara tarmoqlari boʻyicha yashiringan tugunlar
    function computeHiddenNodeIds(dynasty: CompactDynasty): {
      hiddenIds: Set<string>;
      collapsedCounts: Map<string, number>;
    } {
      const hiddenIds = new Set<string>();

      for (const node of dynasty.layout.nodes) {
        const bId = dynasty.memberBranchMap[node.id];
        if (bId && bId !== 'root' && hiddenBranches.has(bId)) {
          hiddenIds.add(node.id);
        }
      }

      // Ota-onadan pastga yoʻnalgan farzandlik grafi (parent-child va bridge)
      const directChildren = new Map<string, string[]>();
      for (const n of dynasty.layout.nodes) {
        for (const pid of n.parentIds) {
          const arr = directChildren.get(pid) || [];
          if (!arr.includes(n.id)) arr.push(n.id);
          directChildren.set(pid, arr);
        }
      }
      for (const link of dynasty.layout.links) {
        if (link.type === 'bridge') {
          const arr = directChildren.get(link.fromId) || [];
          if (!arr.includes(link.toId)) arr.push(link.toId);
          directChildren.set(link.fromId, arr);
        }
      }

      function collectDescendants(startId: string, bag: Set<string>): void {
        const kids = directChildren.get(startId) || [];
        for (const kidId of kids) {
          if (!bag.has(kidId)) {
            bag.add(kidId);
            // Agar farzandning faqat shu nikohdagi tashqi jufti boʻlsa (parentIds boʻsh juft)
            const kidNode = dynasty.layout.nodes.find((n) => n.id === kidId);
            if (kidNode) {
              for (const spId of kidNode.spouseIds) {
                const spNode = dynasty.layout.nodes.find((n) => n.id === spId);
                if (spNode && spNode.parentIds.length === 0) {
                  bag.add(spId);
                }
              }
            }
            collectDescendants(kidId, bag);
          }
        }
      }

      const collapsedCounts = new Map<string, number>();
      for (const n of dynasty.layout.nodes) {
        const desc = new Set<string>();
        collectDescendants(n.id, desc);
        if (desc.size > 0) {
          collapsedCounts.set(n.id, desc.size);
        }
        if (collapsedParents.has(n.id)) {
          for (const dId of desc) {
            hiddenIds.add(dId);
          }
        }
      }

      return { hiddenIds, collapsedCounts };
    }

    function doesPersonMatchFilters(
      person: GenealogyPersonProfile,
      participatingInRelFilter: Set<string> | null
    ): boolean {
      if (filterRace !== 'all' && person.race !== filterRace) return false;
      if (filterEra !== 'all' && !person.eras.includes(filterEra)) return false;
      if (filterCanon !== 'all' && person.canonStatus !== filterCanon) return false;
      if (participatingInRelFilter && !participatingInRelFilter.has(person.id)) return false;
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        const hay = [
          person.name,
          person.originalName || '',
          ...person.aliases,
          ...person.titles,
          person.culture,
        ]
          .join(' ')
          .toLowerCase();
        if (!hay.includes(q)) return false;
      }
      return true;
    }

    function fitTreeToViewport(): void {
      const rect = panContainer!.getBoundingClientRect();
      const vw = rect.width || 620;
      const vh = rect.height || 520;
      const { hiddenIds } = computeHiddenNodeIds(currentDynasty);
      const visibleNodes = currentDynasty.layout.nodes.filter((n) => !hiddenIds.has(n.id));

      if (visibleNodes.length === 0) {
        zoom = 1;
        panX = 24;
        panY = 24;
        applyTransform();
        return;
      }

      const minX = Math.min(...visibleNodes.map((n) => n.x));
      const maxX = Math.max(...visibleNodes.map((n) => n.x + n.width));
      const minY = Math.min(...visibleNodes.map((n) => n.y));
      const maxY = Math.max(...visibleNodes.map((n) => n.y + n.height));

      const contentW = Math.max(240, maxX - minX + 56);
      const contentH = Math.max(180, maxY - minY + 64);

      const scaleX = vw / contentW;
      const scaleY = vh / contentH;
      const isNarrow = vw < 520;
      zoom = Math.max(MIN_ZOOM, Math.min(isNarrow ? 0.92 : 1.05, Math.min(scaleX, scaleY)));

      const centerContentX = (minX + maxX) / 2;
      const centerContentY = (minY + maxY) / 2;
      panX = vw / 2 - centerContentX * zoom;
      panY = Math.max(18 - minY * zoom, vh / 2 - centerContentY * zoom);

      // Kichik ekranlarda tanlangan shaxs koʻrinadigan markazda turishi uchun
      if (isNarrow) {
        const selNode = visibleNodes.find((n) => n.id === selectedPersonId) || visibleNodes[0]!;
        zoom = Math.max(0.68, zoom);
        panX = vw / 2 - (selNode.x + selNode.width / 2) * zoom;
        panY = Math.max(24, vh * 0.36 - (selNode.y + selNode.height / 2) * zoom);
      }

      applyTransform();
    }

    function centerOnPersonNode(personId: string, minScale?: number): void {
      const node = currentDynasty.layout.nodes.find((n) => n.id === personId);
      if (!node) return;
      const rect = panContainer!.getBoundingClientRect();
      const vw = rect.width || 620;
      const vh = rect.height || 520;
      if (minScale && zoom < minScale) {
        zoom = minScale;
      }
      panX = vw / 2 - (node.x + node.width / 2) * zoom;
      panY = vh / 2 - (node.y + node.height / 2) * zoom;
      applyTransform();
    }

    function jumpToGeneration(gen: number): void {
      const { hiddenIds } = computeHiddenNodeIds(currentDynasty);
      const genNodes = currentDynasty.layout.nodes.filter(
        (n) => n.generation === gen && !hiddenIds.has(n.id)
      );
      if (genNodes.length === 0) return;

      const rect = panContainer!.getBoundingClientRect();
      const vw = rect.width || 620;
      const vh = rect.height || 520;

      const minX = Math.min(...genNodes.map((n) => n.x));
      const maxX = Math.max(...genNodes.map((n) => n.x + n.width));
      const centerX = (minX + maxX) / 2;
      const centerY = genNodes[0]!.y + genNodes[0]!.height / 2;

      if (zoom < 0.72) zoom = 0.85;
      panX = vw / 2 - centerX * zoom;
      panY = vh * 0.42 - centerY * zoom;
      applyTransform();

      root!.querySelectorAll<HTMLElement>('.gen-jump-btn').forEach((btn) => {
        btn.classList.toggle('is-active', Number(btn.dataset.genJump) === gen);
      });
    }

    function renderSvgTree(): void {
      panContainer!.id = `dynasty-panel-${currentDynasty.id}`;
      const { hiddenIds, collapsedCounts } = computeHiddenNodeIds(currentDynasty);

      const isAnyFilterActive =
        filterRace !== 'all' ||
        filterEra !== 'all' ||
        filterRelType !== 'all' ||
        filterCanon !== 'all' ||
        searchQuery.length > 0;

      let participatingInRel: Set<string> | null = null;
      if (filterRelType !== 'all') {
        participatingInRel = new Set<string>();
        for (const l of currentDynasty.layout.links) {
          if (hiddenIds.has(l.fromId) || hiddenIds.has(l.toId)) continue;
          const mappedType: RelationshipType =
            l.type === 'marriage'
              ? 'spouse'
              : l.type === 'bridge'
                ? 'lineage-bridge'
                : l.type;
          if (mappedType === filterRelType) {
            participatingInRel.add(l.fromId);
            participatingInRel.add(l.toId);
          }
        }
      }

      // 1. Defs (ClipPaths)
      svgDefs!.innerHTML = '';
      for (const n of currentDynasty.layout.nodes) {
        if (hiddenIds.has(n.id)) continue;
        const cp = svgEl('clipPath', { id: `clip-node-${n.id}` });
        cp.appendChild(svgEl('circle', { cx: 30, cy: 37, r: 20 }));
        svgDefs!.appendChild(cp);
      }

      // 2. Avlod gorizontal tasmalari
      bandsLayer!.innerHTML = '';
      const genY = new Map<number, number>();
      for (const n of currentDynasty.layout.nodes) {
        if (!hiddenIds.has(n.id) && !genY.has(n.generation)) {
          genY.set(n.generation, n.y);
        }
      }
      for (const [gen, y] of Array.from(genY.entries()).sort((a, b) => a[0] - b[0])) {
        const g = svgEl('g', { class: 'svg-gen-band', 'data-gen-band': gen });
        g.appendChild(
          svgEl('line', {
            x1: 12,
            y1: y + 37,
            x2: currentDynasty.layout.dimensions.width - 12,
            y2: y + 37,
            class: 'gen-guide-line',
          })
        );
        const label = svgEl('text', { x: 14, y: y - 10, class: 'gen-band-label' });
        label.textContent = `${ROMANS[gen - 1] || gen} AVLOD`;
        g.appendChild(label);
        bandsLayer!.appendChild(g);
      }

      // 3. Bogʻlovchi chiziqlar (Links)
      linksLayer!.innerHTML = '';
      for (const link of currentDynasty.layout.links) {
        if (hiddenIds.has(link.fromId) || hiddenIds.has(link.toId)) continue;

        const relKind: RelationshipType =
          link.type === 'marriage'
            ? 'spouse'
            : link.type === 'bridge'
              ? 'lineage-bridge'
              : link.type;

        const fromP = people[link.fromId];
        const toP = people[link.toId];
        const endsMatch =
          (!fromP || doesPersonMatchFilters(fromP, participatingInRel)) &&
          (!toP || doesPersonMatchFilters(toP, participatingInRel));

        const relMatches = filterRelType === 'all' || filterRelType === relKind;
        const isDimmed = isAnyFilterActive && (!relMatches || !endsMatch);
        const isHighlighted = filterRelType !== 'all' && filterRelType === relKind && endsMatch;

        const groupCls = [
          'svg-rel-group',
          `rel-${relKind}`,
          link.isUncertain ? 'is-uncertain' : '',
          isDimmed ? 'is-dimmed' : '',
          isHighlighted ? 'is-rel-highlighted' : '',
        ]
          .filter(Boolean)
          .join(' ');

        const g = svgEl('g', {
          class: groupCls,
          'data-rel-type': relKind,
          'data-from': link.fromId,
          'data-to': link.toId,
        });

        if (link.type === 'marriage') {
          g.appendChild(
            svgEl('path', {
              d: link.pathD,
              class: 'svg-link-marriage-halo',
              fill: 'none',
            })
          );
        }

        g.appendChild(
          svgEl('path', {
            d: link.pathD,
            class: `svg-link-path link-${relKind} ${link.isUncertain ? 'link-uncertain' : ''}`.trim(),
            fill: 'none',
          })
        );

        if (link.type !== 'marriage') {
          const startMatch = /^M\s+(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)/.exec(link.pathD);
          if (startMatch) {
            g.appendChild(
              svgEl('circle', {
                cx: Number(startMatch[1]),
                cy: Number(startMatch[2]),
                r: 2.2,
                class: `svg-descent-joint joint-${relKind} ${link.isUncertain ? 'joint-uncertain' : ''}`.trim(),
              })
            );
          }
        }

        if (link.type === 'marriage' && link.pathD.includes(' L ')) {
          const parts = link.pathD.replace('M ', '').split(' L ');
          const c1 = parts[0]?.split(' ').map(Number);
          const c2 = parts[1]?.split(' ').map(Number);
          if (c1 && c2 && c1.length === 2 && c2.length === 2) {
            const mx = Math.round(((c1[0] || 0) + (c2[0] || 0)) / 2);
            const my = c1[1] || 0;
            g.appendChild(
              svgEl('polygon', {
                points: `${mx},${my - 4} ${mx + 4},${my} ${mx},${my + 4} ${mx - 4},${my}`,
                class: 'marriage-union-diamond',
              })
            );
          }
        }

        linksLayer!.appendChild(g);
      }

      // 4. Shaxs tugunlari (Portrait Person Nodes)
      nodesLayer!.innerHTML = '';
      let matchCount = 0;
      let visibleTotal = 0;

      for (const node of currentDynasty.layout.nodes) {
        if (hiddenIds.has(node.id)) continue;
        visibleTotal++;

        const p = people[node.id];
        if (!p) continue;

        const matches = doesPersonMatchFilters(p, participatingInRel);
        if (matches) matchCount++;

        const isSelected = node.id === selectedPersonId;
        const primaryRole = p.titles[0] || p.culture || 'Kanonik shaxs';
        const descCount = collapsedCounts.get(node.id) || 0;
        const isCollapsed = collapsedParents.has(node.id);

        const nodeCls = [
          'tree-person-node',
          isSelected ? 'is-selected' : '',
          node.isUncertain ? 'is-uncertain' : '',
          isAnyFilterActive && !matches ? 'is-dimmed' : '',
        ]
          .filter(Boolean)
          .join(' ');

        const g = svgEl('g', {
          id: `node-${node.id}`,
          class: nodeCls,
          transform: `translate(${node.x}, ${node.y})`,
          'data-person-id': node.id,
          'data-generation': node.generation,
          tabindex: 0,
          role: 'button',
          'aria-label': `${p.name} (${p.dates})`,
        });

        const titleEl = svgEl('title');
        titleEl.textContent = `${p.name} — ${primaryRole} (${p.dates})`;
        g.appendChild(titleEl);

        g.appendChild(
          svgEl('rect', {
            x: 0,
            y: 0,
            width: node.width,
            height: node.height,
            rx: 5,
            class: 'node-card-bg',
          })
        );

        g.appendChild(
          svgEl('rect', {
            x: 2.5,
            y: 2.5,
            width: node.width - 5,
            height: node.height - 5,
            rx: 3.5,
            class: 'node-selected-inner-ring',
          })
        );

        if (p.portrait) {
          const pg = svgEl('g', { class: 'node-portrait-group' });
          pg.appendChild(svgEl('circle', { cx: 30, cy: 37, r: 20.5, class: 'node-portrait-backdrop' }));
          const img = svgEl('image', {
            href: p.portrait.thumb,
            x: 10,
            y: 17,
            width: 40,
            height: 40,
            preserveAspectRatio: 'xMidYMid slice',
            'clip-path': `url(#clip-node-${node.id})`,
          });
          pg.appendChild(img);
          pg.appendChild(svgEl('circle', { cx: 30, cy: 37, r: 20.5, class: 'node-portrait-ring' }));
          g.appendChild(pg);
        } else {
          const mg = svgEl('g', { class: 'node-monogram-group' });
          mg.appendChild(svgEl('circle', { cx: 30, cy: 37, r: 20, class: 'node-monogram-circle' }));
          const mt = svgEl('text', {
            x: 30,
            y: 41.5,
            'text-anchor': 'middle',
            class: 'node-monogram-label',
          });
          mt.textContent = initialsOf(p.name);
          mg.appendChild(mt);
          g.appendChild(mg);
        }

        const nameText = svgEl('text', { x: 58, y: 27, class: 'node-name-text' });
        nameText.textContent = truncate(p.name, 17);
        g.appendChild(nameText);

        const roleText = svgEl('text', { x: 58, y: 43, class: 'node-role-text' });
        roleText.textContent = truncate(primaryRole, 22);
        g.appendChild(roleText);

        const datesText = svgEl('text', { x: 58, y: 58, class: 'node-dates-text' });
        datesText.textContent = truncate(p.dates, 23);
        g.appendChild(datesText);

        if (node.isUncertain) {
          const ub = svgEl('g', {
            transform: `translate(${node.width - 20}, 6)`,
            class: 'node-uncertain-badge',
          });
          ub.appendChild(svgEl('rect', { x: 0, y: 0, width: 14, height: 14, rx: 7, class: 'uncertain-pill-bg' }));
          const ut = svgEl('text', { x: 7, y: 10.5, 'text-anchor': 'middle', class: 'uncertain-pill-mark' });
          ut.textContent = '?';
          ub.appendChild(ut);
          g.appendChild(ub);
        }

        if (node.bridgeNote) {
          const bt = svgEl('g', { transform: 'translate(8, -11)', class: 'node-bridge-tag' });
          const tagW = Math.min(node.width - 16, Math.max(76, node.bridgeNote.length * 5.6 + 12));
          bt.appendChild(svgEl('rect', { x: 0, y: 0, width: tagW, height: 15, rx: 3, class: 'bridge-tag-bg' }));
          const btxt = svgEl('text', { x: 6, y: 10.5, class: 'bridge-tag-text' });
          btxt.textContent = truncate(node.bridgeNote, 25);
          bt.appendChild(btxt);
          g.appendChild(bt);
        }

        nodesLayer!.appendChild(g);

        if (descCount > 0) {
          const cg = svgEl('g', {
            class: `node-collapse-toggle ${isAnyFilterActive && !matches ? 'is-dimmed' : ''}`.trim(),
            'data-collapse-id': node.id,
            transform: `translate(${node.x + node.width / 2}, ${node.y + node.height})`,
            role: 'button',
            tabindex: 0,
            'aria-expanded': isCollapsed ? 'false' : 'true',
            'aria-label': `${p.name} farzandlari shoxini ${isCollapsed ? 'yoyish' : 'yigʻish'}`,
          });
          cg.appendChild(svgEl('rect', { x: -15, y: -8, width: 30, height: 16, rx: 8, class: 'collapse-pill-bg' }));
          const ct = svgEl('text', { x: 0, y: 3.5, 'text-anchor': 'middle', class: 'collapse-pill-text' });
          ct.textContent = isCollapsed ? `+${descCount}` : '−';
          cg.appendChild(ct);
          nodesLayer!.appendChild(cg);
        }
      }

      // Filtr xulosasi va Tozalash tugmasi
      const filterSummaryEl = document.getElementById('filter-active-summary');
      const resetFiltersBtn = document.getElementById('btn-reset-filters');
      if (filterSummaryEl) {
        if (isAnyFilterActive) {
          filterSummaryEl.hidden = false;
          filterSummaryEl.textContent = `${visibleTotal} shaxsdan ${matchCount} tasi filtrga mos keldi`;
        } else {
          filterSummaryEl.hidden = true;
        }
      }
      if (resetFiltersBtn) {
        resetFiltersBtn.hidden = !isAnyFilterActive;
      }
    }

    function updateDynastyHeaderAndSidebar(): void {
      // Tab holati
      root!.querySelectorAll<HTMLElement>('.dynasty-tab-btn').forEach((btn) => {
        const active = btn.dataset.dynastyId === currentDynasty.id;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      const houseSelect = document.getElementById('filter-house') as HTMLSelectElement | null;
      if (houseSelect && houseSelect.value !== currentDynasty.id) {
        houseSelect.value = currentDynasty.id;
      }

      // Header matnlari
      const houseKicker = document.getElementById('dynasty-house-name');
      const eraLabel = document.getElementById('dynasty-era-label');
      const permalink = document.getElementById('dynasty-permalink') as HTMLAnchorElement | null;
      const titleEl = document.getElementById('dynasty-header-title');
      const summaryEl = document.getElementById('dynasty-header-summary');
      const founderBtn = document.getElementById('dynasty-founder-btn');
      const metricsEl = document.getElementById('dynasty-lineage-metrics');
      const branchesSummaryEl = document.getElementById('dynasty-branches-summary');
      const relevantWrap = document.getElementById('dynasty-relevant-people');
      const returnRootBtn = document.getElementById('btn-return-root');

      if (houseKicker) houseKicker.textContent = currentDynasty.houseName;
      if (eraLabel) eraLabel.textContent = currentDynasty.era;
      if (permalink) permalink.href = `/nasabnomalar/${currentDynasty.id}/`;
      if (titleEl) titleEl.textContent = currentDynasty.title;
      if (summaryEl) summaryEl.textContent = currentDynasty.summary;

      if (founderBtn) {
        founderBtn.dataset.personId = currentDynasty.founderId;
        founderBtn.textContent = people[currentDynasty.founderId]?.name || currentDynasty.founderId;
      }
      if (returnRootBtn) {
        returnRootBtn.dataset.founderId = currentDynasty.founderId;
      }

      const maxGen = Math.max(...currentDynasty.layout.nodes.map((n) => n.generation), 1);
      if (metricsEl) {
        metricsEl.textContent = `${maxGen} avlod · ${currentDynasty.layout.nodes.length} shaxs`;
      }
      if (branchesSummaryEl) {
        branchesSummaryEl.textContent = `${currentDynasty.branches.length} ta asosiy tarmoq`;
      }

      if (relevantWrap) {
        relevantWrap.innerHTML = currentDynasty.relevantPeopleIds
          .map((pid) => {
            const p = people[pid];
            if (!p) return '';
            const isSel = pid === selectedPersonId;
            const avatar = p.portrait
              ? `<img src="${escapeHtml(p.portrait.thumb)}" alt="" width="22" height="22" class="chip-avatar" loading="lazy" />`
              : `<span class="chip-monogram" aria-hidden="true">${escapeHtml(initialsOf(p.name))}</span>`;
            return `<button type="button" class="relevant-person-chip ${isSel ? 'is-selected' : ''}" data-person-id="${escapeHtml(p.id)}">${avatar}<span class="chip-name">${escapeHtml(p.name)}</span></button>`;
          })
          .join('');
      }

      // Avlod navigatsiyasi
      const genNav = document.getElementById('sidebar-generation-nav');
      if (genNav) {
        const counts = new Map<number, number>();
        for (const n of currentDynasty.layout.nodes) {
          counts.set(n.generation, (counts.get(n.generation) || 0) + 1);
        }
        genNav.innerHTML = Array.from(counts.keys())
          .sort((a, b) => a - b)
          .map(
            (g) =>
              `<button type="button" class="gen-jump-btn" data-gen-jump="${g}"><span class="gen-roman">${ROMANS[g - 1] || g}</span><span class="gen-text">${g}-avlod</span><span class="gen-badge-num">${counts.get(g) || 0}</span></button>`
          )
          .join('');
      }

      // Tarmoqlar (Branches) checkboxlari
      const branchBox = document.getElementById('sidebar-branch-controls');
      if (branchBox) {
        branchBox.innerHTML = currentDynasty.branches
          .map(
            (b) =>
              `<label class="branch-check-item"><input type="checkbox" class="branch-visibility-checkbox" data-branch-id="${escapeHtml(b.id)}" ${hiddenBranches.has(b.id) ? '' : 'checked'} /><span class="branch-check-text">${escapeHtml(b.label)}</span><span class="branch-check-count">${b.memberIds.length}</span></label>`
          )
          .join('');
      }

      // Accessible Roʻyxat koʻrinishini yangilash
      if (accessibleWrap) {
        const byGen = new Map<number, CompactNode[]>();
        for (const n of currentDynasty.layout.nodes) {
          const list = byGen.get(n.generation) || [];
          list.push(n);
          byGen.set(n.generation, list);
        }
        const gensHtml = Array.from(byGen.keys())
          .sort((a, b) => a - b)
          .map((gen) => {
            const items = (byGen.get(gen) || [])
              .map((n) => {
                const p = people[n.id];
                if (!p) return '';
                return `<li class="member-entry" data-person-id="${escapeHtml(p.id)}"><div class="member-card"><div class="member-main"><div class="member-heading-row"><h4 class="member-name">${escapeHtml(p.name)}</h4>${n.isUncertain ? '<span class="uncertainty-tag">[Ziddiyatli]</span>' : ''}</div>${p.titles.length ? `<p class="member-title-text">${escapeHtml(p.titles.join(' • '))}</p>` : ''}<div class="member-details-row"><span class="member-dates">${escapeHtml(p.dates)}</span><span class="member-culture">· ${escapeHtml(p.culture)}</span>${n.bridgeNote ? `<span class="member-bridge">· ${escapeHtml(n.bridgeNote)}</span>` : ''}</div></div><div class="member-action-row"><button type="button" class="btn-view-in-tree" data-person-id="${escapeHtml(p.id)}" data-target-dynasty="${escapeHtml(currentDynasty.id)}"><span>Daraxtda koʻrish</span></button></div></div></li>`;
              })
              .join('');
            return `<details class="gen-collapsible" open><summary class="gen-summary"><span class="gen-badge"><span class="gen-num-roman">${ROMANS[gen - 1] || gen}</span><span class="gen-title">${gen}-Avlod</span></span><span class="gen-count">${(byGen.get(gen) || []).length} ta aʼzo</span></summary><ul class="members-sublist">${items}</ul></details>`;
          })
          .join('');

        accessibleWrap.innerHTML = `<div class="accessible-genealogy-container" aria-label="${escapeHtml(currentDynasty.title)} matnli shajarasi"><div class="accessible-tree-header"><h3 class="accessible-dynasty-title">${escapeHtml(currentDynasty.houseName)}</h3><p class="accessible-hint">Avlodlar pogʻonasi boʻyicha saralangan shajara roʻyxati.</p></div><div class="generation-collapsible-list">${gensHtml}</div></div>`;
      }

      // Manbalar va kanon seksiyasini yangilash
      updateSourcesSection();
    }

    function updateSourcesSection(): void {
      const primaryList = document.getElementById('sources-primary-list');
      if (primaryList) {
        primaryList.innerHTML = currentDynasty.sources
          .map((src) => {
            const bookPart = src.href
              ? `<a href="${escapeHtml(src.href)}" class="source-book-link"><em>${escapeHtml(src.bookTitle)}</em></a>`
              : `<em>${escapeHtml(src.bookTitle)}</em>`;
            return `<li class="source-ref-item"><div class="source-cite-line"><span class="source-author">${escapeHtml(src.author)}</span>${src.year ? `<span class="source-year">(${src.year}).</span>` : ''} ${bookPart}<span class="source-chapter"> — «${escapeHtml(src.chapter)}»</span>${src.page ? `<span class="source-page">, ${escapeHtml(src.page)}-bet.</span>` : ''}</div>${src.notes ? `<p class="source-hist-note">${escapeHtml(src.notes)}</p>` : ''}</li>`;
          })
          .join('');
      }

      const mConfirmed = document.getElementById('metric-confirmed-count');
      const mVariant = document.getElementById('metric-variant-count');
      const mUncertain = document.getElementById('metric-uncertain-count');
      if (mConfirmed) mConfirmed.textContent = String(currentDynasty.canonStats.confirmedCount);
      if (mVariant) mVariant.textContent = String(currentDynasty.canonStats.variantCount);
      if (mUncertain) {
        mUncertain.textContent = String(
          currentDynasty.canonStats.uncertainCount + currentDynasty.canonStats.bridgeCount
        );
      }

      const disputedList = document.getElementById('sources-disputed-list');
      if (disputedList) {
        const items: string[] = [];
        for (const node of currentDynasty.layout.nodes) {
          const p = people[node.id];
          if (!p) continue;
          const hasDispute = node.isUncertain || p.canonStatus !== 'canon' || Boolean(p.uncertaintyNotes);
          const hasBridge = Boolean(node.bridgeNote);
          if (!hasDispute && !hasBridge) continue;

          const kind =
            node.isUncertain || p.canonStatus === 'uncertain'
              ? 'uncertain'
              : p.canonStatus === 'variant' || p.uncertaintyNotes
                ? 'variant'
                : 'bridge';

          const label =
            kind === 'uncertain'
              ? 'Munozarali (Uncertain)'
              : kind === 'variant'
                ? 'Qoʻlyozma varianti (Variant)'
                : 'Qisqartirilgan zanjir (Koʻprik)';

          const note =
            p.uncertaintyNotes ||
            (node.bridgeNote
              ? `Shajara jadvalida ixchamlik uchun oraliq avlod (${node.bridgeNote}) koʻprik chizigʻi bilan ifodalangan.`
              : '');

          items.push(
            `<li class="audit-entry audit-${kind}"><div class="audit-entry-top"><button type="button" class="audit-person-btn" data-person-id="${escapeHtml(p.id)}">${escapeHtml(p.name)}</button><span class="audit-status-tag tag-${kind}">${label}</span></div><p class="audit-explanation">${escapeHtml(note)}</p><span class="audit-cite">${escapeHtml(p.citation.work)}, ${escapeHtml(p.citation.section)}</span></li>`
          );
        }

        disputedList.innerHTML =
          items.length > 0
            ? items.join('')
            : `<li class="audit-empty-item">Ushbu suloladagi barcha koʻrsatilgan rishtalar birlamchi matnlarda toʻgʻridan-toʻgʻri tasdiqlangan.</li>`;
      }
    }

    function updateLineageBreadcrumbs(): void {
      const trail = document.getElementById('breadcrumb-trail');
      if (!trail) return;

      const chain: string[] = [];
      const seen = new Set<string>();
      let curr: string | undefined = selectedPersonId;
      while (curr && !seen.has(curr)) {
        seen.add(curr);
        chain.unshift(curr);
        const node = currentDynasty.layout.nodes.find((n) => n.id === curr);
        const parentInTree = node?.parentIds.find((pid) =>
          currentDynasty.layout.nodes.some((n) => n.id === pid)
        );
        if (parentInTree) {
          curr = parentInTree;
        } else {
          const bridgeLink = currentDynasty.layout.links.find(
            (l) => l.type === 'bridge' && l.toId === curr
          );
          curr = bridgeLink?.fromId;
        }
      }

      trail.innerHTML = chain
        .map((pid, idx) => {
          const p = people[pid];
          if (!p) return '';
          const sep = idx > 0 ? '<span class="crumb-sep" aria-hidden="true">›</span>' : '';
          const active = idx === chain.length - 1 ? 'is-active' : '';
          return `${sep}<button type="button" class="crumb-person-btn ${active}" data-person-id="${escapeHtml(pid)}">${escapeHtml(p.name)}</button>`;
        })
        .join('');
    }

    function updateProfilePanel(personId: string): void {
      const p = people[personId];
      if (!p) return;

      const portraitBox = document.getElementById('profile-portrait-box');
      if (portraitBox) {
        portraitBox.innerHTML = p.portrait
          ? `<img src="${escapeHtml(p.portrait.thumb)}" alt="${escapeHtml(p.portrait.alt)}" width="76" height="96" class="profile-portrait-img" loading="lazy" />`
          : `<div class="profile-monogram-crest" aria-hidden="true"><span>${escapeHtml(initialsOf(p.name))}</span></div>`;
      }

      const canonBadge = document.getElementById('profile-canon-badge');
      if (canonBadge) {
        const badgeMap = {
          canon: ['Kanon', 'status-canon'],
          variant: ['Variant', 'status-variant'],
          uncertain: ['Munozarali', 'status-uncertain'],
        } as const;
        const [lbl, cls] = badgeMap[p.canonStatus];
        canonBadge.textContent = lbl;
        canonBadge.className = `canon-pill ${cls}`;
      }

      const houseTag = document.getElementById('profile-house-tag');
      if (houseTag) houseTag.textContent = p.houseLabel;

      const nameEl = document.getElementById('profile-person-name');
      if (nameEl) nameEl.textContent = p.name;

      const origEl = document.getElementById('profile-orig-name');
      if (origEl) {
        if (p.originalName) {
          origEl.hidden = false;
          origEl.textContent = p.originalName;
        } else {
          origEl.hidden = true;
          origEl.textContent = '';
        }
      }

      const titlesWrap = document.getElementById('profile-titles-wrap');
      if (titlesWrap) {
        if (p.titles.length === 0 && p.aliases.length === 0) {
          titlesWrap.hidden = true;
          titlesWrap.innerHTML = '';
        } else {
          titlesWrap.hidden = false;
          titlesWrap.innerHTML = `${
            p.titles.length
              ? `<p class="profile-titles-line">${escapeHtml(p.titles.join(' · '))}</p>`
              : ''
          }${
            p.aliases.length
              ? `<p class="profile-aliases-line"><span class="meta-inline-label">Nomlari:</span> ${escapeHtml(p.aliases.join(', '))}</p>`
              : ''
          }`;
        }
      }

      const datesEl = document.getElementById('profile-dates');
      const raceEl = document.getElementById('profile-race-culture');
      const houseFullEl = document.getElementById('profile-house-full');
      const bioEl = document.getElementById('profile-bio-text');
      if (datesEl) datesEl.textContent = p.dates;
      if (raceEl) raceEl.textContent = `${p.raceLabel} · ${p.culture}`;
      if (houseFullEl) houseFullEl.textContent = p.houseLabel;
      if (bioEl) bioEl.textContent = p.summary;

      const uncBox = document.getElementById('profile-uncertainty-box');
      const uncText = document.getElementById('profile-uncertainty-text');
      if (uncBox && uncText) {
        if (p.uncertaintyNotes) {
          uncBox.hidden = false;
          uncText.textContent = p.uncertaintyNotes;
        } else {
          uncBox.hidden = true;
          uncText.textContent = '';
        }
      }

      const evSection = document.getElementById('profile-events-section');
      const evList = document.getElementById('profile-events-list');
      if (evSection && evList) {
        if (p.events.length > 0) {
          evSection.hidden = false;
          evList.innerHTML = p.events
            .map(
              (ev) =>
                `<li><a href="${escapeHtml(ev.href)}" class="profile-event-link"><span class="event-link-title">${escapeHtml(ev.title)}</span><span class="event-link-year">${escapeHtml(ev.yearText)}</span></a></li>`
            )
            .join('');
        } else {
          evSection.hidden = true;
          evList.innerHTML = '';
        }
      }

      const kinGroups = document.getElementById('profile-kin-groups');
      if (kinGroups) {
        const groups = [
          { key: 'parents', label: 'Ota-onasi', items: p.parents },
          { key: 'spouses', label: 'Turmush oʻrtogʻi', items: p.spouses },
          { key: 'siblings', label: 'Aka-uka va opa-singillari', items: p.siblings },
          { key: 'children', label: 'Farzandlari', items: p.children },
        ];
        kinGroups.innerHTML = groups
          .map((g) => {
            const chips =
              g.items.length === 0
                ? '<span class="kin-empty-text">Qayd etilmagan</span>'
                : g.items
                    .map((rel) => {
                      if (rel.inAnyTree) {
                        return `<button type="button" class="kin-chip-btn ${rel.isUncertain ? 'is-uncertain' : ''}" data-person-id="${escapeHtml(rel.id)}" data-target-dynasty="${escapeHtml(rel.dynastyId || '')}"><span>${escapeHtml(rel.name)}</span>${rel.isUncertain ? '<span class="kin-uncertain-mark">?</span>' : ''}</button>`;
                      }
                      if (rel.detailHref) {
                        return `<a href="${escapeHtml(rel.detailHref)}" class="kin-chip-link">${escapeHtml(rel.name)} ↗</a>`;
                      }
                      return `<span class="kin-chip-static">${escapeHtml(rel.name)}</span>`;
                    })
                    .join('');
            return `<div class="kin-group-row" data-kin-group="${g.key}"><span class="kin-group-label">${g.label}</span><div class="kin-chips-wrap">${chips}</div></div>`;
          })
          .join('');
      }

      const citeBox = document.getElementById('profile-citation-box');
      if (citeBox) {
        const workHtml = p.citation.href
          ? `<a href="${escapeHtml(p.citation.href)}" class="citation-work-link"><em>${escapeHtml(p.citation.work)}</em></a>`
          : `<em>${escapeHtml(p.citation.work)}</em>`;
        citeBox.innerHTML = `<span class="citation-label">Birlamchi manba:</span> ${workHtml}<span>, ${escapeHtml(p.citation.section)}</span>`;
      }

      const ctaWrap = document.getElementById('profile-cta-wrap');
      if (ctaWrap) {
        ctaWrap.innerHTML = p.detailHref
          ? `<a href="${escapeHtml(p.detailHref)}" class="profile-detail-cta" id="profile-character-link"><span>Qahramon sahifasiga oʻtish</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>`
          : `<span class="profile-no-article-note" id="profile-no-article">Ushbu shaxs boʻyicha kanonik maʼlumot nasabnoma registrida jamlangan.</span>`;
      }

      // Header tezkor shaxslar roʻyxatida ham tanlanganlikni yangilash
      root!.querySelectorAll<HTMLElement>('.relevant-person-chip').forEach((chip) => {
        chip.classList.toggle('is-selected', chip.dataset.personId === personId);
      });
    }

    function openDrawer(side: 'left' | 'right'): void {
      if (window.innerWidth >= 1120) return;
      if (side === 'left') {
        rightPanel?.classList.remove('is-drawer-open');
        btnOpenRight?.setAttribute('aria-expanded', 'false');
        leftSidebar?.classList.add('is-drawer-open');
        btnOpenLeft?.setAttribute('aria-expanded', 'true');
      } else {
        leftSidebar?.classList.remove('is-drawer-open');
        btnOpenLeft?.setAttribute('aria-expanded', 'false');
        rightPanel?.classList.add('is-drawer-open');
        btnOpenRight?.setAttribute('aria-expanded', 'true');
      }
      if (backdrop) backdrop.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeDrawers(): void {
      const wasLeftOpen = leftSidebar?.classList.contains('is-drawer-open');
      const wasRightOpen = rightPanel?.classList.contains('is-drawer-open');
      leftSidebar?.classList.remove('is-drawer-open');
      rightPanel?.classList.remove('is-drawer-open');
      btnOpenLeft?.setAttribute('aria-expanded', 'false');
      btnOpenRight?.setAttribute('aria-expanded', 'false');
      if (backdrop) backdrop.hidden = true;
      document.body.style.overflow = '';
      if (wasLeftOpen) btnOpenLeft?.focus();
      else if (wasRightOpen) btnOpenRight?.focus();
    }

    function switchDynasty(dynastyId: string, targetPersonId?: string): void {
      const nextDynasty = dynastyMap.get(dynastyId);
      if (!nextDynasty) {
        if (!fullDataLoaded) {
          void ensureFullDataset().then(() => {
            if (dynastyMap.has(dynastyId)) {
              switchDynasty(dynastyId, targetPersonId);
            }
          });
        }
        return;
      }

      activeDynastyId = dynastyId;
      currentDynasty = nextDynasty;
      root!.dataset.activeDynasty = dynastyId;

      hiddenBranches.clear();
      collapsedParents.clear();

      selectedPersonId =
        targetPersonId && nextDynasty.layout.nodes.some((n) => n.id === targetPersonId)
          ? targetPersonId
          : nextDynasty.featuredId;

      root!.dataset.selectedPerson = selectedPersonId;

      updateDynastyHeaderAndSidebar();
      renderSvgTree();
      updateLineageBreadcrumbs();
      updateProfilePanel(selectedPersonId);
      fitTreeToViewport();
      syncUrl();
    }

    function selectPerson(
      personId: string,
      options: { panToNode?: boolean; openMobileSheet?: boolean; targetDynastyId?: string } = {}
    ): void {
      const p = people[personId];
      if (!p) {
        if (!fullDataLoaded) {
          void ensureFullDataset().then(() => {
            if (people[personId]) {
              selectPerson(personId, options);
            }
          });
        }
        return;
      }

      const candidateDynasty =
        options.targetDynastyId ||
        (!currentDynasty.layout.nodes.some((n) => n.id === personId) && p.dynastyIds[0]
          ? p.dynastyIds[0]
          : activeDynastyId);

      if (candidateDynasty !== activeDynastyId && !dynastyMap.has(candidateDynasty)) {
        if (!fullDataLoaded) {
          void ensureFullDataset().then(() => {
            if (dynastyMap.has(candidateDynasty)) {
              selectPerson(personId, options);
            }
          });
        }
        return;
      }

      const desiredDynasty = dynastyMap.has(candidateDynasty) ? candidateDynasty : activeDynastyId;

      if (desiredDynasty !== activeDynastyId) {
        switchDynasty(desiredDynasty, personId);
        if (options.panToNode) centerOnPersonNode(personId, 0.85);
        if (options.openMobileSheet) openDrawer('right');
        return;
      }

      // Agar u yigʻilgan ota-ona ichida qolgan boʻlsa, shoxni ochamiz
      const { hiddenIds } = computeHiddenNodeIds(currentDynasty);
      if (hiddenIds.has(personId)) {
        collapsedParents.clear();
        hiddenBranches.clear();
        renderSvgTree();
      }

      selectedPersonId = personId;
      root!.dataset.selectedPerson = personId;

      root!.querySelectorAll<SVGGElement>('.tree-person-node').forEach((el) => {
        el.classList.toggle('is-selected', el.dataset.personId === personId);
      });

      updateLineageBreadcrumbs();
      updateProfilePanel(personId);
      if (options.panToNode) {
        centerOnPersonNode(personId);
      }
      if (options.openMobileSheet && window.innerWidth < 1120) {
        openDrawer('right');
      }
      syncUrl();
    }

    function setViewMode(mode: 'tree' | 'list'): void {
      viewMode = mode;
      const btnTree = document.getElementById('btn-mode-tree');
      const btnList = document.getElementById('btn-mode-list');
      btnTree?.classList.toggle('active', mode === 'tree');
      btnTree?.setAttribute('aria-pressed', mode === 'tree' ? 'true' : 'false');
      btnList?.classList.toggle('active', mode === 'list');
      btnList?.setAttribute('aria-pressed', mode === 'list' ? 'true' : 'false');

      if (svgViewportWrap) svgViewportWrap.hidden = mode !== 'tree';
      if (accessibleWrap) accessibleWrap.hidden = mode !== 'list';

      if (mode === 'tree') {
        requestAnimationFrame(() => fitTreeToViewport());
      }
      syncUrl();
    }

    // ======================================================================
    // INTERAKTIV HODISALAR (Delegated Clicks, Search, Filters, Pan & Zoom)
    // ======================================================================
    root.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      if (!target) return;

      // 1. Shoxni yigʻish / yoyish tugmasi
      const collapseToggle = target.closest('[data-collapse-id]');
      if (collapseToggle) {
        e.stopPropagation();
        const pid = collapseToggle.getAttribute('data-collapse-id');
        if (pid) {
          if (collapsedParents.has(pid)) collapsedParents.delete(pid);
          else collapsedParents.add(pid);
          renderSvgTree();
        }
        return;
      }

      // 2. SVG person node bosilishi
      const svgNode = target.closest('.tree-person-node');
      if (svgNode) {
        const pid = svgNode.getAttribute('data-person-id');
        if (pid) {
          selectPerson(pid, { openMobileSheet: true });
        }
        return;
      }

      // 3. Sulola tabini bosish
      const tabBtn = target.closest<HTMLElement>('.dynasty-tab-btn');
      if (tabBtn?.dataset.dynastyId) {
        switchDynasty(tabBtn.dataset.dynastyId);
        return;
      }

      // 4. Roʻyxat rejimidan "Daraxtda koʻrish"
      const viewInTreeBtn = target.closest<HTMLElement>('.btn-view-in-tree');
      if (viewInTreeBtn?.dataset.personId) {
        setViewMode('tree');
        selectPerson(viewInTreeBtn.dataset.personId, {
          panToNode: true,
          targetDynastyId: viewInTreeBtn.dataset.targetDynasty,
        });
        return;
      }

      // 5. Shaxs tugmalari (Relevant chips, Breadcrumbs, Kinship chips, Sources audit, Search results)
      const personTrigger = target.closest<HTMLElement>('[data-person-id]');
      if (personTrigger?.dataset.personId && !personTrigger.classList.contains('member-entry')) {
        const pid = personTrigger.dataset.personId;
        const tDyn = personTrigger.dataset.targetDynasty;
        const fromLeftDrawer = Boolean(personTrigger.closest('#genealogy-left-sidebar'));
        if (fromLeftDrawer && window.innerWidth < 1120) {
          closeDrawers();
        }
        selectPerson(pid, {
          panToNode: true,
          targetDynastyId: tDyn || undefined,
        });
        return;
      }

      // 6. Avlodga sakrash tugmasi
      const genBtn = target.closest<HTMLElement>('[data-gen-jump]');
      if (genBtn?.dataset.genJump) {
        if (window.innerWidth < 1120) closeDrawers();
        if (viewMode !== 'tree') setViewMode('tree');
        jumpToGeneration(Number(genBtn.dataset.genJump));
        return;
      }

      // 7. Kanon maqomi filtri
      const canonBtn = target.closest<HTMLElement>('[data-canon-filter]');
      if (canonBtn?.dataset.canonFilter) {
        filterCanon = canonBtn.dataset.canonFilter as CanonStatus | 'all';
        root.querySelectorAll<HTMLElement>('[data-canon-filter]').forEach((b) => {
          const isAct = b === canonBtn;
          b.classList.toggle('is-active', isAct);
          b.setAttribute('aria-pressed', isAct ? 'true' : 'false');
        });
        renderSvgTree();
      }
    });

    // Klaviatura orqali boshqaruv (SVG tugunlar va Escape)
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (
          leftSidebar?.classList.contains('is-drawer-open') ||
          rightPanel?.classList.contains('is-drawer-open')
        ) {
          e.preventDefault();
          closeDrawers();
        }
        return;
      }

      const target = e.target as Element | null;
      if (!target) return;

      const collapseEl = target.closest('[data-collapse-id]');
      if (collapseEl && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        e.stopPropagation();
        const pid = collapseEl.getAttribute('data-collapse-id');
        if (pid) {
          if (collapsedParents.has(pid)) collapsedParents.delete(pid);
          else collapsedParents.add(pid);
          renderSvgTree();
        }
        return;
      }

      const nodeEl = target.closest('.tree-person-node');
      if (!nodeEl) return;
      const pid = nodeEl.getAttribute('data-person-id');
      if (!pid) return;

      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        selectPerson(pid, { openMobileSheet: true });
        return;
      }

      const currentNode = currentDynasty.layout.nodes.find((n) => n.id === pid);
      if (!currentNode) return;
      const { hiddenIds } = computeHiddenNodeIds(currentDynasty);
      const visible = currentDynasty.layout.nodes.filter((n) => !hiddenIds.has(n.id));

      let nextTargetId: string | undefined;
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        const row = visible
          .filter((n) => n.generation === currentNode.generation)
          .sort((a, b) => a.x - b.x);
        const idx = row.findIndex((n) => n.id === pid);
        const nextIdx = e.key === 'ArrowRight' ? idx + 1 : idx - 1;
        nextTargetId = row[nextIdx]?.id;
      } else if (e.key === 'ArrowUp') {
        nextTargetId = currentNode.parentIds.find((pId) => visible.some((n) => n.id === pId));
      } else if (e.key === 'ArrowDown') {
        nextTargetId = visible.find((n) => n.parentIds.includes(pid))?.id;
      }

      if (nextTargetId) {
        e.preventDefault();
        selectPerson(nextTargetId, { panToNode: true });
        const nextDom = document.getElementById(`node-${nextTargetId}`) as HTMLElement | null;
        nextDom?.focus();
      }
    });

    // Qidiruv maydoni
    const searchInput = document.getElementById('genealogy-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('btn-clear-search');
    const searchStatus = document.getElementById('search-live-status');
    const searchResultsList = document.getElementById('sidebar-search-results');

    function handleSearchUpdate(rawVal: string): void {
      searchQuery = rawVal.trim();
      if (clearSearchBtn) clearSearchBtn.hidden = searchQuery.length === 0;

      if (!searchQuery) {
        if (searchStatus) searchStatus.textContent = '';
        if (searchResultsList) {
          searchResultsList.hidden = true;
          searchResultsList.innerHTML = '';
        }
        renderSvgTree();
        return;
      }

      if (!fullDataLoaded) {
        void ensureFullDataset().then(() => {
          if (searchInput && searchInput.value.trim() === searchQuery) {
            handleSearchUpdate(searchInput.value);
          }
        });
      }

      const q = searchQuery.toLowerCase();
      const matches = Object.values(people).filter((p) => {
        const hay = [
          p.name,
          p.originalName || '',
          ...p.aliases,
          ...p.titles,
          p.culture,
        ]
          .join(' ')
          .toLowerCase();
        return hay.includes(q);
      });

      if (searchStatus) {
        searchStatus.textContent =
          matches.length > 0
            ? `${matches.length} ta shaxs topildi (${matches[0]!.name})`
            : 'Hech bir shaxs topilmadi';
      }

      if (searchResultsList) {
        if (matches.length > 0) {
          searchResultsList.hidden = false;
          searchResultsList.innerHTML = matches
            .slice(0, 8)
            .map(
              (m) =>
                `<li><button type="button" class="search-result-btn" data-person-id="${escapeHtml(m.id)}" data-target-dynasty="${escapeHtml(m.dynastyIds[0] || '')}"><span>${escapeHtml(m.name)}</span><span class="search-result-house">${escapeHtml(m.houseLabel)}</span></button></li>`
            )
            .join('');
        } else {
          searchResultsList.hidden = true;
          searchResultsList.innerHTML = '';
        }
      }

      renderSvgTree();
    }

    searchInput?.addEventListener('input', () => handleSearchUpdate(searchInput.value));
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const firstBtn = searchResultsList?.querySelector<HTMLElement>('.search-result-btn');
        if (firstBtn?.dataset.personId) {
          const targetId = firstBtn.dataset.personId;
          const targetDyn = firstBtn.dataset.targetDynasty;
          searchQuery = '';
          if (searchInput) searchInput.value = '';
          if (clearSearchBtn) clearSearchBtn.hidden = true;
          if (searchResultsList) searchResultsList.hidden = true;
          if (window.innerWidth < 1120) closeDrawers();
          selectPerson(targetId, { panToNode: true, targetDynastyId: targetDyn });
          if (searchStatus) {
            searchStatus.textContent = `${people[targetId]?.name || targetId} tanlandi`;
          }
        }
      }
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      handleSearchUpdate('');
      searchInput?.focus();
    });

    // Select filtrlari va tarmoq checkboxlari
    root.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement | HTMLSelectElement | null;
      if (!target) return;

      if (target.id === 'filter-house') {
        switchDynasty(target.value);
      } else if (target.id === 'filter-race') {
        filterRace = target.value;
        renderSvgTree();
      } else if (target.id === 'filter-era') {
        filterEra = target.value as EraFilterKey | 'all';
        renderSvgTree();
      } else if (target.id === 'filter-relation-type') {
        filterRelType = target.value as RelationshipType | 'all';
        renderSvgTree();
      } else if (target.classList.contains('branch-visibility-checkbox')) {
        const bId = target.dataset.branchId;
        if (bId) {
          if ((target as HTMLInputElement).checked) hiddenBranches.delete(bId);
          else hiddenBranches.add(bId);
          renderSvgTree();
        }
      }
    });

    // Filtrlarni tozalash
    document.getElementById('btn-reset-filters')?.addEventListener('click', () => {
      filterRace = 'all';
      filterEra = 'all';
      filterRelType = 'all';
      filterCanon = 'all';
      searchQuery = '';
      const rSel = document.getElementById('filter-race') as HTMLSelectElement | null;
      const eSel = document.getElementById('filter-era') as HTMLSelectElement | null;
      const relSel = document.getElementById('filter-relation-type') as HTMLSelectElement | null;
      if (rSel) rSel.value = 'all';
      if (eSel) eSel.value = 'all';
      if (relSel) relSel.value = 'all';
      if (searchInput) searchInput.value = '';
      if (clearSearchBtn) clearSearchBtn.hidden = true;
      if (searchResultsList) searchResultsList.hidden = true;
      if (searchStatus) searchStatus.textContent = '';

      root.querySelectorAll<HTMLElement>('[data-canon-filter]').forEach((b) => {
        const isAll = b.dataset.canonFilter === 'all';
        b.classList.toggle('is-active', isAll);
        b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
      });

      renderSvgTree();
    });

    // Shoxlarni yoyish / yigʻish tugmalari
    document.getElementById('btn-expand-all-branches')?.addEventListener('click', () => {
      collapsedParents.clear();
      hiddenBranches.clear();
      root.querySelectorAll<HTMLInputElement>('.branch-visibility-checkbox').forEach((cb) => {
        cb.checked = true;
      });
      renderSvgTree();
      fitTreeToViewport();
    });

    document.getElementById('btn-collapse-all-branches')?.addEventListener('click', () => {
      for (const n of currentDynasty.layout.nodes) {
        if (n.generation >= 2) {
          collapsedParents.add(n.id);
        }
      }
      renderSvgTree();
      fitTreeToViewport();
    });

    // Kanvas Zoom / Fit / Reset / Root / Mode tugmalari
    function zoomByFactor(factor: number): void {
      const rect = panContainer!.getBoundingClientRect();
      const cx = (rect.width || 600) / 2;
      const cy = (rect.height || 500) / 2;
      const nextZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, zoom * factor));
      panX = cx - ((cx - panX) / zoom) * nextZoom;
      panY = cy - ((cy - panY) / zoom) * nextZoom;
      zoom = nextZoom;
      applyTransform();
    }

    document.getElementById('btn-zoom-in')?.addEventListener('click', () => zoomByFactor(1.22));
    document.getElementById('btn-zoom-out')?.addEventListener('click', () => zoomByFactor(1 / 1.22));
    document.getElementById('btn-fit-screen')?.addEventListener('click', () => fitTreeToViewport());
    document.getElementById('btn-reset-view')?.addEventListener('click', () => {
      collapsedParents.clear();
      renderSvgTree();
      zoom = 1;
      centerOnPersonNode(selectedPersonId);
    });
    document.getElementById('btn-return-root')?.addEventListener('click', () => {
      selectPerson(currentDynasty.founderId, { panToNode: true });
    });

    document.getElementById('btn-mode-tree')?.addEventListener('click', () => setViewMode('tree'));
    document.getElementById('btn-mode-list')?.addEventListener('click', () => setViewMode('list'));

    // Mobil tortma tugmalari
    btnOpenLeft?.addEventListener('click', () => openDrawer('left'));
    btnOpenRight?.addEventListener('click', () => openDrawer('right'));
    document.getElementById('btn-close-left-drawer')?.addEventListener('click', closeDrawers);
    document.getElementById('btn-close-right-drawer')?.addEventListener('click', closeDrawers);
    backdrop?.addEventListener('click', closeDrawers);

    // Sichqoncha va Sensor (Pointer + Wheel + Pinch) Pan & Zoom
    const activePointers = new Map<number, { x: number; y: number }>();
    let lastDragPos: { x: number; y: number } | null = null;
    let lastPinchDist: number | null = null;
    let hasMovedDuringDrag = false;

    panContainer.addEventListener('pointerdown', (e) => {
      if ((e.target as Element | null)?.closest('.tree-person-node, [data-collapse-id]')) {
        return;
      }
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      panContainer.setPointerCapture(e.pointerId);
      panContainer.classList.add('is-panning');
      hasMovedDuringDrag = false;

      if (activePointers.size === 1) {
        lastDragPos = { x: e.clientX, y: e.clientY };
      } else if (activePointers.size === 2) {
        const pts = Array.from(activePointers.values());
        lastPinchDist = Math.hypot(pts[1]!.x - pts[0]!.x, pts[1]!.y - pts[0]!.y);
      }
    });

    panContainer.addEventListener('pointermove', (e) => {
      if (!activePointers.has(e.pointerId)) return;
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (activePointers.size === 1 && lastDragPos) {
        const dx = e.clientX - lastDragPos.x;
        const dy = e.clientY - lastDragPos.y;
        if (Math.abs(dx) > 2 || Math.abs(dy) > 2) hasMovedDuringDrag = true;
        panX += dx;
        panY += dy;
        lastDragPos = { x: e.clientX, y: e.clientY };
        applyTransform();
      } else if (activePointers.size === 2) {
        const pts = Array.from(activePointers.values());
        const dist = Math.hypot(pts[1]!.x - pts[0]!.x, pts[1]!.y - pts[0]!.y);
        if (lastPinchDist && lastPinchDist > 8) {
          const rect = panContainer.getBoundingClientRect();
          const midX = (pts[0]!.x + pts[1]!.x) / 2 - rect.left;
          const midY = (pts[0]!.y + pts[1]!.y) / 2 - rect.top;
          const nextZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, zoom * (dist / lastPinchDist)));
          panX = midX - ((midX - panX) / zoom) * nextZoom;
          panY = midY - ((midY - panY) / zoom) * nextZoom;
          zoom = nextZoom;
          applyTransform();
        }
        lastPinchDist = dist;
      }
    });

    function clearPointer(e: PointerEvent): void {
      activePointers.delete(e.pointerId);
      if (activePointers.size < 2) lastPinchDist = null;
      if (activePointers.size === 1) {
        const rem = Array.from(activePointers.values())[0]!;
        lastDragPos = { x: rem.x, y: rem.y };
      } else if (activePointers.size === 0) {
        lastDragPos = null;
        panContainer!.classList.remove('is-panning');
      }
      if (hasMovedDuringDrag) {
        hasMovedDuringDrag = false;
      }
    }

    panContainer.addEventListener('pointerup', clearPointer);
    panContainer.addEventListener('pointercancel', clearPointer);

    panContainer.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const rect = panContainer.getBoundingClientRect();
        const cx = e.clientX - rect.left;
        const cy = e.clientY - rect.top;
        const factor = e.deltaY < 0 ? 1.12 : 1 / 1.12;
        const nextZoom = Math.max(MIN_ZOOM, Math.min(MAX_ZOOM, zoom * factor));
        panX = cx - ((cx - panX) / zoom) * nextZoom;
        panY = cy - ((cy - panY) / zoom) * nextZoom;
        zoom = nextZoom;
        applyTransform();
      },
      { passive: false }
    );

    // Boshlangʻich initsializatsiya
    if (activeDynastyId !== root.dataset.activeDynasty) {
      updateDynastyHeaderAndSidebar();
    }
    renderSvgTree();
    updateLineageBreadcrumbs();
    updateProfilePanel(selectedPersonId);
    if (viewMode === 'list') {
      setViewMode('list');
    } else {
      fitTreeToViewport();
    }

    // Fon rejimida barcha 6 sulola paketini yuklash va chuqur URL parametrlarini yechish
    if (!fullDataLoaded) {
      void ensureFullDataset().then(() => {
        if (paramDynasty && dynastyMap.has(paramDynasty) && activeDynastyId !== paramDynasty) {
          switchDynasty(paramDynasty, paramPerson || undefined);
          if (paramPerson && people[paramPerson]) {
            centerOnPersonNode(paramPerson, 0.85);
          }
        } else if (paramPerson && people[paramPerson] && selectedPersonId !== paramPerson) {
          selectPerson(paramPerson, { panToNode: true });
        }
      });
    }

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1120) {
        if (
          leftSidebar?.classList.contains('is-drawer-open') ||
          rightPanel?.classList.contains('is-drawer-open')
        ) {
          closeDrawers();
        }
      }
    });
  }

  initGenealogyAtlas();
</script>

