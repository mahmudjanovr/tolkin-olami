---
import {
  groupReverseReferences,
  type ReverseReferenceItem,
} from '@/utils/reverse-citations';

interface Props {
  items: ReverseReferenceItem[];
}

const { items = [] } = Astro.props;
const groups = groupReverseReferences(items);
---

<section class="reverse-citations-section" aria-labelledby="reverse-citations-heading">
  <div class="section-header">
    <h2 id="reverse-citations-heading" class="section-title">
      Ushbu manbaga tayanuvchi maqolalar
    </h2>
    {
      items.length > 0 && (
        <span class="count-pill" aria-label={`Jami ${items.length} ta havola`}>
          {items.length} ta yozuv
        </span>
      )
    }
  </div>

  {
    groups.length === 0 ? (
      <div class="empty-state">
        <p class="empty-text">
          Hozircha ushbu kitobga bevosita tayangan ensiklopediya maqolalari mavjud emas.
        </p>
      </div>
    ) : (
      <div class="groups-container">
        {groups.map((group) => (
          <div class="reference-group">
            <h3 class="group-title">
              <span class="group-name">{group.label}</span>
              <span class="group-count">({group.items.length})</span>
            </h3>
            <ul class="reference-list">
              {group.items.map((item) => (
                <li class="reference-item">
                  <a href={item.href} class="reference-link">
                    {item.title}
                  </a>
                  {item.chapters.length > 0 && (
                    <span class="reference-context">
                      {' '}
                      — <span class="chapter-text">{item.chapters.join(', ')}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }
</section>

<style>
  .reverse-citations-section {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 2rem;
    margin-top: 2.5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-family: var(--font-serif-heading);
    font-size: 1.375rem; /* 22px */
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin: 0;
  }

  .count-pill {
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
  }

  .empty-state {
    padding: 1.25rem;
    background-color: var(--color-bg-subtle);
    border: 1px dashed var(--color-border-subtle);
    border-radius: 4px;
  }

  .empty-text {
    font-family: var(--font-sans-ui);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
    font-style: italic;
  }

  .groups-container {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .reference-group {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .group-title {
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-gold);
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .group-count {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .reference-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .reference-item {
    font-family: var(--font-sans-ui);
    font-size: 0.9375rem;
    line-height: 1.5;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-border-subtle);
  }

  .reference-link {
    font-weight: 600;
    color: var(--color-link);
    text-decoration: underline;
    text-decoration-color: var(--color-border-subtle);
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .reference-link:hover {
    color: var(--color-accent-gold-hover);
    text-decoration-color: var(--color-accent-gold);
  }

  .reference-context {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .chapter-text {
    font-family: var(--font-serif-body);
    font-style: italic;
  }
</style>
