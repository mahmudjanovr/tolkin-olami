---
import type { AdaptationItem } from '@/content/schemas';

interface Props {
  adaptations: AdaptationItem[];
}

const { adaptations = [] } = Astro.props;

const MEDIUM_NAMES: Record<string, string> = {
  film: 'Film (Kino)',
  series: 'Serial',
  game: 'Video oʻyin',
  radio: 'Radiopostanovka',
  stage: 'Teatr',
};
---

{
  adaptations.length > 0 && (
    <section class="adaptations-container" aria-label="Zamonaviy moslashuvlar">
      <div class="adaptations-header">
        <h3 class="adaptations-title">
          Zamonaviy Moslashuvlar va Madaniy Qabul
          <span class="non-canonical-badge">Kanon Emas</span>
        </h3>
        <p class="adaptations-disclaimer">
          <strong>Tahririyat eslatmasi:</strong> Quyidagi moslashuvlar J.R.R. Tolkienning asl adabiy
          matnlariga kirmaydi va erkin ijodiy yoki tijoriy talqinlar hisoblanadi. Matnshunoslikda
          birlamchi manba sifatida foydalanilmaydi.
        </p>
      </div>

      <div class="adaptations-grid">
        {adaptations.map((item) => (
          <div class="adaptation-card">
            <div class="adaptation-meta">
              <span class="adaptation-medium">{MEDIUM_NAMES[item.medium] || item.medium}</span>
              <span class="adaptation-year">{item.year}</span>
            </div>
            <h4 class="adaptation-item-title">{item.title}</h4>
            <p class="adaptation-creator">Muallif / Rejissyor: {item.creator}</p>
            <p class="adaptation-divergence">
              <strong>Kanondan farqlar:</strong> {item.divergence_notes}
            </p>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .adaptations-container {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px dashed var(--color-border-subtle);
    font-family: var(--font-sans-ui);
  }

  .adaptations-header {
    margin-bottom: 1.5rem;
  }

  .adaptations-title {
    font-family: var(--font-serif-heading);
    font-size: 1.25rem; /* 20px */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .non-canonical-badge {
    font-family: var(--font-sans-ui);
    font-size: 0.6875rem; /* 11px */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 2px;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
  }

  .adaptations-disclaimer {
    font-size: 0.8125rem; /* 13px */
    line-height: 1.5;
    color: var(--color-text-muted);
    background-color: var(--color-bg-elevated);
    border-left: 3px solid var(--color-accent-gold);
    padding: 0.625rem 0.875rem;
    border-radius: 0 3px 3px 0;
    margin: 0;
  }

  .adaptations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .adaptations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .adaptation-card {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    padding: 1rem;
    border-radius: 4px;
    font-size: 0.8125rem; /* 13px */
  }

  .adaptation-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .adaptation-item-title {
    font-family: var(--font-serif-heading);
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .adaptation-creator {
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .adaptation-divergence {
    color: var(--color-text-primary);
    line-height: 1.4;
    margin: 0;
  }
</style>
