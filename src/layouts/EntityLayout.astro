---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/editorial/Breadcrumbs.astro';
import ProvenanceBadge from '@/components/editorial/ProvenanceBadge.astro';
import CitationBlock from '@/components/editorial/CitationBlock.astro';
import RelatedEntities from '@/components/editorial/RelatedEntities.astro';
import AdaptationsBlock from '@/components/editorial/AdaptationsBlock.astro';
import type { TextualStatus, SourceRef, AdaptationItem } from '@/content/schemas';

export interface RelatedGroup {
  title: string;
  items: Array<{ name: string; href?: string }>;
}

interface Props {
  title: string;
  originalName?: string;
  category: string;
  breadcrumbs: Array<{ label: string; href?: string }>;
  textualStatus: TextualStatus;
  sources: SourceRef[];
  relatedItems?: Array<{ name: string; href?: string }>;
  relatedGroups?: RelatedGroup[];
  adaptations?: AdaptationItem[];
  leadSummary?: string;
  image?: string;
}

const {
  title,
  originalName,
  category,
  breadcrumbs,
  textualStatus,
  sources,
  relatedItems = [],
  relatedGroups = [],
  adaptations = [],
  leadSummary,
  image,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={leadSummary || `${title} — Tolkien Olami ensiklopedik maqolasi`}
  type="article"
  image={image}
>
  <div class="entity-container container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="entity-header">
      <div class="header-meta">
        <span class="entity-category">{category}</span>
        <ProvenanceBadge status={textualStatus} />
      </div>

      <h1 class="entity-title" data-pagefind-meta="title">
        {title}
        {originalName && <span class="entity-original-name">({originalName})</span>}
      </h1>

      {leadSummary && <p class="entity-lead">{leadSummary}</p>}
    </header>

    <div class={`entity-grid ${Astro.slots.has('sidebar-media') ? 'has-sidebar-media' : ''}`}>
      <article class="entity-body" data-pagefind-body>
        <slot />

        <AdaptationsBlock adaptations={adaptations} />
      </article>

      <aside class="scholarly-margin" aria-label="Ilmiy izohlar, manbalar va munosabatlar">
        {Astro.slots.has('sidebar-media') && (
          <div class="sidebar-media-box">
            <slot name="sidebar-media" />
          </div>
        )}

        <div class="margin-card metadata-card">
          <h2 class="margin-section-heading">Entiti Maʼlumotlari</h2>
          <slot name="metadata" />
        </div>

        {sources && sources.length > 0 && (
          <div class="margin-card citations-card">
            <CitationBlock sources={sources} />
          </div>
        )}

        {relatedGroups && relatedGroups.length > 0 ? (
          <div class="margin-card related-card">
            <h2 class="margin-section-heading">Bogʻliq Munosabatlar</h2>
            {relatedGroups
              .filter((group) => group.items.length > 0)
              .map((group, idx) => (
                <div class={idx > 0 ? 'related-group-block has-divider' : 'related-group-block'}>
                  <RelatedEntities title={group.title} items={group.items} />
                </div>
              ))}
          </div>
        ) : relatedItems.length > 0 ? (
          <div class="margin-card related-card">
            <RelatedEntities items={relatedItems} />
          </div>
        ) : null}

        <slot name="margin" />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .entity-container {
    padding-block: 2.5rem 5rem;
  }

  .entity-header {
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .header-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.875rem;
  }

  .entity-category {
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent-gold-text);
  }

  .entity-title {
    font-family: var(--font-serif-heading);
    font-size: clamp(2.25rem, 4vw, 3.125rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 0.875rem;
    color: var(--color-text-primary);
    letter-spacing: -0.015em;
  }

  .entity-original-name {
    font-family: var(--font-serif-heading);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    color: var(--color-text-secondary);
    margin-left: 0.5rem;
  }

  .entity-lead {
    font-family: var(--font-serif-body);
    font-size: 1.1875rem;
    font-style: italic;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 68ch;
    margin-bottom: 0;
  }

  .entity-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .entity-grid {
      grid-template-columns: 66% 34%;
      align-items: start;
    }
  }

  .sidebar-media-box {
    margin-bottom: 0.75rem;
  }

  @media (max-width: 1023px) {
    .entity-grid.has-sidebar-media {
      display: flex;
      flex-direction: column;
    }

    .entity-grid.has-sidebar-media .scholarly-margin {
      display: contents;
    }

    .entity-grid.has-sidebar-media .sidebar-media-box {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
      width: 100%;
      margin-bottom: 2rem;
    }

    .entity-grid.has-sidebar-media .entity-body {
      order: 0;
    }

    .entity-grid.has-sidebar-media .metadata-card {
      order: 1;
      margin-top: 2rem;
    }

    .entity-grid.has-sidebar-media .citations-card {
      order: 2;
    }

    .entity-grid.has-sidebar-media .related-card {
      order: 3;
    }
  }

  .entity-body {
    min-width: 0;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-primary);
  }

  .entity-body :global(h2) {
    font-size: 1.625rem;
    font-weight: 700;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
  }

  .entity-body :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.625rem;
    color: var(--color-accent-gold-text);
  }

  .entity-body :global(p) {
    margin-bottom: 1.35rem;
  }

  .scholarly-margin {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    font-family: var(--font-sans-ui);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 2rem;
  }

  @media (min-width: 1024px) {
    .scholarly-margin {
      border-top: none;
      border-left: 1px solid var(--color-border-subtle);
      padding-top: 0;
      padding-left: 2rem;
      position: sticky;
      top: 5rem;
    }
  }

  .margin-card {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    padding: 1.25rem;
    border-radius: 3px;
    box-shadow: var(--shadow-sm);
  }

  .margin-section-heading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold-text);
    margin-bottom: 0.875rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .related-group-block:first-child :global(.related-container) {
    margin-top: 0;
  }

  .related-group-block.has-divider {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border-subtle);
  }
</style>
