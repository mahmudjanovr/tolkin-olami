<script>
  function initLightLineage() {
    const stepButtons = document.querySelectorAll<HTMLButtonElement>('.lineage-step-btn');
    const stageCards = document.querySelectorAll<HTMLElement>('.lineage-detail-card');

    if (!stepButtons.length || !stageCards.length) return;

    stepButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const stageId = btn.getAttribute('data-stage-id');
        if (!stageId) return;

        stepButtons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('is-active', isActive);
          b.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        stageCards.forEach((c) => {
          const isTarget = c.getAttribute('data-stage-card') === stageId;
          c.classList.toggle('is-active', isTarget);
        });
      });

      // Klaviatura boshqaruvi
      btn.addEventListener('keydown', (e) => {
        const btnsArray = Array.from(stepButtons);
        const index = btnsArray.indexOf(btn);

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = btnsArray[(index + 1) % btnsArray.length];
          next?.focus();
          next?.click();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = btnsArray[(index - 1 + btnsArray.length) % btnsArray.length];
          prev?.focus();
          prev?.click();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightLineage);
  } else {
    initLightLineage();
  }
</script>
