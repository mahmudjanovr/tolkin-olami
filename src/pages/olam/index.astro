---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/editorial/Breadcrumbs.astro';
import EntityCard, { type MetaRow } from '@/components/list/EntityCard.astro';
import { REGISTERED_JOURNEYS } from '@/data/journeys/journey-registry';

const breadcrumbs = [
  { label: 'Olam Hubi' },
];

const allBooks = await getCollection('books');
const allPlaces = await getCollection('places');
const allCosmology = await getCollection('cosmology');

const totalBooks = allBooks.length;
const totalPlaces = allPlaces.length;
const totalJourneys = Object.keys(REGISTERED_JOURNEYS).length;

function getTwoSentenceExcerpt(text: string): string {
  if (!text) return '';
  const sentences = text.match(/[^.!?]+[.!?]+/g);
  if (sentences && sentences.length >= 2 && sentences[0] && sentences[1]) {
    return `${sentences[0].trim()} ${sentences[1].trim()}`;
  }
  return text.trim();
}

// Preview items
const previewBooks = allBooks
  .filter((b) => ['the-hobbit', 'the-lord-of-the-rings', 'silmarillion'].includes(b.data.id || b.id))
  .slice(0, 3);

// Fallback if specific IDs differ
const finalPreviewBooks = previewBooks.length === 3 ? previewBooks : allBooks.slice(0, 3);

const previewPlaces = allPlaces
  .filter((p) => ['rivendell', 'minas-tirith', 'gondolin'].includes(p.data.id || p.id))
  .slice(0, 3);

const finalPreviewPlaces = previewPlaces.length === 3 ? previewPlaces : allPlaces.slice(0, 3);
---

<BaseLayout
  title="Olam Hubi: Kitoblar, Joylar va Xaritalar"
  description="Tolkien olamining uch asosiy poydevori: kanonik kitoblar korpusi, toponimlar katalogi hamda interaktiv kartografik atlas."
  type="article"
>
  <div class="olam-hub-page container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="hub-header">
      <span class="hub-category-badge">Ensiklopediya Hubi</span>
      <h1 class="hub-title" data-pagefind-meta="title">Arda Olami: Kitoblar, Joylar va Xaritalar</h1>
      <p class="hub-lead">
        Tolkien olamining geografik xaritalari, toponimlar ensiklopediyasi, kanonik bibliografiya hamda koinot yaratilishining metafizik asoslari jamlangan markaziy portal.
      </p>
    </header>

    <!-- 1. Uch Asosiy Katta Kirish Kartochkasi (Three Large Entry Cards) -->
    <section class="hub-cards-section" aria-label="Asosiy ensiklopediya yoʻnalishlari">
      <div class="hub-cards-grid">
        <!-- 1-Karta: Kitoblar va Bibliografiya -->
        <article class="hub-large-card">
          <div class="card-glow-bg" aria-hidden="true"></div>
          <header class="large-card-header">
            <div class="header-tags-row">
              <span class="hub-tag">Kanonik Korpus</span>
              <span class="hub-counter-badge">{totalBooks} ta kitob</span>
            </div>
            <h2 class="large-card-title">
              <a href="/kitoblar/">Kitoblar va Bibliografiya</a>
            </h2>
            <p class="large-card-desc">
              J.R.R. Tolkienning hayotlik nashrlari, Christopher Tolkien tahriridagi tiklangan asarlar va ilmiy toʻplamlar.
            </p>
          </header>

          <div class="large-card-preview books-preview-shelf" aria-label="Tanlangan kitob muqovalari">
            {finalPreviewBooks.map((b) => {
              const bId = b.data.id || b.id;
              return (
                <a href={`/kitoblar/${bId}/`} class="preview-book-thumb" title={b.data.title_uz}>
                  {b.data.cover_image && (
                    <img
                      src={b.data.cover_image.src}
                      alt={b.data.title_uz}
                      class="thumb-img book-cover"
                      loading="lazy"
                      width="80"
                      height="120"
                    />
                  )}
                  <span class="thumb-caption">{b.data.title_uz}</span>
                </a>
              );
            })}
          </div>

          <footer class="large-card-footer">
            <a href="/kitoblar/" class="hub-action-btn">
              Kitoblar katalogiga oʻtish <span aria-hidden="true">→</span>
            </a>
          </footer>
        </article>

        <!-- 2-Karta: Joylar va Toponimlar -->
        <article class="hub-large-card">
          <div class="card-glow-bg" aria-hidden="true"></div>
          <header class="large-card-header">
            <div class="header-tags-row">
              <span class="hub-tag">Geografik Katalog</span>
              <span class="hub-counter-badge">{totalPlaces} ta toponim</span>
            </div>
            <h2 class="large-card-title">
              <a href="/xaritalar/#toponimlar">Joylar va Toponimlar</a>
            </h2>
            <p class="large-card-desc">
              Oʻrta-yer va Beleriandning barcha shahar, qalʼa, oʻlka va geografik maskanlari ilmiy katalogi.
            </p>
          </header>

          <div class="large-card-preview places-preview-list" aria-label="Muhim joylar namunalari">
            {finalPreviewPlaces.map((p) => {
              const pId = p.data.id || p.id;
              return (
                <a href={`/xaritalar/${pId}/`} class="preview-place-item">
                  <div class="place-item-icon" aria-hidden="true">🏰</div>
                  <div class="place-item-text">
                    <span class="place-name">{p.data.name}</span>
                    <span class="place-meta">{p.data.type} • {p.data.region}</span>
                  </div>
                </a>
              );
            })}
          </div>

          <footer class="large-card-footer">
            <a href="/xaritalar/#toponimlar" class="hub-action-btn">
              Toponimlar katalogiga oʻtish <span aria-hidden="true">→</span>
            </a>
          </footer>
        </article>

        <!-- 3-Karta: Tarixiy Atlas va Xaritalar -->
        <article class="hub-large-card">
          <div class="card-glow-bg" aria-hidden="true"></div>
          <header class="large-card-header">
            <div class="header-tags-row">
              <span class="hub-tag">Interaktiv Kartografiya</span>
              <span class="hub-counter-badge">{totalJourneys} ta sayr • 2 ta atlas</span>
            </div>
            <h2 class="large-card-title">
              <a href="/xaritalar/">Tarixiy Atlas va Xaritalar</a>
            </h2>
            <p class="large-card-desc">
              Beleriand va Oʻrta-yerning koʻp qatlamli Leaflet xaritasi, sayr marshrutlari va toponimik qidiruv tizimi.
            </p>
          </header>

          <div class="large-card-preview maps-preview-grid" aria-label="Xaritalar namoyishi">
            <a href="/xaritalar/?xarita=orta-yer" class="preview-map-thumb" title="Oʻrta-yer xaritasi">
              <img
                src="/assets/maps/middle-earth-planar.svg"
                alt="Oʻrta-yer tekis xaritasi"
                class="thumb-img map-img"
                loading="lazy"
                width="110"
                height="75"
              />
              <span class="thumb-caption">Oʻrta-yer atlasi</span>
            </a>
            <a href="/xaritalar/?xarita=beleriand" class="preview-map-thumb" title="Beleriand xaritasi">
              <img
                src="/assets/maps/beleriand-planar.svg"
                alt="Beleriand tekis xaritasi"
                class="thumb-img map-img"
                loading="lazy"
                width="110"
                height="75"
              />
              <span class="thumb-caption">Beleriand atlasi</span>
            </a>
            <a href="/xaritalar/?sayr=bilbo" class="preview-map-thumb" title="Sayr marshrutlari">
              <div class="journey-preview-icon">
                <span class="icon-ring" aria-hidden="true">🧭</span>
              </div>
              <span class="thumb-caption">Tarixiy sayrlar</span>
            </a>
          </div>

          <footer class="large-card-footer">
            <a href="/xaritalar/" class="hub-action-btn">
              Interaktiv atlasni ochish <span aria-hidden="true">→</span>
            </a>
          </footer>
        </article>
      </div>
    </section>

    <!-- 2. Arda Kosmologiyasi va Mifologik Asoslar (Cosmology Section) -->
    <section class="cosmology-section" aria-labelledby="cosmology-section-title">
      <div class="section-title-wrap">
        <span class="sub-kicker">Ontologiya va Metafizika</span>
        <h2 id="cosmology-section-title" class="sub-heading">Arda Kosmologiyasi va Mifologik Asoslar</h2>
        <p class="section-desc">
          Eru Ilúvatar, Ainulindalë ilohiy musiqasi hamda moddiy koinotning yaralish falsafasiga bagʻishlangan ilmiy tahlillar.
        </p>
      </div>

      <div class="cosmology-cards-grid">
        {allCosmology.map((concept) => {
          const cId = concept.data.id || concept.id;
          const metaRows: MetaRow[] = [
            { label: 'Konsept turi', value: concept.data.concept_type },
            {
              label: 'Ainur',
              value: concept.data.associated_ainur && concept.data.associated_ainur.length > 0
                ? concept.data.associated_ainur.slice(0, 3).join(', ')
                : '—',
            },
          ];

          return (
            <EntityCard
              id={cId}
              name={concept.data.name}
              typeChip={concept.data.concept_type}
              excerpt={getTwoSentenceExcerpt(concept.data.summary)}
              metaRows={metaRows}
              source="Silmarillion & Myths Transformed"
              detailHref={`/olam/${cId}/`}
              detailLabel="Tafsilotlarni oʻqish"
            />
          );
        })}
      </div>
    </section>

    <!-- 3. Arda Ontologiyasi va Ilmiy Izohlar (Collapsed details) -->
    <details class="scholarly-details">
      <summary class="scholarly-details-summary">
        <span class="summary-left">
          <span class="summary-icon" aria-hidden="true">📜</span>
          <span class="summary-title">Arda Ontologiyasi va Ilmiy Izohlar</span>
        </span>
        <span class="summary-badge">Akademik Manbashunoslik</span>
      </summary>

      <div class="scholarly-details-content">
        <div class="scholarly-details-grid">
          <div class="details-card">
            <h3 class="details-heading">Birlamchi va Ikkilamchi Olam</h3>
            <p class="details-text">
              Tolkienning "On Fairy-Stories" essesiga koʻra, inson aqli faol sub-creator (ikkilamchi ijodkor) boʻlib, u tildagi har bir soʻz orqali mustaqil va haqiqatga ega boʻlgan Ikkilamchi Borliq (Secondary World) yaratadi.
            </p>
          </div>

          <div class="details-card">
            <h3 class="details-heading">Kanonik Manbalar</h3>
            <p class="details-text">
              Kosmologik dalillar "Silmarillion", "Morgoth's Ring" (HoME X) va "The Nature of Middle-earth" manbalaridagi kechki muallif qoralamalariga asoslangan.
            </p>
          </div>

          <div class="details-card">
            <h3 class="details-heading">Kartografik Aniq Koordinatalar</h3>
            <p class="details-text">
              Atlasdagi barcha toponimlar Pauline Baynes va Christopher Tolkien chizgan kanonik xaritalarning planar koordinatalariga bogʻlangan.
            </p>
          </div>
        </div>
      </div>
    </details>
  </div>
</BaseLayout>

<style>
  .olam-hub-page {
    padding-block: 2.5rem 4rem;
  }

  .hub-header {
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .hub-category-badge {
    display: inline-block;
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
    margin-bottom: 0.5rem;
  }

  .hub-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.75rem 0;
    color: var(--color-text-primary);
  }

  .hub-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 75ch;
  }

  /* Three Large Entry Cards */
  .hub-cards-section {
    margin-bottom: 4rem;
  }

  .hub-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .hub-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hub-large-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-fast, 0.2s ease);
    overflow: hidden;
  }

  .hub-large-card:hover {
    border-color: var(--color-border-gold);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .large-card-header {
    margin-bottom: 1.25rem;
  }

  .header-tags-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .hub-tag {
    font-family: var(--font-sans-ui);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
  }

  .hub-counter-badge {
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
  }

  .large-card-title {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
  }

  .large-card-title a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .large-card-title a:hover {
    color: var(--color-accent-gold);
  }

  .large-card-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Previews inside large cards */
  .large-card-preview {
    margin-block: 1rem 1.5rem;
    flex-grow: 1;
  }

  /* Books Preview Shelf */
  .books-preview-shelf {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    align-items: flex-end;
    padding: 0.75rem 0.5rem;
    background-color: var(--color-bg-subtle);
    border-radius: 6px;
    border: 1px solid var(--color-border-subtle);
  }

  .preview-book-thumb {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    width: 72px;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .preview-book-thumb:hover {
    transform: translateY(-4px);
  }

  .thumb-img.book-cover {
    width: 64px;
    height: 96px;
    object-fit: cover;
    border-radius: 3px;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
  }

  .thumb-caption {
    font-family: var(--font-sans-ui);
    font-size: 0.625rem;
    line-height: 1.2;
    text-align: center;
    margin-top: 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--color-text-muted);
  }

  /* Places Preview List */
  .places-preview-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .preview-place-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .preview-place-item:hover {
    border-color: var(--color-border-gold);
    transform: translateX(3px);
  }

  .place-item-icon {
    font-size: 1.25rem;
  }

  .place-item-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .place-name {
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .place-meta {
    font-family: var(--font-sans-ui);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  /* Maps Preview Grid */
  .maps-preview-grid {
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
  }

  .preview-map-thumb {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex: 1;
    min-width: 0;
    padding: 0.5rem;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .preview-map-thumb:hover {
    border-color: var(--color-border-gold);
    transform: translateY(-2px);
  }

  .thumb-img.map-img {
    width: 100%;
    height: 60px;
    object-fit: cover;
    border-radius: 3px;
    background-color: var(--color-bg-base);
  }

  .journey-preview-icon {
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-elevated);
    border-radius: 3px;
  }

  .icon-ring {
    font-size: 1.5rem;
  }

  .large-card-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border-subtle);
  }

  .hub-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans-ui);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent-gold);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hub-action-btn:hover {
    color: var(--color-text-primary);
  }

  /* Cosmology Section */
  .cosmology-section {
    margin-bottom: 4rem;
  }

  .section-title-wrap {
    margin-bottom: 1.5rem;
  }

  .sub-kicker {
    display: block;
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
    margin-bottom: 0.25rem;
  }

  .sub-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--color-text-primary);
  }

  .section-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 70ch;
  }

  .cosmology-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }

  /* Collapsed Details */
  .scholarly-details {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color var(--transition-fast, 0.2s ease);
  }

  .scholarly-details:hover {
    border-color: var(--color-border-gold);
  }

  .scholarly-details-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    cursor: pointer;
    font-family: var(--font-sans-ui);
    user-select: none;
    background-color: var(--color-bg-subtle);
    list-style: none;
  }

  .scholarly-details-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .summary-icon {
    font-size: 1.125rem;
  }

  .summary-title {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
  }

  .summary-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
  }

  .scholarly-details-content {
    padding: 1.5rem 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .scholarly-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .scholarly-details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .details-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .details-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .details-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-large-card:hover,
    .preview-book-thumb:hover,
    .preview-place-item:hover,
    .preview-map-thumb:hover {
      transform: none;
    }
  }
</style>
