---
import { getCollection } from 'astro:content';
import EditorialLayout from '@/layouts/EditorialLayout.astro';

const breadcrumbs = [
  { label: 'Qidiruv' },
];

const [
  characters,
  places,
  events,
  peoples,
  languages,
  genealogies,
  cosmology,
  books,
  articles,
] = await Promise.all([
  getCollection('characters'),
  getCollection('places'),
  getCollection('events'),
  getCollection('peoples'),
  getCollection('languages'),
  getCollection('genealogies'),
  getCollection('cosmology'),
  getCollection('books'),
  getCollection('articles'),
]);

const totalEntitiesCount =
  characters.length +
  places.length +
  events.length +
  peoples.length +
  languages.length +
  genealogies.length +
  cosmology.length +
  books.length +
  articles.length;

const quickSuggestions = [
  'Fëanor',
  'Silmarillion',
  'Númenor',
  'Aragorn',
  'Quenya',
  'Khazad-dûm',
  'Eärendil',
  'Shayr',
];

const sitemapSections = [
  { href: '/', title: 'Bosh Sahifa', desc: 'Editorial portal va ensiklopediya kirish darvozasi', countLabel: 'Portal' },
  { href: '/qahramonlar/', title: 'Qahramonlar va Shaxslar', desc: 'Ainur, Elflar, Insonlar, Mittilar va Xobbitlar biografiyalari', countLabel: `${characters.length} ta shaxs` },
  { href: '/xaritalar/', title: 'Xaritalar va Geografiya', desc: 'Beleriand, Oʻrta-yer, Númenor va Valinor interaktiv atlasi', countLabel: `${places.length} ta toponim` },
  { href: '/tarix/', title: 'Tarix va Xronologiya', desc: 'Buyuk davrlar, Urushlar va xronologik voqealar zanjiri', countLabel: `${events.length} ta voqea` },
  { href: '/xalqlar-va-tillar/', title: 'Xalqlar va Tillar', desc: 'Quenya, Sindarin, Khuzdul, Adûnaic tillari va yozuv tizimlari', countLabel: `${peoples.length} xalq · ${languages.length} til` },
  { href: '/nasabnomalar/', title: 'Sulolalar va Nasabnomalar', desc: 'Finwë, Edain, Elros, Rohan, Durin va Shayr shajaralari', countLabel: `${genealogies.length} ta sulola` },
  { href: '/olam/', title: 'Arda va Kosmologiya', desc: 'Ainulindalë, Eä, Kúma, Ikki Daraxt va metafizik tuzilish', countLabel: `${cosmology.length} ta tushuncha` },
  { href: '/kitoblar/', title: 'Kitoblar va Bibliografiya', desc: 'Birlamchi manbalar, HoME va ilmiy qoʻlyozmalar katalogi', countLabel: `${books.length} ta asar` },
  { href: '/maqolalar/', title: 'Ilmiy Maqolalar', desc: 'Tolkien falsafasi, matn tarixi va ekranlashtirish tahlillari', countLabel: `${articles.filter((a) => a.data.category !== 'tolkienshunoslik').length} ta maqola` },
  { href: '/tolkien/', title: 'J.R.R. Tolkien', desc: 'Professor hayoti, filologik metodi va ilmiy merosi', countLabel: `${articles.filter((a) => a.data.category === 'tolkienshunoslik').length} ta monografiya` },
];
---

<EditorialLayout
  title="Ensiklopediya Boʻyicha Qidiruv"
  category="Global Qidiruv"
  description="Barcha boʻlimlar, maqolalar, qahramonlar va birlamchi manbalar boʻyicha statik qidiruv tizimi."
  breadcrumbs={breadcrumbs}
>
  <div class="search-page-wrapper">
    <!-- JavaScript Yoqilganda Ishlovchi Qidiruv Bloki -->
    <div id="js-search-container" class="js-search-container">
      <div class="search-box">
        <label for="page-search-input" class="search-label">Qidiruv soʻrovini kiriting:</label>
        <div class="search-input-row">
          <input
            id="page-search-input"
            type="search"
            class="page-search-input"
            placeholder="Masalan: Fëanor, Oʻrta-yer, Silmarillar, Quenya..."
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <div class="quick-suggestions" aria-label="Tezkor qidiruv namunalari">
          <span class="suggestions-label">Tezkor soʻrovlar:</span>
          {quickSuggestions.map((term) => (
            <button type="button" class="suggestion-chip" data-search-suggestion={term}>
              {term}
            </button>
          ))}
        </div>
        <p class="search-tip">
          Klaviatura yordamida istalgan sahifada <kbd>Ctrl+K</kbd> yoki <kbd>Cmd+K</kbd> tugmalarini bosib qidiruv modalini ochishingiz mumkin.
        </p>
      </div>

      <div id="page-search-status" class="page-search-status" role="status" aria-live="polite">
        Qidiruv soʻrovini kiriting...
      </div>

      <div id="page-search-results" class="page-search-results" aria-label="Qidiruv natijalari"></div>
    </div>

    <!-- Doimiy ko'rinuvchi Ensiklopediya Mundarijasi -->
    <nav class="live-sitemap" aria-label="Ensiklopediya boʻlimlari mundarijasi">
      <h3 class="sitemap-heading">Ensiklopediya Boʻlimlari Katalogi</h3>
      <ul class="sitemap-list">
        {
          sitemapSections.map((sec) => (
            <li class="sitemap-item">
              <a href={sec.href} class="sitemap-link">
                <div class="sitemap-top-row">
                  <span class="sitemap-title">{sec.title}</span>
                  <span class="sitemap-badge">{sec.countLabel}</span>
                </div>
                <span class="sitemap-desc">{sec.desc}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- JavaScript O'chirilganda Halol No-JS Mundarija (Progressive Enhancement) -->
    <noscript>
      <div class="no-js-alert" role="alert">
        <h3 class="no-js-title">JavaScript Oʻchirilgan Holat</h3>
        <p class="no-js-text">
          Tolkien Olami qidiruv tizimi brauzerda statik WebAssembly (Pagefind) texnologiyasi asosida
          ishlaydi va JavaScript yoqilgan boʻlishini talab qiladi. Yuqoridagi mundarija orqali barcha boʻlimlarga oʻtishingiz mumkin.
        </p>
      </div>
    </noscript>
  </div>

  <div slot="margin">
    <div class="margin-card">
      <h3 class="margin-title">Indeks Koʻrsatkichlari</h3>
      <ul class="index-stats-list">
        <li>Jami indekslangan yozuvlar: <strong>{totalEntitiesCount} ta</strong></li>
        <li>Qahramonlar va shaxslar: <strong>{characters.length} ta</strong></li>
        <li>Geografik toponimlar: <strong>{places.length} ta</strong></li>
        <li>Tarixiy voqealar: <strong>{events.length} ta</strong></li>
        <li>Xalqlar va tillar: <strong>{peoples.length + languages.length} ta</strong></li>
        <li>Sulolalar va kosmologiya: <strong>{genealogies.length + cosmology.length} ta</strong></li>
        <li>Kitoblar va maqolalar: <strong>{books.length + articles.length} ta</strong></li>
      </ul>
    </div>

    <div class="margin-card">
      <h3 class="margin-title">Qidiruv Mezonlari</h3>
      <p>
        Qidiruv tizimi Oʻzbek lotin harflari (oʻ, gʻ, tutuq belgisi) va Tolkien diakritikalarini (ë, ä, é, ú, û)
        avtomatik tarzda tushunadi va aniq natijalarni topadi.
      </p>
    </div>
  </div>
</EditorialLayout>

<script>
  import { normalizeSearchQuery } from '@/utils/search';
  import { loadPagefind } from '@/utils/pagefind';

  function initPageSearch() {
    const input = document.getElementById('page-search-input') as HTMLInputElement | null;
    const status = document.getElementById('page-search-status');
    const resultsContainer = document.getElementById('page-search-results');
    const suggestionButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-suggestion]');

    if (!input || !status || !resultsContainer) return;

    let debounceTimer: any = null;

    suggestionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const term = btn.getAttribute('data-search-suggestion') || '';
        input.value = term;
        input.focus();
        input.dispatchEvent(new Event('input'));
      });
    });

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(async () => {
        const query = input.value.trim();
        if (!query) {
          resultsContainer.innerHTML = '';
          status.textContent = 'Qidiruv soʻrovini kiriting...';
          return;
        }

        status.textContent = 'Qidirilmoqda...';

        const pf = await loadPagefind();
        if (!pf) {
          status.textContent = "Qidiruv indeksi statik yig'ish (build) jarayonidan so'ng yuklanadi.";
          return;
        }

        try {
          const normalized = normalizeSearchQuery(query);
          const search = await pf.search(normalized || query);
          const results = search.results;

          if (results.length === 0) {
            resultsContainer.innerHTML = '';
            status.textContent = `"${query}" boʻyicha hech narsa topilmadi.`;
            return;
          }

          status.textContent = `Topilgan natijalar: ${results.length} ta`;
          resultsContainer.innerHTML = '';

          const list = document.createElement('ul');
          list.className = 'page-results-list';

          for (const item of results.slice(0, 20)) {
            const data = await item.data();
            const li = document.createElement('li');
            li.className = 'page-result-item';

            const a = document.createElement('a');
            a.href = data.url;
            a.className = 'page-result-link';

            const h4 = document.createElement('h4');
            h4.className = 'page-result-title';
            h4.textContent = data.meta?.title || data.url;

            const p = document.createElement('p');
            p.className = 'page-result-excerpt';
            p.innerHTML = data.excerpt || '';

            a.appendChild(h4);
            a.appendChild(p);
            li.appendChild(a);
            list.appendChild(li);
          }

          resultsContainer.appendChild(list);
        } catch (err) {
          console.error('Qidiruv xatosi:', err);
          status.textContent = 'Qidiruvda xatolik yuz berdi.';
        }
      }, 150);
    });
  }

  document.addEventListener('DOMContentLoaded', initPageSearch);
  document.addEventListener('astro:page-load', initPageSearch);
</script>

<style>
  .search-page-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .search-box {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    padding: 1.5rem;
  }

  .search-label {
    display: block;
    font-family: var(--font-sans-ui);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary);
  }

  .page-search-input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-family: var(--font-sans-ui);
    font-size: 1.125rem;
    color: var(--color-text-primary);
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-strong);
    border-radius: 3px;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .page-search-input:focus {
    border-color: var(--color-accent-gold);
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 1px;
  }

  .quick-suggestions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .suggestions-label {
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-right: 0.25rem;
  }

  .suggestion-chip {
    font-family: var(--font-sans-ui);
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    background-color: var(--color-bg-base);
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .suggestion-chip:hover {
    border-color: var(--color-border-gold);
    color: var(--color-accent-gold-text);
  }

  .search-tip {
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .search-tip kbd {
    font-size: 0.75rem;
    padding: 2px 5px;
    border-radius: 3px;
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-subtle);
  }

  .page-search-status {
    font-family: var(--font-sans-ui);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  :global(.page-results-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.page-result-item) {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  :global(.page-result-item:hover) {
    border-color: var(--color-border-gold);
    box-shadow: var(--shadow-md);
  }

  :global(.page-result-link) {
    display: block;
    padding: 1.25rem;
    text-decoration: none;
  }

  :global(.page-result-title) {
    font-family: var(--font-serif-heading);
    font-size: 1.25rem;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem 0;
  }

  :global(.page-result-excerpt) {
    font-family: var(--font-sans-ui);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  :global(.page-result-excerpt mark) {
    background-color: transparent;
    color: var(--color-accent-gold);
    font-weight: 600;
  }

  /* No-JS Fallback Styles */
  .no-js-alert {
    background-color: var(--color-bg-elevated);
    border-left: 4px solid var(--color-accent-gold);
    padding: 1.25rem;
    border-radius: 0 4px 4px 0;
  }

  .no-js-title {
    font-family: var(--font-serif-heading);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .no-js-text,
  .no-js-subtext {
    font-family: var(--font-sans-ui);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .live-sitemap,
  .no-js-sitemap {
    margin-top: 0.5rem;
  }

  .sitemap-heading {
    font-family: var(--font-serif-heading);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .sitemap-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .sitemap-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .sitemap-item {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 3px;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .sitemap-item:hover {
    border-color: var(--color-border-gold);
    box-shadow: var(--shadow-md);
  }

  .sitemap-link {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    text-decoration: none;
    height: 100%;
  }

  .sitemap-top-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .sitemap-title {
    font-family: var(--font-serif-heading);
    font-size: 1.0625rem;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .sitemap-badge {
    font-family: var(--font-sans-ui);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-accent-gold-text);
    white-space: nowrap;
  }

  .sitemap-desc {
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .sitemap-link:hover .sitemap-title {
    color: var(--color-accent-gold-text);
  }

  .margin-card {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    padding: 1rem;
    border-radius: 3px;
    box-shadow: var(--shadow-sm);
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    margin-bottom: 1.25rem;
  }

  .margin-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .index-stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--color-text-secondary);
  }

  .index-stats-list strong {
    color: var(--color-text-primary);
  }
</style>
