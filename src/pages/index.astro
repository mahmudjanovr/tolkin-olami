---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProvenanceBadge from '@/components/editorial/ProvenanceBadge.astro';
import CharacterPortrait from '@/components/character/CharacterPortrait.astro';
import BlackSpeechWhiteTree from '@/components/BlackSpeechWhiteTree.astro';
import NavIcon from '@/components/navigation/NavIcon.astro';
import { getCollection } from 'astro:content';

const characters = await getCollection('characters');
const places = await getCollection('places');
const events = await getCollection('events');
const peoples = await getCollection('peoples');
const languages = await getCollection('languages');
const books = await getCollection('books');
const genealogies = await getCollection('genealogies');
const cosmology = await getCollection('cosmology');
const articles = await getCollection('articles');

const totalCanonicalEntities =
  characters.length +
  places.length +
  events.length +
  peoples.length +
  languages.length +
  books.length +
  genealogies.length +
  cosmology.length;

// Featured book editions with verified cover art
const featuredBookSlugs = [
  'the-hobbit',
  'the-fellowship-of-the-ring',
  'the-two-towers',
  'the-return-of-the-king',
  'silmarillion',
  'the-children-of-hurin',
];

const featuredBooks = featuredBookSlugs
  .map((slug) => books.find((b) => b.id === slug))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

// Selected character prosopography portraits
const featuredCharacterIds = [
  { id: 'feanor', title: 'Fëanor (Curufinwë)', role: 'Noldor Oliy Qiroli, Silmarillar yaratuvchisi' },
  { id: 'fingolfin', title: 'Fingolfin', role: 'Beleriand Noldor Oliy Qiroli' },
  { id: 'galadriel', title: 'Galadriel', role: 'Lothlórien xonimi, Nenya sohibasi' },
  { id: 'aragorn', title: 'Aragorn II Elessar', role: 'Gondor va Arnor Oliy Qiroli' },
  { id: 'gandalf', title: 'Gandalf (Mithrandir)', role: 'Istari donishmandi, Oq Kengash aʼzosi' },
  { id: 'frodo-baggins', title: 'Frodo Baggins', role: 'Yagona Uzuk elchisi, Shayrlik xobbit' },
];

// Canonical Historical Journeys (Sayrlar)
const QUICK_JOURNEYS = [
  {
    id: 'silmaril-quest',
    title: 'Beren va Lúthien: Silmaril Safari',
    era: 'Birinchi Davr (Beleriand)',
    href: '/xaritalar/?sayr=silmaril-quest',
    color: '#38bdf8',
    isNew: true,
    desc: 'Dorthoniondan Angband qaʼrigacha: Morgoth tojidan muqaddas gavharning olib chiqilishi.',
  },
  {
    id: 'bilbo',
    title: 'Bilbo Baggins Safari',
    era: 'Uchinchi Davr 2941',
    href: '/xaritalar/?sayr=bilbo',
    color: '#c59b27',
    isNew: false,
    desc: 'Hobbitondan Yolgʻiz Togʻ (Erebor)gacha boʻlgan 10 bosqichli kanonik sayr.',
  },
  {
    id: 'fellowship',
    title: 'Uzuk Qardoshligi Safari',
    era: 'Uchinchi Davr 3018–3019',
    href: '/xaritalar/?sayr=fellowship',
    color: '#3b82f6',
    isNew: false,
    desc: 'Rivendelldan Moria va Lothlórien orqali Amon Hengacha boʻlgan yoʻl.',
  },
  {
    id: 'ring-bearer',
    title: 'Frodo va Sam: Uzuk Egasi Sayri',
    era: 'Uchinchi Davr 3019',
    href: '/xaritalar/?sayr=ring-bearer',
    color: '#ef4444',
    isNew: false,
    desc: 'Amon Hendan Oʻlik Botqoqliklar va Cirith Ungol orqali Orodruingacha.',
  },
  {
    id: 'grey-company',
    title: 'Aragorn va Kulrang Boʻlinma',
    era: 'Uchinchi Davr 3019',
    href: '/xaritalar/?sayr=grey-company',
    color: '#a855f7',
    isNew: false,
    desc: 'Dunharrow, Oʻliklar Yoʻli, Pelargir va Pelennor dalalari jangi sari yurish.',
  },
];

// Historical Eras Timeline
const HISTORICAL_ERAS = [
  {
    period: 'Mifologik Boshlanish',
    name: 'Ainulindalë va Yillar Boshlanishi',
    desc: 'Eru Ilúvatar va Ainur musiqasi orqali Eä olamining yaratilishi, Arda yoritgichlari va Valinorning Ikki Daraxti nuri davri.',
    badge: 'Kosmologiya',
    href: '/olam/ainulindale/',
  },
  {
    period: 'Birinchi Davr',
    name: 'Beleriand va Silmarillar Fojiasi',
    desc: 'Noldor elflarining Oʻrta-yerga qaytishi, Morgothga qarshi buyuk qamallar, Nirnaeth Arnoediad va Gondolin qulashi.',
    badge: '590 yil',
    href: '/tarix/dagor-bragollach/',
  },
  {
    period: 'Ikkinchi Davr',
    name: 'Númenor va Qudrat Uzuklari',
    desc: 'Yulduz oroli — Númenor sivilizatsiyasi choʻqqisi, Eregionda Uzuklarning yasalishi, orolning gʻarqi va Soʻnggi Ittifoq urushi.',
    badge: '3441 yil',
    href: '/tarix/numenorning-halokati/',
  },
  {
    period: 'Uchinchi Davr',
    name: 'Uzuklar Hukmdori va Qardoshlik',
    desc: 'Sauronning qayta kuchayishi, Yagona Uzukning topilishi, Elrond Kengashi, Halqa urushi va Elflarning Gʻarbga ketishi.',
    badge: '3021 yil',
    href: '/tarix/halqa-urushi/',
  },
];

// Key Genealogies
const QUICK_GENEALOGIES = [
  {
    id: 'finwe-xonadoni',
    title: 'Finwë Xonadoni',
    sub: 'Noldor Oliy Qirollari',
    href: '/nasabnomalar/finwe-xonadoni/',
    founder: 'Finwë',
    desc: 'Fëanor, Fingolfin va Finarfin tarmoqlari — Silmarillar va Beleriand fojiasi oʻzagi.',
  },
  {
    id: 'edain-va-yarim-elflar',
    title: 'Edain va Yarim-Elflar (Peredhil)',
    sub: 'Inson va Elf Muqaddas Ittifoqi',
    href: '/nasabnomalar/edain-va-yarim-elflar/',
    founder: 'Bëor, Hador va Haleth',
    desc: 'Beren va Lúthien, Tuor va Idril, Eärendil, Elros va Elrond shajarasi.',
  },
  {
    id: 'elros-va-gondor-shohlari',
    title: 'Elros va Gondor Shohlari',
    sub: 'Númenor va Birlashgan Qirollik',
    href: '/nasabnomalar/elros-va-gondor-shohlari/',
    founder: 'Elros Tar-Minyatur',
    desc: 'Númenor sadoqati, Elendil, Isildur va 3000 yillik silsiladan soʻng Aragorn II taxtga oʻtirishi.',
  },
  {
    id: 'durin-avlodlari',
    title: 'Durin Avlodlari',
    sub: 'Khazad-dûm va Erebor Mittilari',
    href: '/nasabnomalar/durin-avlodlari/',
    founder: 'Durin I Boqiy',
    desc: 'Etti Mitti Oliy Oqsoqolining eng buyugi — Moria va Yolgʻiz Togʻ hukmdorlari sulolasi.',
  },
];
---

<BaseLayout
  title="Tolkien Olami — O'rta yer raqamli ensiklopediyasi"
  description="J.R.R. Tolkien asarlari boʻyicha matnshunoslikka, filologiyaga va birlamchi manbalarga asoslangan oʻzbek tilidagi akademik ensiklopediya."
>
  <div class="homepage-editorial">
    <!-- ======================================================================
         1. OPENING EDITORIAL MASTHEAD COMPOSITION (Hero)
         ====================================================================== -->
    <header class="editorial-hero">
      <div class="hero-texture" aria-hidden="true"></div>
      <div class="hero-inner container">
        <div class="hero-content">
          <div class="hero-eyebrow">
            <span class="editorial-kicker">Oxford Akademik Kutubxonasi × Adabiy Monografiya</span>
            <span class="hero-bullet" aria-hidden="true">·</span>
            <span class="hero-lang-badge">Ilmiy Oʻzbekcha Nashr</span>
          </div>

          <h1 class="display-title hero-heading">
            Oʻrta-yer va Arda Afsonalari
          </h1>

          <p class="standfirst hero-lead">
            J.R.R. Tolkien asarlari, birlamchi qoʻlyozmalar va filologik tadqiqotlarga asoslangan ilk oʻzbekcha akademik raqamli ensiklopediya. Pop-madaniyat toʻqimalaridan xoli, qatʼiy matnshunoslik mezonlari bilan tartiblangan yagona korpus.
          </p>

          <blockquote class="hero-tolkien-quote">
            <p>«Afsonalar — inson qalbining eng qadimiy va eng chuqur haqiqatlaridir.»</p>
            <cite>— J.R.R. Tolkien, «On Fairy-Stories» (1939)</cite>
          </blockquote>

          <div class="hero-actions">
            <a href="/kitoblar/" class="btn-editorial-primary">
              <NavIcon icon="book" size={16} class="btn-icon" />
              <span>Kanonik Kutubxona</span>
            </a>
            <a href="/xaritalar/" class="btn-editorial-secondary">
              <NavIcon icon="compass" size={16} class="btn-icon" />
              <span>Toponimik Atlas</span>
            </a>
            <button type="button" class="btn-editorial-search" data-open-search aria-label="Ensiklopediya boʻyicha qidirish">
              <NavIcon icon="search" size={16} class="btn-icon" />
              <span>Qidirish...</span>
              <kbd>⌘K</kbd>
            </button>
          </div>
        </div>

        <div class="hero-sigil-showcase">
          <BlackSpeechWhiteTree />
        </div>
      </div>

      <!-- Corpus Metrics Strip -->
      <div class="corpus-strip">
        <div class="container corpus-strip-inner">
          <div class="metric-item">
            <span class="metric-number">{totalCanonicalEntities}</span>
            <span class="metric-label">Kanonik Entiti</span>
          </div>
          <div class="metric-divider" aria-hidden="true"></div>
          <div class="metric-item">
            <span class="metric-number">{books.length}</span>
            <span class="metric-label">Birlamchi Asar</span>
          </div>
          <div class="metric-divider" aria-hidden="true"></div>
          <div class="metric-item">
            <span class="metric-number">{places.length}</span>
            <span class="metric-label">Geografik Toponim</span>
          </div>
          <div class="metric-divider" aria-hidden="true"></div>
          <div class="metric-item">
            <span class="metric-number">{languages.length}</span>
            <span class="metric-label">Til va Yozuv Tizimi</span>
          </div>
          <div class="metric-divider" aria-hidden="true"></div>
          <div class="metric-item">
            <span class="metric-number">{articles.length}</span>
            <span class="metric-label">Tahririyat Tadqiqoti</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ======================================================================
         2. FEATURED SCHOLARLY READING (Tanlangan Monografiyalar)
         ====================================================================== -->
    <section class="section-featured container" aria-labelledby="heading-featured">
      <div class="section-header">
        <span class="editorial-kicker">Tahririyat Tanlovi</span>
        <h2 id="heading-featured" class="section-heading">Tanlangan Ilmiy Tadqiqot va Prosopografiya</h2>
        <div class="editorial-rule"></div>
      </div>

      <div class="featured-editorial-layout">
        <!-- Lead Character Feature (Fëanor Monograph) -->
        <article class="lead-monograph-card">
          <div class="monograph-portrait-col">
            <CharacterPortrait
              characterId="feanor"
              name="Fëanor"
              size="detail"
              priority={true}
              customCaption="Fëanor — Finwëning toʻngʻich oʻgʻli, Silmarillar yaratuvchisi va Noldor Oliy Qiroli"
            />
          </div>
          <div class="monograph-text-col">
            <div class="monograph-meta-row">
              <span class="editorial-kicker">Katta Prosopografik Monografiya</span>
              <ProvenanceBadge status="author_published" />
            </div>

            <h3 class="monograph-title">
              <a href="/qahramonlar/feanor/">Fëanor (Curufinwë)</a>
            </h3>

            <p class="monograph-epithet">Finwë va Mírielning toʻngʻich oʻgʻli, Noldor Oliy Qiroli, Silmarillar va Tengwar muallifi</p>

            <p class="monograph-excerpt drop-cap">
              «Silmarillion» asarining eng fojiaviy va qudratli siymosi: uning aql-zakovati va ustachilik mahorati Arda tarixida tengsiz edi. Valinordagi Ikki Daraxt nurini uch muqaddas Silmaril gavhariga muhrlagan ustaning taqdiri — Melkorning fitnasi, Otasining qasosi va Noldor qasamyodi orqali Oʻrta-yerning butun Birinchi Davr tarixini belgilab berdi.
            </p>

            <blockquote class="monograph-quote">
              <p>«Uning sochlari qargʻa qanotidek qora, koʻzlari yoniq olovdek oʻtkir va yorugʻ edi...»</p>
              <cite>— The Silmarillion, 5-bob</cite>
            </blockquote>

            <div class="monograph-footer">
              <a href="/qahramonlar/feanor/" class="editorial-read-link">
                <span>Toʻliq prosopografiyani oʻqish</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Secondary Scholarly Essays Column -->
        <div class="secondary-essays-col">
          <article class="essay-card">
            <div class="essay-meta">
              <span class="editorial-kicker">Falsafa va Teologiya</span>
              <span class="essay-reading-time">12 daqiqa mutolaa</span>
            </div>
            <h4 class="essay-title">
              <a href="/maqolalar/olim-va-boqiylik-mavzusi/">Oʻlim va Boqiylik Mavzusi</a>
            </h4>
            <p class="essay-desc">
              J.R.R. Tolkien teologiyasida Insonlarga berilgan foniylik («Insonlar Inʼomi») hamda Elflarning dunyo bilan bogʻliq boqiyligi oʻrtasidagi metafizik farqlar tahlili.
            </p>
            <a href="/maqolalar/olim-va-boqiylik-mavzusi/" class="essay-link">Maqolani oʻrganish →</a>
          </article>

          <article class="essay-card">
            <div class="essay-meta">
              <span class="editorial-kicker">Matnshunoslik va Mifologiya</span>
              <span class="essay-reading-time">15 daqiqa mutolaa</span>
            </div>
            <h4 class="essay-title">
              <a href="/maqolalar/sub-creation-nazariyasi/">Sub-creation (Ikkilamchi Ijod) Nazariyasi</a>
            </h4>
            <p class="essay-desc">
              Tolkienning afsonalar yaratish falsafasi: insoniyatning Xudo qiyofasidagi ijodkorlik tabiati va ertaklar orqali haqiqatga intilish qonuniyatlari.
            </p>
            <a href="/maqolalar/sub-creation-nazariyasi/" class="essay-link">Tahlilni oʻqish →</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         3. EXPLORE MIDDLE-EARTH (Toponimik Atlas va Marshrutlar)
         ====================================================================== -->
    <section class="section-cartography" aria-labelledby="heading-cartography">
      <div class="container">
        <div class="section-header">
          <span class="editorial-kicker">Geografik Kartografiya</span>
          <h2 id="heading-cartography" class="section-heading">Oʻrta-yer va Beleriand Toponimik Atlasi</h2>
          <p class="section-subheading">
            Tolkien chizgan asl xaritalar va matn koordinatalariga tayanuvchi interaktiv geofazoviy tizim.
          </p>
          <div class="editorial-rule"></div>
        </div>

        <div class="cartography-grid">
          <!-- Atlas Main Feature Box -->
          <div class="atlas-showcase-box">
            <div class="atlas-preview-media">
              <img
                src="/assets/maps/beleriand-planar.svg"
                alt="Beleriandning Birinchi Davrdagi qadimiy kartografiyasi"
                width="600"
                height="450"
                loading="lazy"
                class="atlas-preview-img"
              />
              <div class="atlas-overlay-caption">
                <span class="atlas-map-name">Beleriand va Shimoliy Yerlar</span>
                <span class="atlas-map-era">Birinchi Davr (Gʻazab Urushigacha)</span>
              </div>
            </div>
            <div class="atlas-showcase-body">
              <h3 class="atlas-box-title">Interaktiv Planar Atlas</h3>
              <p class="atlas-box-desc">
                Sirion daryosi havzasi, Doriath qora oʻrmonlari, Gondolin yashirin qirolligi hamda Mordor va Shayrgacha boʻlgan {places.length} ta toponimning filologik etimologiyasi va voqealar xaritasi.
              </p>
              <div class="atlas-box-actions">
                <a href="/xaritalar/" class="btn-editorial-primary">
                  <span>Toʻliq Atlasni Ishga Tushirish</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Canonical Journeys Itinerary -->
          <div class="journeys-itinerary-box">
            <div class="itinerary-header">
              <span class="editorial-kicker">Tarixiy Sayrlar (Atlas Journeys)</span>
              <h3 class="itinerary-title">Kanonik Marshrutlar Solnomasi</h3>
            </div>

            <ol class="journeys-list">
              {QUICK_JOURNEYS.map((j) => (
                <li class="journey-item">
                  <a href={j.href} class="journey-link">
                    <div class="journey-top-row">
                      <span class="journey-color-dot" style={`background-color: ${j.color}`} aria-hidden="true"></span>
                      <span class="journey-era">{j.era}</span>
                      {j.isNew && <span class="journey-pill-new">1-davr</span>}
                    </div>
                    <h4 class="journey-name">{j.title}</h4>
                    <p class="journey-desc">{j.desc}</p>
                    <span class="journey-action-text">Xaritada kuzatish →</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================================
         4. CHARACTERS PROSOPOGRAPHY (Qahramonlar Galereyasi)
         ====================================================================== -->
    <section class="section-characters container" aria-labelledby="heading-characters">
      <div class="section-header">
        <div class="header-split">
          <div>
            <span class="editorial-kicker">Prosopografiya va Biografiyalar</span>
            <h2 id="heading-characters" class="section-heading">Kanonik Qahramonlar Solnomasi</h2>
          </div>
          <a href="/qahramonlar/" class="view-all-link">
            Barcha {characters.length} ta qahramon roʻyxati →
          </a>
        </div>
        <div class="editorial-rule"></div>
      </div>

      <div class="characters-editorial-grid">
        {featuredCharacterIds.map((char) => (
          <article class="char-portrait-card">
            <a href={`/qahramonlar/${char.id}/`} class="char-card-link">
              <div class="char-portrait-frame">
                <CharacterPortrait
                  characterId={char.id}
                  name={char.title}
                  size="directory"
                  class="char-portrait-img"
                />
              </div>
              <div class="char-card-info">
                <h3 class="char-name">{char.title}</h3>
                <p class="char-role">{char.role}</p>
                <span class="char-action-link">Maqolani oʻqish →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- ======================================================================
         5. THE LIBRARY (Kanonik Kitoblar va Qoʻlyozmalar)
         ====================================================================== -->
    <section class="section-library" aria-labelledby="heading-library">
      <div class="container">
        <div class="section-header">
          <div class="header-split">
            <div>
              <span class="editorial-kicker">Muallif Bibliografiyasi</span>
              <h2 id="heading-library" class="section-heading">Kanonik Kutubxona va Nashrlar</h2>
            </div>
            <a href="/kitoblar/" class="view-all-link">
              Barcha {books.length} ta asar katalogi →
            </a>
          </div>
          <p class="section-subheading">
            Tolkienning hayotlik chogʻida chop etilgan durdonalari va Christopher Tolkien tomonidan tartiblangan qoʻlyozmalar.
          </p>
          <div class="editorial-rule"></div>
        </div>

        <div class="library-shelf-grid">
          {featuredBooks.map((book) => {
            const cover = book.data.cover_image;
            return (
              <article class="book-exhibit-card">
                <a href={`/kitoblar/${book.id}/`} class="book-cover-link">
                  <div class="book-cover-frame">
                    {cover ? (
                      <img
                        src={cover.src}
                        alt={cover.alt || book.data.title_uz}
                        width="300"
                        height="450"
                        loading="lazy"
                        class="book-cover-img"
                      />
                    ) : (
                      <div class="book-fallback-cover">
                        <span class="book-fallback-title">{book.data.title_uz}</span>
                      </div>
                    )}
                  </div>
                </a>
                <div class="book-exhibit-info">
                  <span class="book-year">{book.data.publication_year}-yil</span>
                  <h3 class="book-title">
                    <a href={`/kitoblar/${book.id}/`}>{book.data.title_uz}</a>
                  </h3>
                  <span class="book-orig-title">{book.data.title_original}</span>
                  <p class="book-publisher">{book.data.publisher}</p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ======================================================================
         6. CHRONOLOGY OF ARDA (Davrlar va Solnomalar)
         ====================================================================== -->
    <section class="section-chronology container" aria-labelledby="heading-chronology">
      <div class="section-header">
        <div class="header-split">
          <div>
            <span class="editorial-kicker">Vaqt Silsilasi</span>
            <h2 id="heading-chronology" class="section-heading">Buyuk Tarixiy Davrlar Solnomasi</h2>
          </div>
          <a href="/tarix/" class="view-all-link">
            Barcha {events.length} ta tarixiy voqea →
          </a>
        </div>
        <div class="editorial-rule"></div>
      </div>

      <div class="chronology-timeline-grid">
        {HISTORICAL_ERAS.map((era, index) => (
          <article class="era-chronology-card">
            <div class="era-card-number">0{index + 1}</div>
            <div class="era-card-content">
              <div class="era-meta-row">
                <span class="era-period-name">{era.period}</span>
                <span class="era-badge">{era.badge}</span>
              </div>
              <h3 class="era-title">
                <a href={era.href}>{era.name}</a>
              </h3>
              <p class="era-desc">{era.desc}</p>
              <a href={era.href} class="era-link">Davr voqealarini koʻrish →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ======================================================================
         7. FURTHER SCHOLARSHIP (Shajaralar, Metafizika va Tillar)
         ====================================================================== -->
    <section class="section-branches container" aria-labelledby="heading-branches">
      <div class="section-header">
        <span class="editorial-kicker">Ilmiy Tarmoqlar</span>
        <h2 id="heading-branches" class="section-heading">Shajaralar, Metafizika va Elf Tillari</h2>
        <div class="editorial-rule"></div>
      </div>

      <div class="branches-three-col">
        <!-- Branch 1: Genealogies -->
        <div class="branch-col">
          <div class="branch-header">
            <NavIcon icon="tree" size={22} class="branch-icon" />
            <h3 class="branch-title">Sulolaviy Nasabnomalar</h3>
