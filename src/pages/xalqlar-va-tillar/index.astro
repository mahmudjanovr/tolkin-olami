---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/editorial/Breadcrumbs.astro';
import ListLayout, { type FilterGroup } from '@/components/list/ListLayout.astro';
import EntityCard, { type MetaRow } from '@/components/list/EntityCard.astro';

const breadcrumbs = [
  { label: 'Xalqlar va Tillar' },
];

const allPeoples = await getCollection('peoples');
const allLanguages = await getCollection('languages');

allPeoples.sort((a, b) => a.data.name.localeCompare(b.data.name, 'uz'));
allLanguages.sort((a, b) => a.data.name.localeCompare(b.data.name, 'uz'));

const totalPeoples = allPeoples.length;
const totalLanguages = allLanguages.length;

function getTwoSentenceExcerpt(text: string): string {
  if (!text) return '';
  const sentences = text.match(/[^.!?]+[.!?]+/g);
  if (sentences && sentences.length >= 2 && sentences[0] && sentences[1]) {
    return `${sentences[0].trim()} ${sentences[1].trim()}`;
  }
  return text.trim();
}

const raceLabels: Record<string, string> = {
  elflar: 'Elflar',
  insonlar: 'Insonlar',
  'mitti-odamlar': 'Mittilar',
  xobbitlar: 'Xobbitlar',
  ainur: 'Ainur',
  boshqa: 'Boshqa',
};

const peoplesFilterGroups: FilterGroup[] = [
  {
    id: 'irq',
    label: 'Irq va Toifa',
    dataKey: 'irq',
    options: [
      { id: 'all', label: 'Barchasi', count: totalPeoples },
      { id: 'elflar', label: 'Elflar' },
      { id: 'insonlar', label: 'Insonlar' },
      { id: 'mitti-odamlar', label: 'Mittilar' },
      { id: 'xobbitlar', label: 'Xobbitlar' },
      { id: 'ainur', label: 'Ainur' },
    ],
  },
];

function getLangFamilyGroup(family: string, name: string): string {
  const f = (family || '').toLowerCase();
  const n = (name || '').toLowerCase();
  if (n.includes('tengwar') || n.includes('cirth') || f.includes('yozuv')) return 'yozuv';
  if (f.includes('eldarin') || f.includes('elf') || n.includes('quenya') || n.includes('sindarin')) return 'eldarin';
  if (f.includes('mannish') || f.includes('inson') || n.includes('westron') || n.includes('adunaic') || n.includes('rohirric')) return 'insonlar';
  return 'boshqa';
}

const languagesFilterGroups: FilterGroup[] = [
  {
    id: 'oila',
    label: 'Lingvistik oila',
    dataKey: 'oila',
    options: [
      { id: 'all', label: 'Barcha tillar va yozuvlar', count: totalLanguages },
      { id: 'eldarin', label: 'Eldarin (Elflar tillari)' },
      { id: 'insonlar', label: 'Insonlar tillari' },
      { id: 'boshqa', label: 'Khuzdul va Qora nutq' },
      { id: 'yozuv', label: 'Yozuv tizimlari' },
    ],
  },
];
---

<BaseLayout
  title="Xalqlar, Tillar va Yozuv Tizimlari"
  description="Elflar, Insonlar, Mittilar va ularning tillari (Quenya, Sindarin, Khuzdul, Adûnaic) hamda Tengwar va Cirth yozuvlari."
  type="website"
>
  <div class="peoples-langs-page container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="page-header">
      <span class="category-badge">Filologiya va Etnografiya</span>
      <h1 class="page-title" data-pagefind-meta="title">Xalqlar, Tillar va Yozuv Tizimlari</h1>
      <p class="page-lead">
        J.R.R. Tolkien taʼkidlaganidek: <em>«Mening ertaklarim tillarga asoslangan; ular tillar uchun fon vazifasini oʻtaydi, aksincha emas»</em>.
        Ushbu boʻlim Oʻrta-yerning barcha xalqlari va ularning boy lingvistik merosini filologik jihatdan tahlil qiladi.
      </p>
    </header>

    <!-- Ikki oddiy tab: Xalqlar va Tillar -->
    <div class="tabs-nav-bar" role="tablist" aria-label="Xalqlar va tillar boʻlimlari">
      <a
        href="#xalqlar"
        class="main-tab-link is-active"
        id="tab-link-xalqlar"
        role="tab"
        aria-selected="true"
        aria-controls="xalqlar"
      >
        <span class="tab-icon" aria-hidden="true">👥</span>
        <span class="tab-text">Xalqlar va Madaniyatlar</span>
        <span class="tab-counter">({totalPeoples})</span>
      </a>
      <a
        href="#tillar"
        class="main-tab-link"
        id="tab-link-tillar"
        role="tab"
        aria-selected="false"
        aria-controls="tillar"
      >
        <span class="tab-icon" aria-hidden="true">📜</span>
        <span class="tab-text">Tillar va Yozuv Tizimlari</span>
        <span class="tab-counter">({totalLanguages})</span>
      </a>
    </div>

    <!-- 1. XALQLAR BO'LIMI -->
    <section id="xalqlar" class="section-tab-panel is-active" role="tabpanel" aria-labelledby="tab-link-xalqlar">
      <h2 class="visually-hidden">Kanonik Xalqlar va Madaniyatlar</h2>
      <ListLayout
        id="peoples-list"
        searchId="peoples-search-input"
        searchPlaceholder="Xalq nomi, irqi, asosiy maskani..."
        filterGroups={peoplesFilterGroups}
        totalCount={totalPeoples}
        pageSize={24}
        emptyTitle="Mos keluvchi xalq topilmadi"
        emptyHint="Qidiruv soʻzini oʻzgartiring yoki filtrlarni tozalang."
      >
        {
          allPeoples.map((p) => {
              const pId = p.data.id || p.id;
              const metaRows: MetaRow[] = [
                { label: 'Kelib chiqishi', value: p.data.origin_era || '—' },
                { label: 'Asosiy maskanlar', value: p.data.primary_realms?.slice(0, 2).join(', ') || '—' },
              ];

              const searchStr = [
                p.data.name,
                ...(p.data.other_names || []),
                p.data.race_category,
                p.data.summary,
                ...(p.data.primary_realms || []),
                ...(p.data.associated_languages || []),
              ].join(' ').toLowerCase();

              const sourceStr = p.data.divisions_and_clans?.[0]
                ? `Sulolaviy boʻlinish: ${p.data.divisions_and_clans[0]}`
                : 'Kanonik etnografiya';

              return (
                <EntityCard
                  id={pId}
                  name={p.data.name}
                  originalName={p.data.other_names?.[0]}
                  typeChip={raceLabels[p.data.race_category] || p.data.race_category}
                  excerpt={getTwoSentenceExcerpt(p.data.summary)}
                  metaRows={metaRows}
                  source={sourceStr}
                  detailHref={`/xalqlar-va-tillar/${pId}/`}
                  detailLabel="Batafsil"
                  searchCorpus={searchStr}
                  dataAttributes={{
                    'data-irq': p.data.race_category,
                  }}
                />
              );
            })
          }
      </ListLayout>
    </section>

    <!-- 2. TILLAR VA YOZUVLAR BO'LIMI -->
    <section id="tillar" class="section-tab-panel" role="tabpanel" aria-labelledby="tab-link-tillar" hidden>
      <h2 class="visually-hidden">Tillar, Fonologiya va Yozuv Tizimlari</h2>
      <ListLayout
        id="languages-list"
        searchId="languages-search-input"
        searchPlaceholder="Til nomi, oilasi, yozuv tizimi..."
        filterGroups={languagesFilterGroups}
        totalCount={totalLanguages}
        pageSize={24}
        emptyTitle="Mos keluvchi til topilmadi"
        emptyHint="Qidiruv soʻzini oʻzgartiring yoki filtrlarni tozalang."
      >
        {
          allLanguages.map((lang) => {
              const langId = lang.data.id || lang.id;
              const familyKey = getLangFamilyGroup(lang.data.family, lang.data.name);

              const metaRows: MetaRow[] = [
                { label: 'Yozuv tizimlari', value: lang.data.writing_systems?.join(', ') || '—' },
                { label: 'Lingvistik oila', value: lang.data.family || '—' },
              ];

              const searchStr = [
                lang.data.name,
                lang.data.family,
                ...(lang.data.writing_systems || []),
                lang.data.phonology_overview,
                lang.data.sample_text_original || '',
                lang.data.sample_text_uz || '',
              ].join(' ').toLowerCase();

              const sourceStr = lang.data.sources?.[0]?.book_slug
                ? `Manba: ${lang.data.sources[0].book_slug}`
                : 'Kanonik filologiya';

              return (
                <EntityCard
                  id={langId}
                  name={lang.data.name}
                  originalName={lang.data.family}
                  typeChip={lang.data.family}
                  excerpt={getTwoSentenceExcerpt(lang.data.phonology_overview)}
                  metaRows={metaRows}
                  source={sourceStr}
                  detailHref={`/xalqlar-va-tillar/${langId}/`}
                  detailLabel="Batafsil"
                  searchCorpus={searchStr}
                  class="language-entity-card"
                  dataAttributes={{
                    'data-oila': familyKey,
                  }}
                >
                  {lang.data.sample_text_original && (
                    <div class="lang-sample-box" slot="after-title">
                      <p class="sample-orig font-serif" lang="art">
                        <em>«{lang.data.sample_text_original}»</em>
                      </p>
                      {lang.data.sample_text_uz && (
                        <p class="sample-trans font-sans">
                          {lang.data.sample_text_uz}
                        </p>
                      )}
                    </div>
                  )}
                </EntityCard>
              );
            })
          }
      </ListLayout>
    </section>

    <!-- 3. Filologik Standart va Yozuv Tizimlari (Collapsed Details) -->
    <details class="scholarly-details">
      <summary class="scholarly-details-summary">
        <span class="summary-left">
          <span class="summary-icon" aria-hidden="true">📜</span>
          <span class="summary-title">Filologiya Standarti va Yozuv Tizimlari</span>
        </span>
        <span class="summary-badge">{totalPeoples} xalq / {totalLanguages} til</span>
      </summary>

      <div class="scholarly-details-content">
        <div class="scholarly-details-grid">
          <div class="details-card">
            <h3 class="details-heading">Filologiya Standarti</h3>
            <p class="details-text">
              Barcha grammatik va fonetik qoidalar Tolkienning "The Lord of the Rings" E ilovasiga hamda "Parma Eldalamberon" va "Vinyar Tengwar" nashrlariga tayanadi.
            </p>
          </div>

          <div class="details-card">
            <h3 class="details-heading">Yozuv Tizimlari</h3>
            <p class="details-text">
              Tengwar (Fëanor alifbosi) va Cirth (Daeron runalari) barcha tillarda tovushlarni ifodalashning oʻziga xos qoidalariga ega.
              Ular turli davrlar va xalqlar uchun alohida fonetik tartibga keltirilgan.
            </p>
          </div>

          <div class="details-card">
            <h3 class="details-heading">Etnografik Ierarxiya</h3>
            <p class="details-text">
              Xalqlarning boʻlinishi va ularning vujudga kelish xronologiyasi "Silmarillion" hamda "Xalqlar tarixi" (HoME XII) manbalariga asoslanadi.
            </p>
          </div>
        </div>
      </div>
    </details>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabLinks = document.querySelectorAll('.main-tab-link');
    const tabPanels = document.querySelectorAll('.section-tab-panel');

    function switchTab(targetId, updateHash = true) {
      const activeId = targetId.replace('#', '') || 'xalqlar';

      tabLinks.forEach((link) => {
        const href = link.getAttribute('href');
        const isActive = href === `#${activeId}`;
        link.classList.toggle('is-active', isActive);
        link.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      tabPanels.forEach((panel) => {
        const isTarget = panel.id === activeId;
        panel.classList.toggle('is-active', isTarget);
        if (isTarget) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });

      if (updateHash && window.location.hash !== `#${activeId}`) {
        window.history.replaceState(null, '', `#${activeId}`);
      }
    }

    tabLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href') || '#xalqlar';
        switchTab(targetId, true);
      });
    });

    // Check initial hash on page load
    const initialHash = window.location.hash;
    if (initialHash === '#tillar' || initialHash === '#xalqlar') {
      switchTab(initialHash, false);
    }

    window.addEventListener('hashchange', () => {
      if (window.location.hash) {
        switchTab(window.location.hash, false);
      }
    });
  });
</script>

<style>
  .peoples-langs-page {
    padding-block: 2.5rem 4rem;
  }

  .page-header {
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .category-badge {
    display: inline-block;
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.75rem 0;
    color: var(--color-text-primary);
  }

  .page-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 75ch;
  }

  /* Two simple tabs */
  .tabs-nav-bar {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-border-subtle);
    padding-bottom: 0;
  }

  .main-tab-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    font-family: var(--font-sans-ui);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: all var(--transition-fast, 0.15s ease);
    outline: none;
  }

  .main-tab-link:hover {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-border-gold);
  }

  .main-tab-link:focus-visible {
    border-radius: 4px;
    box-shadow: 0 0 0 2px var(--color-accent-gold);
  }

  .main-tab-link.is-active {
    color: var(--color-forest);
    border-bottom-color: var(--color-forest);
    font-weight: 700;
  }

  .tab-icon {
    font-size: 1.125rem;
  }

  .tab-counter {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .section-tab-panel {
    margin-bottom: 3rem;
  }

  .section-tab-panel[hidden] {
    display: none;
  }

  /* Language Sample Phrase Box */
  .lang-sample-box {
    margin: 0.5rem 0 0.875rem 0;
    padding: 0.625rem 0.875rem;
    background-color: var(--color-bg-subtle);
    border-left: 3px solid var(--color-accent-gold);
    border-radius: 0 4px 4px 0;
  }

  .sample-orig {
    font-size: 0.875rem;
    color: var(--color-text-primary);
    line-height: 1.5;
    margin: 0 0 0.25rem 0;
  }

  .sample-trans {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  /* Collapsed Details */
  .scholarly-details {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color var(--transition-fast, 0.2s ease);
  }

  .scholarly-details:hover {
    border-color: var(--color-border-gold);
  }

  .scholarly-details-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    cursor: pointer;
    font-family: var(--font-sans-ui);
    user-select: none;
    background-color: var(--color-bg-subtle);
    list-style: none;
  }

  .scholarly-details-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .summary-icon {
    font-size: 1.125rem;
  }

  .summary-title {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
  }

  .summary-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
  }

  .scholarly-details-content {
    padding: 1.5rem 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .scholarly-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .scholarly-details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .details-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .details-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .details-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
