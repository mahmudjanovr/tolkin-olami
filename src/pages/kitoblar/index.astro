---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/editorial/Breadcrumbs.astro';
import BookshelfOverview from '@/components/books/BookshelfOverview.astro';
import ListLayout, { type FilterGroup } from '@/components/list/ListLayout.astro';
import EntityCard, { type MetaRow } from '@/components/list/EntityCard.astro';

const breadcrumbs = [
  { label: 'Kitoblar va Bibliografiya' },
];

const allBooks = await getCollection('books');

// Sort books chronologically by publication year
allBooks.sort((a, b) => a.data.publication_year - b.data.publication_year);

const totalBooks = allBooks.length;
const primaryLifetimeCount = allBooks.filter((b) => b.data.category === 'primary_lifetime').length;
const posthumousCount = allBooks.filter((b) => b.data.category === 'posthumous_reconstructed').length;
const lettersCount = allBooks.filter((b) => b.data.category === 'letters_academic').length;
const textualCount = allBooks.filter((b) => b.data.category === 'textual_history').length;
const publishedUzbekCount = allBooks.filter((b) =>
  b.data.uzbek_editions?.some((e) => e.status === 'published')
).length;
const inProgressUzbekCount = allBooks.filter((b) =>
  b.data.uzbek_editions?.some((e) => e.status === 'in_progress')
).length;

const categoryTypeMap: Record<string, string> = {
  primary_lifetime: 'Birlamchi asar',
  posthumous_reconstructed: 'Tiklangan asar',
  letters_academic: 'Maktublar',
  textual_history: 'Tadqiqot',
};

function getTwoSentenceExcerpt(text: string): string {
  if (!text) return '';
  const sentences = text.match(/[^.!?]+[.!?]+/g);
  if (sentences && sentences.length >= 2 && sentences[0] && sentences[1]) {
    return `${sentences[0].trim()} ${sentences[1].trim()}`;
  }
  return text.trim();
}

function getEraKey(year: number): string {
  if (year <= 1955) return 'era_early';
  if (year <= 1990) return 'era_mid';
  return 'era_late';
}

const filterGroups: FilterGroup[] = [
  {
    id: 'toifa',
    label: 'Toifa',
    dataKey: 'category',
    options: [
      { id: 'all', label: 'Barchasi', count: totalBooks },
      { id: 'primary_lifetime', label: 'Birlamchi asarlar', count: primaryLifetimeCount },
      { id: 'posthumous_reconstructed', label: 'Tiklangan asarlar', count: posthumousCount },
      { id: 'letters_academic', label: 'Maktublar', count: lettersCount },
      { id: 'textual_history', label: 'Tadqiqotlar', count: textualCount },
    ],
  },
  {
    id: 'nashr',
    label: 'Nashr va davr',
    dataKey: 'nashr',
    options: [
      { id: 'all', label: 'Barchasi' },
      { id: 'uzbek', label: '🇺🇿 Oʻzbekcha nashri bor', count: publishedUzbekCount + inProgressUzbekCount },
      { id: 'era_early', label: '1937–1955 yillar' },
      { id: 'era_mid', label: '1977–1990 yillar' },
      { id: 'era_late', label: '1991+ yillar' },
    ],
  },
];
---

<BaseLayout
  title="Kitoblar va Bibliografiya"
  description="J.R.R. Tolkienning hayotlik nashrlari, vafotidan soʻng Christopher Tolkien tahrir qilgan asarlar va ilmiy toʻplamlar."
  type="article"
>
  <div class="kitoblar-page-container container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="kitoblar-header">
      <span class="kitoblar-category-badge">Tolkien Korpus Bibliografiyasi</span>
      <h1 class="kitoblar-title" data-pagefind-meta="title">Kitoblar va Bibliografiya</h1>
      <p class="kitoblar-lead">
        Tolkien olamining manbashunoslik poydevori yuzlab nashrlar, maktublar va qoralamalar majmuasiga borib taqaladi.
        Ushbu bibliografiya asarlarni ilmiy toifalarga ajratgan holda tizimlashtiradi hamda oʻzbekcha tarjimalar tarixini yoritadi.
      </p>
    </header>

    <!-- 1. Bookshelf Overview (Javon) -->
    <BookshelfOverview books={allBooks} />

    <!-- 2. Katalog: ListLayout va EntityCard Grid -->
    <section class="kitoblar-catalogue" id="kitoblar-katalog" aria-label="Kitoblar katalogi">
      <ListLayout
        id="books-list"
        searchId="book-search-input"
        searchPlaceholder="Kitob nomi, asl nomi, mavzular yoki kalit soʻz..."
        filterGroups={filterGroups}
        totalCount={totalBooks}
        pageSize={24}
        emptyTitle="Mos keluvchi asar topilmadi"
        emptyHint="Kiritilgan soʻrov yoki tanlangan toifa boʻyicha asar topilmadi. Qidiruv soʻzini oʻzgartiring yoki filtrlarni qayta tiklang."
      >
        {
          allBooks.map((b) => {
              const bookId = b.data.id || b.id;
              const hasPublishedUzbek = b.data.uzbek_editions?.some((e) => e.status === 'published');
              const hasInProgressUzbek = b.data.uzbek_editions?.some((e) => e.status === 'in_progress');
              const hasUzbek = hasPublishedUzbek || hasInProgressUzbek;
              const eraTag = getEraKey(b.data.publication_year);

              const badgeText = hasPublishedUzbek
                ? '✓ Oʻzbekcha nashr'
                : hasInProgressUzbek
                ? '⏳ Tarjima jarayonida'
                : undefined;
              const badgeVariant = hasPublishedUzbek ? 'canonical' : 'info';

              const metaRows: MetaRow[] = [
                { label: 'Nashr yili', value: b.data.publication_year },
                { label: 'Nashriyot', value: b.data.publisher },
              ];

              const searchCorpus = [
                b.data.title_uz,
                b.data.title_original,
                ...(b.data.aliases || []),
                b.data.publisher,
                b.data.editor || '',
                b.data.synopsis,
                ...(b.data.key_themes || []),
                ...(b.data.uzbek_editions?.map((e) => `${e.title} ${e.translator || ''} ${e.publisher || ''}`) || []),
              ].join(' ').toLowerCase();

              const sourceStr = b.data.editor
                ? `${b.data.publisher} (muharrir: ${b.data.editor})`
                : `${b.data.publisher}, ${b.data.publication_year}`;

              return (
                <EntityCard
                  id={bookId}
                  name={b.data.title_uz}
                  originalName={b.data.title_original}
                  typeChip={categoryTypeMap[b.data.category] || b.data.category}
                  badge={badgeText}
                  badgeVariant={badgeVariant}
                  excerpt={getTwoSentenceExcerpt(b.data.synopsis)}
                  metaRows={metaRows}
                  source={sourceStr}
                  detailHref={`/kitoblar/${bookId}/`}
                  detailLabel="Batafsil"
                  imageUrl={b.data.cover_image?.src}
                  imageAlt={b.data.cover_image?.alt || b.data.title_uz}
                  layout="horizontal-desktop"
                  searchCorpus={searchCorpus}
                  dataAttributes={{
                    'data-category': b.data.category,
                    'data-nashr': `${hasUzbek ? 'uzbek,' : ''}${eraTag}`,
                    'data-year': String(b.data.publication_year),
                  }}
                />
              );
            })
          }
      </ListLayout>
    </section>

    <!-- 3. Bibliografik Koʻrsatkich va Matnshunoslik Ierarxiyasi (Collapsed details) -->
    <details class="scholarly-details">
      <summary class="scholarly-details-summary">
        <span class="summary-left">
          <span class="summary-icon" aria-hidden="true">📜</span>
          <span class="summary-title">Bibliografik Koʻrsatkich va Matnshunoslik Ierarxiyasi</span>
        </span>
        <span class="summary-badge">{totalBooks} ta kanonik asar</span>
      </summary>

      <div class="scholarly-details-content">
        <div class="scholarly-details-grid">
          <div class="details-card">
            <h3 class="details-heading">Bibliografik Koʻrsatkich</h3>
            <ul class="stats-list">
              <li>Jami kanonik asarlar: <strong>{totalBooks} ta</strong></li>
              <li>Muallif hayotligidagi nashrlar: <strong>{primaryLifetimeCount} ta</strong></li>
              <li>Tiklangan asarlar: <strong>{posthumousCount} ta</strong></li>
              <li>Akademik maktublar: <strong>{lettersCount} ta</strong></li>
              <li>Matn tarixi va tadqiqotlar: <strong>{textualCount} ta</strong></li>
              <li>Oʻzbekcha toʻliq nashr etilgan: <strong>{publishedUzbekCount} ta</strong></li>
              <li>Tarjima jarayonida: <strong>{inProgressUzbekCount} ta</strong></li>
            </ul>
          </div>

          <div class="details-card">
            <h3 class="details-heading">Matnshunoslik Ierarxiyasi</h3>
            <p class="details-text">
              Ensiklopediya faktlarida muallif hayotligidagi nashrlar boshqa barcha manbalardan ustun (primary canon) maqomiga ega.
              Christopher Tolkien tomonidan tiklangan asarlar ikkilamchi manba boʻlib, muallif qoralamalari va maktublar esa kontekstual izoh sifatida qoʻllaniladi.
            </p>
          </div>

          <div class="details-card">
            <h3 class="details-heading">Oksford Standarti</h3>
            <p class="details-text">
              Barcha iqtiboslar kitob nomi, bob nomi va nashr sahifasi koʻrsatilgan qatʼiy akademik formatda beriladi.
              Ixtiyoriy iqtibosning kanonik manbasi bibliografik maʼlumotlar kartasida tekshirilishi mumkin.
            </p>
          </div>
        </div>
      </div>
    </details>
  </div>
</BaseLayout>

<style>
  .kitoblar-page-container {
    padding-block: 2.5rem 4rem;
  }

  .kitoblar-header {
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .kitoblar-category-badge {
    display: inline-block;
    font-family: var(--font-sans-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
    margin-bottom: 0.5rem;
  }

  .kitoblar-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.75rem 0;
    color: var(--color-text-primary);
  }

  .kitoblar-lead {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 75ch;
  }

  .kitoblar-catalogue {
    margin-bottom: 3rem;
  }

  /* Collapsed Details */
  .scholarly-details {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color var(--transition-fast, 0.2s ease);
  }

  .scholarly-details:hover {
    border-color: var(--color-border-gold);
  }

  .scholarly-details-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    cursor: pointer;
    font-family: var(--font-sans-ui);
    user-select: none;
    background-color: var(--color-bg-subtle);
    list-style: none;
  }

  .scholarly-details-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .summary-icon {
    font-size: 1.125rem;
  }

  .summary-title {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
  }

  .summary-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    color: var(--color-accent-gold-text, var(--color-accent-gold));
  }

  .scholarly-details-content {
    padding: 1.5rem 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .scholarly-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .scholarly-details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .details-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .details-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 0.25rem 0;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .details-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .stats-list li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border-subtle);
    padding: 0.25rem 0;
  }

  .stats-list li:last-child {
    border-bottom: none;
  }

  .stats-list strong {
    color: var(--color-text-primary);
  }
</style>
