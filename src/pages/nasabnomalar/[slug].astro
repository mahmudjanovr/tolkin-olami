---
/**
 * TOLKIEN OLAMI — Alohida Sulola Sahifasi (/nasabnomalar/[slug]/)
 *
 * Tanlangan kanonik sulolani toʻliq kenglikdagi Classic Heritage shajara
 * muhitida (3 ustunli interaktiv SVG daraxt, filtrlar, shaxs dosyesi va manbalar) ochadi.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/editorial/Breadcrumbs.astro';
import GenealogyAtlas from '@/components/genealogy/GenealogyAtlas.astro';

export async function getStaticPaths() {
  const genealogies = await getCollection('genealogies');
  return genealogies.map((genealogy) => ({
    params: { slug: genealogy.data.id || genealogy.id },
    props: { genealogy },
  }));
}

interface Props {
  genealogy: CollectionEntry<'genealogies'>;
}

const { genealogy } = Astro.props;
const data = genealogy.data;

const breadcrumbs = [
  { label: 'Nasabnomalar', href: '/nasabnomalar/' },
  { label: data.title },
];
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="dynasty-route-wrapper" data-pagefind-body>
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="dynasty-route-header">
        <span class="dynasty-route-kicker" data-pagefind-meta="category">
          Kanonik Sulola va Nasabnoma
        </span>
        <h1 class="dynasty-route-title" data-pagefind-meta="title">{data.title}</h1>
      </header>

      <GenealogyAtlas initialDynastyId={data.id} />
    </div>
  </div>
</BaseLayout>

<style>
  .dynasty-route-wrapper {
    width: 100%;
    min-height: 100vh;
    padding-block: 1.5rem 3.5rem;
    overflow-x: clip;
  }

  .dynasty-route-header {
    margin-block: 0.75rem 1rem;
  }

  .dynasty-route-kicker {
    display: inline-block;
    font-family: var(--font-sans-ui);
    font-size: 0.78125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold-text);
    margin-bottom: 0.25rem;
  }

  .dynasty-route-title {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    margin: 0;
  }
</style>
