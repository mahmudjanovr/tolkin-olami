---
/**
 * TOLKIEN OLAMI — Sulolalar va Nasabnomalar Sahifasi (/nasabnomalar/)
 *
 * Elflar, Insonlar, Mittilar va Xobbitlarning kanonik sulolalari,
 * interaktiv SVG shajara daraxti, avlodlar va tarmoqlar filtri,
 * shaxs dosyesi hamda manbashunoslik tahlili.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/editorial/Breadcrumbs.astro';
import GenealogyAtlas from '@/components/genealogy/GenealogyAtlas.astro';

const breadcrumbs = [{ label: 'Nasabnomalar' }];
---

<BaseLayout
  title="Sulolalar va Nasabnomalar"
  description="Finwë, Edain, Elros, Rohan, Durin va Shayr xonadonlarining interaktiv shajaralari, avlodlar bogʻliqligi va matnshunoslik manbalari."
>
  <div class="genealogy-page-wrapper">
    <div class="genealogy-page-container container">
      <Breadcrumbs items={breadcrumbs} />

      <header class="genealogy-page-header">
        <span class="genealogy-kicker">Genealogiya va Shajaralar Arxivi</span>
        <h1 class="page-title" data-pagefind-meta="title">Sulolalar va Nasabnomalar</h1>
        <p class="genealogy-intro">
          J.R.R. Tolkien Legendariumidagi olti buyuk sulola shajarasi, nikoh ittifoqlari va
          avlodlar vorisligi. Har bir shaxs tuguni tasdiqlangan birlamchi manba koʻrsatkichi,
          hayot sanalari va matnshunoslik maqomi bilan taʼminlangan.
        </p>
      </header>

      <div class="genealogy-main-content">
        <GenealogyAtlas />
      </div>

      <details class="genealogy-notes-details" id="genealogy-sources-notes">
        <summary class="notes-summary">
          <span class="summary-text">Manbalar haqida izoh va tahririy tamoyillar</span>
          <svg class="summary-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="notes-content">
          <section class="notes-section">
            <h2 class="notes-section-title">Filologik Qatʼiyat</h2>
            <p>
              Barcha qarindoshlik rishtalari, nikohlar va xronologiyalar J.R.R. Tolkienning rasmiy
              matnlariga tayanadi. Ensiklopediya unvonlar yoki sanalarni toʻqib chiqarmaydi;
              manbalarda ochiq qoldirilgan jihatlar <em>«Nomaʼlum»</em> belgisi bilan ifodalanadi.
            </p>
          </section>

          <section class="notes-section">
            <h2 class="notes-section-title">Ziddiyatli Matnlar</h2>
            <p>
              Gil-galadning nasabi kabi masalalarda <em>The Silmarillion</em> (1977) nashri va
              Tolkienning soʻnggi qoralamalari (<em>HoME XII</em>) oʻrtasidagi tafovutlar uzuq-uzuq
              chiziqlar va maxsus matnshunoslik izohlari bilan koʻrsatilgan.
            </p>
          </section>
        </div>
      </details>
    </div>
  </div>
</BaseLayout>

<style>
  .genealogy-page-wrapper {
    width: 100%;
    min-height: 100vh;
    padding-block: 1.5rem 3.5rem;
    overflow-x: clip;
  }

  .genealogy-page-container {
    width: 100%;
  }

  .genealogy-page-header {
    margin-block: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 1.1rem;
  }

  .genealogy-kicker {
    display: inline-block;
    font-family: var(--font-sans-ui);
    font-size: 0.78125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-gold-text);
    margin-bottom: 0.3rem;
  }

  .page-title {
    font-size: clamp(1.875rem, 3.2vw, 2.5rem);
    margin-bottom: 0.45rem;
  }

  .genealogy-intro {
    font-family: var(--font-serif-body);
    font-size: 1.0625rem;
    line-height: 1.62;
    color: var(--color-text-secondary);
    max-width: 76ch;
    margin-bottom: 0;
  }

  .genealogy-main-content {
    width: 100%;
  }

  .genealogy-notes-details {
    margin-top: 1.25rem;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    overflow: hidden;
  }

  .notes-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    font-family: var(--font-sans-ui);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .notes-summary::-webkit-details-marker {
    display: none;
  }

  .notes-summary:hover {
    background-color: var(--color-bg-subtle);
  }

  .summary-text {
    font-family: var(--font-serif-heading);
    font-size: 1.0625rem;
    color: var(--color-text-primary);
  }

  .summary-chevron {
    color: var(--color-text-muted);
    transition: transform 200ms ease;
  }

  .genealogy-notes-details[open] .summary-chevron {
    transform: rotate(180deg);
  }

  .notes-content {
    padding: 1.15rem 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .notes-content {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .notes-section {
    font-family: var(--font-sans-ui);
    font-size: 0.84375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .notes-section-title {
    font-family: var(--font-serif-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-accent-gold-text);
    margin: 0 0 0.35rem 0;
  }

  .notes-section p {
    margin: 0;
  }
</style>
